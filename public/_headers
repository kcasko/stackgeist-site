/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://s.pinimg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ct.pinterest.com https://*.pinimg.com; font-src 'self'; connect-src 'self' https://cloudflareinsights.com https://*.cloudflareinsights.com https://ct.pinterest.com https://*.pinterest.com; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
