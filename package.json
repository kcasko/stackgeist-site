{
  "name": "stackgeist-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "preview": "astro build && wrangler pages dev",
    "astro": "astro",
    "generate-types": "wrangler types",
    "deploy": "astro build && wrangler pages deploy",
    "analytics:report": "node scripts/affiliate-report.mjs",
    "analytics:weekly": "node scripts/kits-weekly-report.mjs",
    "cf-typegen": "wrangler types",
    "editorial:check": "node scripts/editorial-release.mjs --dry-run",
    "editorial:publish": "node scripts/editorial-release.mjs --publish",
    "editorial:validate": "node scripts/editorial-release.mjs --validate-all"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.2.0",
    "wrangler": "^4.123.0"
  }
}
