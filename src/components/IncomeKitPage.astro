---
import NewsletterSignup from './NewsletterSignup.astro';
import type { IncomeKit, KitItem } from '../data/incomeKits';
import { isResearchPending } from '../data/researchPending';
import { isPaidAffiliateUrl } from '../lib/affiliate';

const { kit } = Astro.props as { kit: IncomeKit };
const tierLabel: Record<KitItem['tier'], string> = {
  'must-have': 'get first',
  'nice-next': 'add next',
  'skip-until-needed': 'skip until needed',
};
const isExternal = (href: string) => href.startsWith('http');
const campaign = `kits_${kit.slug}`;
---
<article class="article-page kit-page">
  <p class="breadcrumbs"><a href="/kits/">Buying lists</a> / {kit.title}</p>
  <p class="article-tags"><a class="slab" href="/gear/">Gear</a> <span class="kicker">Buying list</span></p>
  <h1 class="page-title">{kit.title}</h1>
  <p class="page-lead">{kit.promise}</p>

  <div class="article-summary kit-summary">
    <strong>Who this is for</strong>
    <p>{kit.audience}</p>
    <strong>The useful answer</strong>
    <p>{kit.summary}</p>
    {(kit.title.includes('$') || kit.promise.includes('$') || kit.summary.includes('$')) && <p class="budget-note"><strong>Budget note:</strong> Dollar amounts are planning targets, not live-cart guarantees. Retail prices and availability change; verify the current total before buying.</p>}
    {kit.download && (
      <a class="download-link" href={kit.download.href} data-download-lead-magnet>
        <span>{kit.download.title}</span>
        <small>{kit.download.note}</small>
      </a>
    )}
  </div>

  <section class="content-section kit-order">
    <p class="page-kicker">Buying order</p>
    <h2 class="section-heading">Buy in this order so the cheap stuff does not become clutter.</h2>
    <ol class="article-steps">
      {kit.buyingOrder.map((step) => (
        <li><strong>order</strong><span>{step}</span></li>
      ))}
    </ol>
  </section>

  <section class="content-section kit-items">
    <p class="page-kicker">Decision options</p>
    <h2 class="section-heading">Verify the requirement before choosing a product.</h2>
    <div class="kit-quick-tiers">
      <span class="qt-pill qt-must"><strong>Must have:</strong> {kit.items.filter((i) => i.tier === 'must-have').length}</span>
      <span class="qt-pill qt-next"><strong>Add next:</strong> {kit.items.filter((i) => i.tier === 'nice-next').length}</span>
      <span class="qt-pill qt-skip"><strong>Skip for now:</strong> {kit.items.filter((i) => i.tier === 'skip-until-needed').length}</span>
    </div>
    <div class="kit-grid">
      {kit.items.map((item) => (
        <a
          class:list={['kit-item', `tier-${item.tier}`]}
          href={isExternal(item.href) ? `${item.href}&utm_source=stackgeist&utm_medium=internal&utm_campaign=${campaign}&utm_content=${encodeURIComponent(item.label.toLowerCase().replaceAll(' ', '_'))}` : item.href}
          target={isExternal(item.href) ? '_blank' : undefined}
          rel={isPaidAffiliateUrl(item.href) ? 'sponsored nofollow noopener noreferrer' : isExternal(item.href) ? 'noopener noreferrer' : undefined}
          data-affiliate-link={isPaidAffiliateUrl(item.href) ? true : undefined}
          data-affiliate-placement={isPaidAffiliateUrl(item.href) ? `kit-${kit.slug}` : undefined}
        >
          <span class="kit-tier">{tierLabel[item.tier]}</span>
          {isExternal(item.href) && <span class="kit-research">retailer search · not an exact-product endorsement</span>}
          {isResearchPending(item.href) && <span class="kit-research">example model · not yet reviewed</span>}
          <h3>{item.label}</h3>
          <p>{isExternal(item.href) ? 'Use this retailer search as a category starting point. The exact products in the results have not been individually source-checked by StackGeist.' : item.role}</p>
          <strong>Check before buying</strong>
          <small>{item.check}</small>
          <span class="kit-action-btn">{isExternal(item.href) ? 'Check Price on Amazon ↗' : 'View Decision Guide →'}</span>
        </a>
      ))}
    </div>
    <p class="kit-disclosure">Paid Amazon search links are marked and may earn a commission; they are category research paths, not blanket endorsements of the returned products. Internal links lead to StackGeist decision pages with evidence status, fit notes, limitations, and reasons to skip.</p>
  </section>

  {kit.related.length > 0 && <section class="content-section kit-related">
    <p class="page-kicker">related decisions</p>
    <h2 class="section-heading">Check the fit before you spend more.</h2>
    <div class="cards">
      {kit.related.map((item) => (
        <a class="card" href={item.href}><h3>{item.title}</h3><p>{item.desc}</p></a>
      ))}
    </div>
  </section>}

  <section class="content-section kit-faq">
    <p class="page-kicker">FAQ</p>
    <h2 class="section-heading">Questions people ask before buying.</h2>
    <div class="article-cards">
      {kit.faqs.map((faq) => (
        <div><strong>{faq.question}</strong><p>{faq.answer}</p></div>
      ))}
    </div>
  </section>
</article>

<NewsletterSignup variant="inline" />

<style>
  .kit-summary { display:grid; gap:8px; }
  .kit-summary strong + p { margin-bottom:8px; }
  .budget-note { padding:10px 12px; border-left:2px solid var(--amber); color:var(--muted); font-size:.94rem; line-height:1.55; }
  .download-link { display:grid; gap:4px; margin-top:8px; padding:14px; border:1px solid var(--phosphor); color:var(--phosphor); text-decoration:none; background:rgba(163,230,53,.045); }
  .download-link span { font-size:.94rem; font-weight:700; }
  .download-link small { color:var(--muted); font-size:.88rem; line-height:1.5; }
  .kit-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0; border:1px solid var(--term-border); background:var(--term-bg); }
  .kit-item { display:grid; gap:10px; padding:22px; color:inherit; text-decoration:none; border-top:1px solid var(--term-border); position:relative; }
  .kit-item:nth-child(-n+2) { border-top:0; }
  .kit-item:nth-child(even) { border-left:1px solid var(--term-border); }
  .kit-item:hover { background:rgba(163,230,53,.035); }
  .kit-research { color:var(--amber);font-size:.8rem;line-height:1.35; }
  .kit-tier { width:max-content; padding:3px 7px; border:1px solid var(--term-border-strong); color:var(--phosphor); font-size:.8rem; }
  .tier-nice-next .kit-tier { color:var(--purple-light); }
  .tier-skip-until-needed .kit-tier { color:var(--amber); }
  .kit-item h3 { margin:0; padding-right:22px; font-size:18px; line-height:1.35; }
  .kit-item h3::after { content:' ↗'; color:var(--quiet); font-size:.94rem; }
  .kit-item p { margin:0; color:var(--muted); font-size:.88rem; line-height:1.6; }
  .kit-item strong { margin-top:4px; color:var(--text); font-size:.88rem; }
  .kit-item small { color:var(--amber); font-size:.94rem; line-height:1.55; }
  .kit-quick-tiers { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:16px; }
  .qt-pill { font-size:.82rem; padding:4px 10px; border:1px solid var(--term-border); background:var(--term-bg); color:var(--muted); }
  .qt-pill strong { color:var(--text); }
  .qt-must { border-color:rgba(163,230,53,.4); }
  .qt-next { border-color:rgba(192,132,252,.4); }
  .qt-skip { border-color:rgba(251,191,36,.4); }
  .kit-action-btn { display:inline-flex; align-items:center; justify-content:center; width:max-content; margin-top:8px; padding:6px 14px; border:1px solid var(--phosphor); background:rgba(163,230,53,.08); color:var(--phosphor); font-size:.82rem; font-weight:600; letter-spacing:.02em; border-radius:2px; transition:background .15s ease,color .15s ease; }
  .kit-item:hover .kit-action-btn { background:var(--phosphor); color:#000; }
  .kit-disclosure { margin:14px 0 0; color:var(--quiet); font-size:.8rem; line-height:1.55; }
  @media(max-width:760px){
    .kit-grid { grid-template-columns:1fr; }
    .kit-item:nth-child(even){ border-left:0; }
    .kit-item:nth-child(n+2){ border-top:1px solid var(--term-border); }
  }
</style>
