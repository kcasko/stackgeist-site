---
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  extraStructuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, type = 'website', noindex = false, extraStructuredData } = Astro.props;
const extraSchemas: Record<string, unknown>[] = extraStructuredData
  ? (Array.isArray(extraStructuredData) ? extraStructuredData : [extraStructuredData])
  : [];
const googleVerify = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim();
const site = Astro.site ?? new URL('https://stackgeist.dev');
const canonical = new URL(Astro.url.pathname, site).toString();
const image = new URL('/og/stackgeist-card.png', site).toString();
const feed = new URL('/rss.xml', site).toString();
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbStructured = pathSegments.length === 0 ? null : {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'StackGeist',
      item: new URL('/', site).toString(),
    },
    ...pathSegments.map((segment, index) => ({
      '@type': 'ListItem',
      position: index + 2,
      name: segment
        .split('-')
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' '),
      item: new URL(`/${pathSegments.slice(0, index + 1).join('/')}`, site).toString(),
    })),
  ],
};
// Cloudflare Web Analytics beacon token. Public by design — the beacon script
// ships this token in every HTML response. Not a secret.
const cfBeaconToken = (import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? 'ef8afadeb68a45d49c726121c2976329').trim();
const structured = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'StackGeist',
  url: site.toString(),
  description: 'Gaming setups, useful gear, and practical setup guides.',
};
---
<meta name="description" content={description} />
<meta name="theme-color" content="#07050d" />
<meta name="color-scheme" content="dark" />
<meta name="p:domain_verify" content="be7ae82233943c7beaf0af4fa9801ed0" />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
{googleVerify && <meta name="google-site-verification" content={googleVerify} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="StackGeist setup feed" href={feed} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta property="og:site_name" content="StackGeist" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="StackGeist - gaming setups, gear and practical guides" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(structured)}></script>
{breadcrumbStructured && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructured)}></script>}
{extraSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)}></script>)}
{cfBeaconToken && (
  <script type="module" defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${cfBeaconToken}"}`}></script>
)}
