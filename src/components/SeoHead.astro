---
import { buildBreadcrumbs } from '../lib/breadcrumbs';
import { isArchivedRoute } from '../data/searchScope';
import { CATALOG } from '../data/catalog';
import { SECTIONS, TOPIC_LABEL } from '../data/sections';
interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  extraStructuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, type = 'website', noindex = false, extraStructuredData } = Astro.props;
const shouldNoindex = noindex || isArchivedRoute(Astro.url.pathname);
const extraSchemas: Record<string, unknown>[] = extraStructuredData
  ? (Array.isArray(extraStructuredData) ? extraStructuredData : [extraStructuredData])
  : [];
const googleVerify = (import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? '').trim();
const ga4Id = (import.meta.env.PUBLIC_GA4_MEASUREMENT_ID ?? '').trim();
const site = Astro.site ?? new URL('https://stackgeist.dev');
const canonicalPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '') + '/';
const canonical = new URL(canonicalPath, site).toString();
const image = new URL('/og/stackgeist-card.png', site).toString();
const feed = new URL('/rss.xml', site).toString();
// Only real static ancestors are included; URL folders are not automatically pages.
const pageFiles = Object.keys(import.meta.glob('../pages/**/*.astro'));
const knownRoutes = new Set(pageFiles.filter(file => !file.includes('[')).map(file => {
  const route = file.replace('../pages', '').replace(/\/index\.astro$/, '/').replace(/\.astro$/, '/');
  return route;
}));
CATALOG.forEach(entry => knownRoutes.add(entry.href));
const entry = CATALOG.find(entry => entry.href === canonicalPath);
const hasEditorialTrail = entry && ['troubleshooting', 'buying-guide', 'lab', 'lab-hardware', 'certification', 'course-review', 'study-log'].includes(entry.type);
const editorialParents = hasEditorialTrail ? [{ name: SECTIONS[entry.section].label, path: SECTIONS[entry.section].href }] : undefined;
if (editorialParents && entry) {
  const hub = entry.section === 'fixes' ? CATALOG.find(page => page.type === 'topic' && page.topic === entry.topic) : undefined;
  if (hub && hub.href !== entry.href) editorialParents.push({ name: TOPIC_LABEL[entry.topic] ?? hub.title, path: hub.href });
  if (entry.topic === 'wgu' && entry.href !== '/certs/wgu-software-engineering-degree/') editorialParents.push({ name: 'WGU degree', path: '/certs/wgu-software-engineering-degree/' });
}
const breadcrumbs = buildBreadcrumbs(Astro.url.pathname, title, knownRoutes, editorialParents);
const breadcrumbStructured = breadcrumbs.length ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem', position: index + 1, name: crumb.name,
    item: new URL(crumb.path, site).toString(),
  })),
} : null;
// Cloudflare Pages injects Web Analytics at delivery time. Keep a single beacon;
// a second manual snippet used an old token and produced CORS errors on every page.
const structured = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'StackGeist',
  url: site.toString(),
  description: 'Practical troubleshooting for USB-C, docks, charging, storage, and PC hardware, plus IT home labs and certification guides.',
};
---
<meta name="description" content={description} />
<meta name="theme-color" content="#f6f3eb" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#18171a" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<meta name="p:domain_verify" content="be7ae82233943c7beaf0af4fa9801ed0" />
<meta name="msvalidate.01" content="826F214A9078E8999D09FC983C4BAAA1" />
<meta name="impact-site-verification" value="a20b3580-1f47-4ef9-ad3f-9a685551e808" />
<meta name="fo-verify" content="5705b42d-0682-4327-a65e-0e5a18857af1" />
<meta name="robots" content={shouldNoindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
{googleVerify && <meta name="google-site-verification" content={googleVerify} />}
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="StackGeist fixes and labs" href={feed} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta property="og:site_name" content="StackGeist" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="StackGeist - practical tech fixes, IT home labs, and certification guides" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(structured)}></script>
{breadcrumbStructured && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbStructured)}></script>}
{extraSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)}></script>)}
{ga4Id && (
  <Fragment>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    <script define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', ga4Id);
    </script>
  </Fragment>
)}
