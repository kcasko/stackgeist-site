---
// Terminal / operator style ASCII mind-map.
// Real box-drawing characters, not SVG lines pretending to be a diagram.
const branches = [
  {
    key: 'setups',
    label: 'setups',
    cmd: 'ls /setups',
    intent: 'I want inspiration',
    detail: 'Console, PC and mixed-use desks with real room constraints.',
    nodes: [
      { name: 'gaming',        href: '/setups/gaming',                 note: 'console + PC · shared desk' },
      { name: 'small-spaces',  href: '/setups/small-bedroom-gaming',   note: 'bedroom · <5ft desk' },
      { name: 'budget',        href: '/setups/budget-gaming-desk',     note: 'under $500 total' },
      { name: 'midnight-shift',href: '/setups/midnight-shift',         note: 'featured · dark room' },
    ],
  },
  {
    key: 'gear',
    label: 'gear',
    cmd: 'ls /gear',
    intent: 'I need something',
    detail: 'Useful gear organized by the problem it fixes, not by brand hype.',
    nodes: [
      { name: 'lighting',       href: '/gear/desk-lighting',                            note: '3 verified routes' },
      { name: 'power',          href: '/gear/desk-power/anker-525',                     note: 'clamp strips · fit-checked' },
      { name: 'input',          href: '/gear/input/logitech-mx-master-3s',               note: 'mouse + keyboard · body fit' },
      { name: 'connectivity',   href: '/gear/connectivity/caldigit-ts4',                 note: 'hubs + docks · host checked' },
      { name: 'audio-video',    href: '/guides/better-video-calls',                      note: 'camera + mic · weakest link' },
      { name: 'monitor-support',href: '/gear/monitor-support/ergotron-lx',               note: 'weight · VESA · desk clamp' },
      { name: 'desk-surface',   href: '/gear/desk-surface/steelseries-qck-heavy-xxl',   note: 'mats · pads' },
      { name: 'budget-tech',    href: '/gear/budget-tech',                              note: '30 picks · 10 comparisons' },
    ],
  },
  {
    key: 'guides',
    label: 'guides',
    cmd: 'ls /guides',
    intent: 'I need help',
    detail: 'Practical setup help built around decisions you can actually act on.',
    nodes: [
      { name: 'desk-layout',       href: '/guides/desk-layout-basics',       note: 'plan before buying' },
      { name: 'cable-management',  href: '/guides/cable-management',         note: 'route first · organize second' },
      { name: 'dock-compatibility',href: '/guides/usb-c-dock-compatibility', note: 'host · display · power · cables' },
      { name: 'input-fit',         href: '/guides/keyboard-mouse-fit',       note: 'width · reach · handedness' },
      { name: 'better-video-calls',href: '/guides/better-video-calls',       note: 'angle · light · mic distance' },
      { name: 'cheap-upgrades',    href: '/guides/cheap-desk-upgrades',      note: 'fix friction first' },
    ],
  },
];
---

<section class="tree" id="explore" data-mindmap data-active="setups" aria-label="StackGeist site map">
  <header class="tree-head">
    <span class="prompt">stackgeist@local</span>
    <span class="sep">:</span>
    <span class="path">~/</span>
    <span class="sep">$</span>
    <span class="typed" data-typed>tree --by=intent</span>
    <span class="cursor" aria-hidden="true">█</span>
  </header>

  <pre class="tree-body"><code>
<span class="root">stackgeist</span>
<span class="conn" aria-hidden="true">├──</span> <button class="node root-node" data-branch="setups" aria-controls="branch-setups" aria-pressed="true"><span class="brackets" aria-hidden="true">[</span>setups<span class="brackets" aria-hidden="true">]</span> <span class="node-intent">I want inspiration</span></button>
<span class="conn" aria-hidden="true">├──</span> <button class="node root-node" data-branch="gear" aria-controls="branch-gear" aria-pressed="false"><span class="brackets" aria-hidden="true">[</span>gear<span class="brackets" aria-hidden="true">]</span> <span class="node-intent">I need something</span></button>
<span class="conn" aria-hidden="true">└──</span> <button class="node root-node" data-branch="guides" aria-controls="branch-guides" aria-pressed="false"><span class="brackets" aria-hidden="true">[</span>guides<span class="brackets" aria-hidden="true">]</span> <span class="node-intent">I need help</span></button>
  </code></pre>

  {branches.map((b) => (
    <div class="branch" id={`branch-${b.key}`} data-panel={b.key} hidden={b.key !== 'setups'} aria-label={`${b.label} branch contents`}>
      <div class="branch-meta">
        <span class="tag">$ {b.cmd}</span>
        <span class="tag ok">200 OK</span>
        <span class="tag muted">{b.nodes.length} entries</span>
      </div>
      <p class="branch-detail"><span class="hash">#</span> {b.detail}</p>
      <div class="branch-body">{b.nodes.map((n, i) => (
        <div class="leaf-row">
          <span class="conn">{i === b.nodes.length - 1 ? '└──' : '├──'}</span> <a class="leaf" href={n.href} data-route={n.href}><span class="leaf-name">{n.name}</span><span class="leaf-note">// {n.note}</span><span class="leaf-arrow">↗</span></a>
        </div>
      ))}</div>
    </div>
  ))}
</section>

<style>
  .tree {
    position: relative;
    margin-top: 24px;
    padding: 26px 28px 30px;
    border: 1px solid var(--term-border);
    border-radius: 6px;
    background:
      linear-gradient(180deg, rgba(163,230,53,.015) 0, transparent 60%),
      var(--term-bg);
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.55;
    box-shadow: 0 0 0 1px rgba(163,230,53,.04) inset;
  }
  /* subtle CRT scanlines, only inside the terminal panel */
  .tree::before {
    content: "";
    position: absolute; inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgba(255,255,255,.014) 2px 3px
    );
    mix-blend-mode: overlay;
    opacity: .55;
  }

  .tree-head {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    padding-bottom: 18px; margin-bottom: 14px;
    border-bottom: 1px dashed var(--term-border);
    font-size: 12.5px;
  }
  .prompt { color: var(--phosphor); }
  .path   { color: var(--purple-light); }
  .sep    { color: var(--muted); }
  .typed  { color: var(--text); }
  .cursor {
    display: inline-block; width: .55em; height: 1.05em;
    margin-left: 2px; transform: translateY(2px);
    background: var(--phosphor);
    animation: blink 1.05s steps(2) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .tree-body {
    margin: 0 0 22px;
    color: var(--muted);
    white-space: pre;
    overflow-x: auto;
  }
  .tree-body code { font: inherit; color: inherit; }
  .root { color: var(--phosphor); font-weight: 700; letter-spacing: .02em; }
  .conn { color: var(--term-border-strong); }

  .node {
    display: inline-flex; align-items: baseline; gap: 8px;
    padding: 2px 8px; margin-left: 4px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text);
    font: inherit;
    cursor: pointer;
    border-radius: 3px;
    transition: background 120ms linear, border-color 120ms linear, color 120ms linear;
  }
  .brackets { color: var(--purple-light); }
  .node-intent { color: var(--quiet); font-size: 12.5px; }
  .node:hover { background: rgba(163,230,53,.06); border-color: var(--term-border-strong); }
  .node[aria-pressed="true"] {
    background: rgba(163,230,53,.08);
    border-color: var(--phosphor);
    color: var(--phosphor);
  }
  .node[aria-pressed="true"] .brackets { color: var(--phosphor); }
  .node[aria-pressed="true"] .node-intent { color: var(--phosphor-dim); }

  /* Branch panels */
  .branch { padding-top: 6px; }
  .branch[hidden] { display: none; }
  .branch-meta {
    display: flex; flex-wrap: wrap; gap: 8px;
    margin: 0 0 10px;
    font-size: 11.5px; letter-spacing: .02em;
  }
  .tag {
    padding: 2px 8px;
    border: 1px solid var(--term-border);
    color: var(--muted);
    border-radius: 2px;
  }
  .tag.ok    { color: var(--phosphor); border-color: rgba(163,230,53,.35); }
  .tag.muted { color: var(--quiet); }
  .branch-detail { margin: 0 0 14px; color: var(--muted); font-size: 13px; }
  .hash { color: var(--purple-light); margin-right: 2px; }
  .branch-body { margin: 0; padding: 0; overflow-x: auto; }
  .branch-body code { font: inherit; color: inherit; }
  .leaf-row { display: block; line-height: 1.55; }
  .leaf {
    display: inline-flex; align-items: baseline; gap: 10px;
    padding: 3px 10px; margin-left: 4px;
    border: 1px solid transparent;
    border-radius: 3px;
    color: var(--text);
    cursor: pointer;
    transition: background 120ms linear, border-color 120ms linear, color 120ms linear;
  }
  .leaf-name { font-weight: 600; color: var(--text); }
  .leaf-note { color: var(--quiet); font-size: 12.5px; }
  .leaf-arrow { margin-left: 4px; color: var(--purple-light); opacity: .0; transition: opacity 120ms linear, transform 120ms linear; }
  .leaf:hover { background: rgba(192,132,252,.07); border-color: var(--purple); color: var(--purple-light); }
  .leaf:hover .leaf-name { color: var(--purple-light); }
  .leaf:hover .leaf-arrow { opacity: 1; transform: translateX(2px); }

  @media (max-width: 760px) {
    .tree { padding: 20px 16px 22px; font-size: 12.5px; }
    .node { min-height: 44px; flex-wrap: wrap; column-gap: 5px; }
    .node-intent { display:block; flex-basis:100%; margin-left:12px; color:var(--quiet); font-size:11px; }
    .leaf { min-height:44px; flex-wrap:wrap; }
    .leaf-note { display:block; flex-basis:100%; margin-left:0; font-size:11px; }
  }
</style>

<script>
  const map = document.querySelector('[data-mindmap]');

  function setBranch(key) {
    if (!map) return;
    map.setAttribute('data-active', key);
    map.querySelectorAll('[data-branch]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.getAttribute('data-branch') === key));
    });
    map.querySelectorAll('[data-panel]').forEach((panel) => {
      panel.toggleAttribute('hidden', panel.getAttribute('data-panel') !== key);
    });
  }

  const initial = new URLSearchParams(window.location.search).get('branch');
  if (initial && ['setups','gear','guides'].includes(initial)) setBranch(initial);

  map?.querySelectorAll('[data-branch]').forEach((btn) => {
    btn.addEventListener('click', () => setBranch(btn.getAttribute('data-branch')));
  });

  // header-driven jump (kept compatible with old data-nav-branch links)
  document.querySelectorAll('[data-nav-branch]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const key = btn.getAttribute('data-nav-branch');
      setBranch(key);
      document.querySelector('#explore')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
