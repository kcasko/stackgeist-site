---
interface Props { variant?: 'desk' | 'screenbar' | 'bias'; compact?: boolean; }
const { variant = 'desk', compact = false } = Astro.props;
---
<div class:list={['setup-scene', variant, { compact }]} role="img" aria-label="Stylized dark desk setup illustration">
  <div class="scene-glow"></div>
  <div class="scene-desk"></div>
  <div class="scene-shadow"></div>
  <div class="scene-monitor"></div>
  <div class="scene-stand"></div>
  <div class="scene-base"></div>
  <div class="scene-speaker"><i></i><i></i></div>
  <div class="scene-tower"></div>
  <div class="scene-light"></div>
  <div class="scene-keyboard"></div>
  <div class="scene-bias"></div>
</div>
<style>
  .setup-scene { position: relative; min-height: 320px; overflow: hidden; border: 1px solid var(--border); border-radius: 16px; background: linear-gradient(180deg,#0b0812,#20102e); }
  .scene-glow { position:absolute; width:48%; aspect-ratio:1; right:11%; top:3%; border-radius:50%; background:radial-gradient(circle,rgba(168,85,247,.3),transparent 68%); filter:blur(12px); }
  .scene-desk { position:absolute; left:12%; right:12%; bottom:20%; height:14px; border-radius:7px; background:#21182a; }
  .scene-shadow { position:absolute; left:18%; right:18%; bottom:16%; height:10px; border-radius:4px; background:#110d18; }
  .scene-monitor { position:absolute; left:34%; top:22%; width:33%; height:38%; border:2px solid #5c347f; border-radius:10px; background:linear-gradient(180deg,#12101b,#3a1452); box-shadow:0 0 24px rgba(168,85,247,.17); }
  .scene-stand { position:absolute; left:49%; top:60%; width:5%; height:10%; border-radius:4px; background:#16101e; }
  .scene-base { position:absolute; left:43%; top:69%; width:17%; height:8px; border-radius:4px; background:#21182a; }
  .scene-speaker { position:absolute; left:22%; top:48%; width:7%; height:20%; border:1px solid #3b2a4c; border-radius:8px; background:#0c0911; }
  .scene-speaker i { display:block; width:18px; height:18px; margin:10px auto 0; border-radius:50%; background:#2a123e; }
  .scene-tower { position:absolute; right:18%; top:35%; width:6%; height:31%; border:1px solid #b9a5d0; border-radius:10px; background:#ece8f2; }
  .scene-light { position:absolute; right:20%; top:39%; width:2px; height:24%; background:var(--purple); box-shadow:0 0 12px var(--purple); }
  .scene-keyboard { position:absolute; left:42%; width:22%; bottom:23%; height:10px; border:1px solid var(--border-strong); border-radius:5px; background:#2a2033; }
  .scene-bias { display:none; }
  .screenbar .scene-light { right:31%; top:32%; height:35%; width:5px; border-radius:4px; background:#f5f1ff; box-shadow:0 0 18px rgba(168,85,247,.7); }
  .screenbar .scene-tower { display:none; }
  .bias .scene-light, .bias .scene-tower { display:none; }
  .bias .scene-bias { display:block; position:absolute; left:36%; top:61%; width:29%; height:5px; border-radius:3px; background:rgba(168,85,247,.8); box-shadow:0 0 18px rgba(168,85,247,.65); }
  .compact { min-height:180px; }
  @media (max-width:760px){ .setup-scene { min-height:220px; } .compact { min-height:140px; } }
</style>
<style>
  .setup-scene { border-color:var(--term-border); border-radius:0; background:#050508; }
  .setup-scene::before { content:'┌─ setup.render ─────────────────────────────┐'; position:absolute; top:10px; left:14px; z-index:3; color:var(--phosphor); font-size:10px; }
  .scene-monitor { border-radius:0; border-color:var(--phosphor-dim); background:#090d07; box-shadow:0 0 18px rgba(163,230,53,.12); }
  .scene-glow { opacity:.22; }
  .scene-desk,.scene-base,.scene-keyboard { border-radius:0; }
</style>
