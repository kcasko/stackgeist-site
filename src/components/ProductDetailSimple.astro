---
interface Props{eyebrow:string;heading:string;intro:string;productName:string;productMeta:string;tags:string[];why:string;tradeoff:string;check:string;facts:string;skip:string;amazonUrl:string;makerLabel?:string;makerUrl?:string;backHref:string;backLabel:string;imageUrl?:string;imageAlt?:string;imageSourceLabel?:string;imageSourceUrl?:string;imageExample?:string;imageCredit?:string;imageLicense?:string;imageLicenseUrl?:string;imageCaption?:string;ownedSince?:string}
const p=Astro.props;
const isResearchStartingPoint = /not been individually re-verified|taurustech\.me\/affiliate/i.test(p.check + ' ' + p.facts);
// Research-pending pages never show an endorsement label, whatever the page props say.
// Owned pages say so (from the purchase record); the research caveat below still applies to their specs.
const eyebrow = p.ownedSince ? `Owned since ${p.ownedSince}` : isResearchStartingPoint ? 'Research pending' : p.eyebrow;
const skipRaw = p.skip.replace(/^skip (it |this )?(if|when)\s+/i, '');
const skipText = skipRaw.charAt(0).toUpperCase() + skipRaw.slice(1);
const tags = isResearchStartingPoint ? [...p.tags.filter((t) => !/worth paying|must|best|top pick/i.test(t) && t !== 'Research pending'), p.ownedSince ? 'Owned' : 'Research pending'] : p.tags;
---
<p class="breadcrumbs"><a href={p.backHref}>{p.backLabel}</a> / {p.productName}</p><p class="article-tags"><a class="slab" href="/gear/">Gear</a> <span class="kicker">{eyebrow}</span></p><h1 class="page-title">{p.heading}</h1><p class="page-lead">{p.intro}</p>{isResearchStartingPoint && (p.ownedSince ? <aside class="research-status"><strong>Owned, notes in progress — not a review or recommendation yet.</strong><span>Keith bought this in {p.ownedSince}. Firsthand notes haven’t been written yet, and the specifications and compatibility claims on this page haven’t been checked against manufacturer documentation. Use the current retailer or manufacturer documentation before buying.</span></aside> : <aside class="research-status"><strong>Research starting point — not a purchase recommendation.</strong><span>StackGeist has matched the listing identity, but the technical specifications and compatibility claims on this page have not yet been checked against authoritative manufacturer documentation. Use the current retailer or manufacturer documentation before buying.</span></aside>)}
<section class="product-detail">{p.imageUrl&&<figure class="product-photo"><img src={p.imageUrl} alt={p.imageAlt||p.productName} loading="eager" decoding="async" referrerpolicy="no-referrer"/>{p.imageCaption ? <figcaption>{p.imageCaption}</figcaption> : p.imageExample ? <figcaption>{p.imageExample} · <a href={p.imageSourceUrl} target="_blank" rel="noopener">{p.imageCredit}</a>, <a href={p.imageLicenseUrl} target="_blank" rel="noopener license">{p.imageLicense}</a>, Wikimedia Commons</figcaption> : p.imageSourceUrl&&<figcaption>Product image: <a href={p.imageSourceUrl} target="_blank" rel="noopener">{p.imageSourceLabel||'manufacturer'}</a></figcaption>}</figure>}<div class="product-heading"><h2>{p.productName}</h2><p>{p.productMeta}</p><div class="product-tags">{tags.map((tag,index)=><span class:list={['tag',{active:index===0}]}>{tag}</span>)}</div>{!isResearchStartingPoint && <div class="buy-panel"><p class="buy-skip"><strong>Skip it if:</strong> {skipText}</p><div class="buy-actions"><a class="btn primary" href={p.amazonUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" data-affiliate-link data-affiliate-placement="product-verdict">Check {p.productName} price on Amazon →</a>{p.makerUrl&&p.makerLabel&&<a class="btn" href={p.makerUrl} target="_blank" rel="noopener">{p.makerLabel}</a>}</div><p class="buy-disclosure">Paid link: StackGeist may earn a commission at no extra cost to you. As an Amazon Associate I earn from qualifying purchases. <a href="/affiliate-disclosure/">Disclosure</a></p></div>}</div>{isResearchStartingPoint ? <div class="decision-grid research-grid"><div><strong>Editorial status</strong><p>{p.ownedSince ? `Owned since ${p.ownedSince}. Until firsthand notes are added, this page records ownership and the listing identity; its imported product details are not presented as checked facts or as a performance review.` : 'This page remains in the catalog for research continuity, but its imported product claims are intentionally not presented as documented facts or firsthand experience.'}</p></div><div><strong>Before relying on it</strong><p>{p.check}</p></div></div> : <div class="decision-grid"><div><strong>Why it fits</strong><p>{p.why}</p></div><div><strong>Tradeoff</strong><p>{p.tradeoff}</p></div><div><strong>Check before buying</strong><p>{p.check}</p></div><div><strong>Documented facts</strong><p>{p.facts}</p></div></div>}</section>
<nav class="related-links" aria-label="Keep going"><strong>Before you buy</strong><a href="/guides/">Check whether a fix solves it first →</a><a href="/kits/">See what to buy together →</a><a href="/gear/">Browse all gear decision pages →</a></nav>
<style>
.buy-panel{margin-top:20px;padding-top:18px;border-top:1px solid var(--term-border)}
.buy-skip{margin:0 0 14px;color:var(--read,var(--muted));font-size:.9375rem;line-height:1.55}
.buy-skip strong{color:var(--signal-red);font-family:var(--font-sans);font-size:.75rem;letter-spacing:.04em;text-transform:uppercase;margin-right:4px}
.buy-actions{display:flex;flex-wrap:wrap;gap:9px}
.buy-actions .btn{min-height:44px;display:inline-flex;align-items:center}
.buy-disclosure{margin:10px 0 0;color:var(--quiet);font-size:.8125rem;line-height:1.5}
.buy-disclosure a{color:var(--phosphor);text-decoration:underline;text-underline-offset:3px}
@media(max-width:760px){.buy-actions .btn{width:100%;justify-content:center}}

.product-detail{max-width:1040px;margin-top:32px;padding:0;border:1px solid var(--term-border);border-radius:0;background:var(--term-bg)}.product-detail::before{content:none;display:block;padding:10px 14px;border-bottom:1px dashed var(--term-border);color:var(--phosphor);font-size:.8rem}.product-photo{margin:0;border:0;border-bottom:1px solid var(--term-border);border-radius:0;overflow:hidden;background:#fff}.product-photo img{display:block;width:100%;height:clamp(260px,48vw,560px);object-fit:contain;filter:saturate(.8)}.product-photo figcaption{padding:9px 14px;border-top:1px solid var(--term-border);color:var(--quiet);font-size:.8rem;background:var(--term-bg)}.product-photo figcaption a{color:var(--purple-light)}.product-heading{padding:24px}.product-heading h2{margin:0 0 7px;font-size:clamp(24px,3vw,32px);letter-spacing:-.025em}.product-heading h2::before{content:none;color:var(--purple-light)}.product-heading>p{margin:0;color:var(--muted);font-size:.88rem}.product-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.primary-offer{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:20px}.primary-offer small{color:var(--quiet);font-size:.8rem;line-height:1.5}.decision-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--term-border);border-bottom:1px solid var(--term-border)}.decision-grid>div{padding:20px 24px;border-top:1px solid var(--term-border)}.decision-grid>div:nth-child(-n+2){border-top:0}.decision-grid>div:nth-child(even){border-left:1px solid var(--term-border)}.decision-grid strong,.skip-block strong{font-size:.88rem;color:var(--phosphor)}.decision-grid strong::before{content:none;margin-right:6px;color:var(--quiet)}.decision-grid p,.skip-block p{margin:8px 0 0;color:var(--muted);font-size:.88rem;line-height:1.65}.skip-block{padding:20px 24px;border-bottom:1px solid var(--term-border);background:rgba(248,113,113,.025)}.skip-block strong{color:var(--signal-red)}.skip-block strong::before{content:none}.retailer-actions{padding:20px 24px;display:flex;flex-wrap:wrap;gap:9px;align-items:center}.retailer-actions span{width:100%;color:var(--quiet);font-size:.8rem}@media(max-width:760px){.product-heading,.skip-block,.retailer-actions{padding:18px}.decision-grid{grid-template-columns:1fr}.decision-grid>div,.decision-grid>div:nth-child(even),.decision-grid>div:nth-child(-n+2){padding:17px 18px;border-left:0;border-top:1px solid var(--term-border)}.decision-grid>div:first-child{border-top:0}.primary-offer .btn{width:100%}}
.related-links{max-width:1040px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:24px 0 0;padding:18px;border:1px solid var(--term-border);background:var(--term-bg);font-family:var(--font-sans);font-size:.88rem}.related-links strong{grid-column:1/-1;color:var(--phosphor);margin-bottom:4px}.related-links a{padding:10px;border:1px solid var(--term-border);color:var(--purple-light)}.related-links a:hover{border-color:var(--phosphor);color:var(--phosphor)}@media(max-width:620px){.related-links{grid-template-columns:1fr}}
.research-status{max-width:1040px;display:grid;gap:6px;margin:18px 0 4px;padding:14px 16px;border:1px solid var(--term-border);background:var(--term-bg);font-size:.88rem;line-height:1.55}.research-status strong{color:var(--signal-red)}.research-status span{color:var(--muted)}
.quick-buy{max-width:1040px;display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin:18px 0 4px;padding:14px 16px;border:1px solid var(--term-border);background:var(--term-bg);font-family:var(--font-sans)}.quick-buy::before{content:none;display:block;width:100%;color:var(--phosphor);font-size:.8rem;margin-bottom:2px}.quick-buy-name{flex:1 1 260px;color:var(--muted);font-size:.88rem;line-height:1.4}.quick-buy-cta{white-space:nowrap}.quick-buy small{flex:1 1 100%;color:var(--quiet);font-size:.8rem;line-height:1.5}
</style>
