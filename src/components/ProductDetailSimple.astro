---
interface Props{eyebrow:string;heading:string;intro:string;productName:string;productMeta:string;tags:string[];why:string;tradeoff:string;check:string;facts:string;skip:string;amazonUrl:string;makerLabel:string;makerUrl:string;backHref:string;backLabel:string;imageUrl?:string;imageAlt?:string;imageSourceLabel?:string;imageSourceUrl?:string}
const p=Astro.props;
---
<p class="breadcrumbs"><a href={p.backHref}>{p.backLabel}</a> / {p.productName}</p><p class="page-kicker">{p.eyebrow}</p><h1 class="page-title">{p.heading}</h1><p class="page-lead">{p.intro}</p>
<section class="product-detail">{p.imageUrl&&<figure class="product-photo"><img src={p.imageUrl} alt={p.imageAlt||p.productName} loading="eager" decoding="async" referrerpolicy="no-referrer"/>{p.imageSourceUrl&&<figcaption>Product image: <a href={p.imageSourceUrl} target="_blank" rel="noopener">{p.imageSourceLabel||'manufacturer'}</a></figcaption>}</figure>}<div class="product-heading"><h2>{p.productName}</h2><p>{p.productMeta}</p><div class="product-tags">{p.tags.map((tag,index)=><span class:list={['tag',{active:index===0}]}>{tag}</span>)}</div><div class="primary-offer"><a class="btn primary" href={p.amazonUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" data-affiliate-link data-affiliate-placement="product-intro">Check current price on Amazon <span aria-hidden="true">→</span></a><small>Paid link · As an Amazon Associate I earn from qualifying purchases.</small></div></div><div class="decision-grid"><div><strong>Why it fits</strong><p>{p.why}</p></div><div><strong>Tradeoff</strong><p>{p.tradeoff}</p></div><div><strong>Check before buying</strong><p>{p.check}</p></div><div><strong>Verified facts</strong><p>{p.facts}</p></div></div><div class="skip-block"><strong>Skip it when</strong><p>{p.skip}</p></div><div class="retailer-actions"><a class="btn primary" href={p.amazonUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" data-affiliate-link data-affiliate-placement="product-verdict">Check Amazon price →</a><a class="btn" href={p.makerUrl} target="_blank" rel="noopener">{p.makerLabel}</a><span>Paid link. As an Amazon Associate I earn from qualifying purchases.</span></div></section>
<nav class="related-links" aria-label="Continue your setup research"><strong>$ continue --fit-first</strong><a href="/guides/desk-layout-basics">Plan the desk before buying →</a><a href="/guides/cheap-desk-upgrades">Fix the highest-friction problem first →</a><a href="/gear/budget-tech/compare">Compare practical alternatives →</a><a href="/gear">Browse all verified gear →</a></nav>
<style>
.product-detail{max-width:1040px;margin-top:32px;padding:0;border:1px solid var(--term-border);border-radius:0;background:var(--term-bg)}.product-detail::before{content:'$ inspect --product --fit-first';display:block;padding:10px 14px;border-bottom:1px dashed var(--term-border);color:var(--phosphor);font-size:11px}.product-photo{margin:0;border:0;border-bottom:1px solid var(--term-border);border-radius:0;overflow:hidden;background:#fff}.product-photo img{display:block;width:100%;height:clamp(260px,48vw,560px);object-fit:contain;filter:saturate(.8)}.product-photo figcaption{padding:9px 14px;border-top:1px solid var(--term-border);color:var(--quiet);font-size:10px;background:var(--term-bg)}.product-photo figcaption a{color:var(--purple-light)}.product-heading{padding:24px}.product-heading h2{margin:0 0 7px;font-size:clamp(24px,3vw,32px);letter-spacing:-.025em}.product-heading h2::before{content:'# ';color:var(--purple-light)}.product-heading>p{margin:0;color:var(--muted);font-size:12.5px}.product-tags{display:flex;flex-wrap:wrap;gap:7px;margin-top:18px}.primary-offer{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:20px}.primary-offer small{color:var(--quiet);font-size:10.5px;line-height:1.5}.decision-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--term-border);border-bottom:1px solid var(--term-border)}.decision-grid>div{padding:20px 24px;border-top:1px solid var(--term-border)}.decision-grid>div:nth-child(-n+2){border-top:0}.decision-grid>div:nth-child(even){border-left:1px solid var(--term-border)}.decision-grid strong,.skip-block strong{font-size:12px;color:var(--phosphor)}.decision-grid strong::before{content:'--';margin-right:6px;color:var(--quiet)}.decision-grid p,.skip-block p{margin:8px 0 0;color:var(--muted);font-size:12.5px;line-height:1.65}.skip-block{padding:20px 24px;border-bottom:1px solid var(--term-border);background:rgba(248,113,113,.025)}.skip-block strong{color:var(--signal-red)}.skip-block strong::before{content:'BLOCK '}.retailer-actions{padding:20px 24px;display:flex;flex-wrap:wrap;gap:9px;align-items:center}.retailer-actions span{width:100%;color:var(--quiet);font-size:10.5px}@media(max-width:760px){.product-heading,.skip-block,.retailer-actions{padding:18px}.decision-grid{grid-template-columns:1fr}.decision-grid>div,.decision-grid>div:nth-child(even),.decision-grid>div:nth-child(-n+2){padding:17px 18px;border-left:0;border-top:1px solid var(--term-border)}.decision-grid>div:first-child{border-top:0}.primary-offer .btn{width:100%}}
.related-links{max-width:1040px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:24px 0 0;padding:18px;border:1px solid var(--term-border);background:var(--term-bg);font-family:var(--font-mono);font-size:12px}.related-links strong{grid-column:1/-1;color:var(--phosphor);margin-bottom:4px}.related-links a{padding:10px;border:1px solid var(--term-border);color:var(--purple-light)}.related-links a:hover{border-color:var(--phosphor);color:var(--phosphor)}@media(max-width:620px){.related-links{grid-template-columns:1fr}}
</style>
