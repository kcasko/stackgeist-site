---
interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  productName: string;
  productMeta: string;
  tags: string[];
  why: string;
  tradeoff: string;
  check: string;
  facts: string;
  skip: string;
  amazonUrl: string;
  makerLabel: string;
  makerUrl: string;
  backHref: string;
  backLabel: string;
  imageUrl?: string;
  imageAlt?: string;
  imageSourceLabel?: string;
  imageSourceUrl?: string;
}
const p = Astro.props;
---
<p class="breadcrumbs"><a href={p.backHref}>{p.backLabel}</a> / {p.productName}</p>
<p class="page-kicker">{p.eyebrow}</p>
<h1 class="page-title">{p.heading}</h1>
<p class="page-lead">{p.intro}</p>

<section class="product-detail">
  {p.imageUrl && (
    <figure class="product-photo">
      <img src={p.imageUrl} alt={p.imageAlt || p.productName} loading="eager" decoding="async" referrerpolicy="no-referrer" />
      {p.imageSourceUrl && <figcaption>Product image: <a href={p.imageSourceUrl} target="_blank" rel="noopener">{p.imageSourceLabel || 'manufacturer'}</a></figcaption>}
    </figure>
  )}
  <div class="product-heading">
    <h2>{p.productName}</h2>
    <p>{p.productMeta}</p>
    <div class="product-tags">{p.tags.map((tag,index) => <span class:list={['tag',{active:index===0}]}>{tag}</span>)}</div>
  </div>
  <div class="decision-grid">
    <div><strong>Why it fits</strong><p>{p.why}</p></div>
    <div><strong>Tradeoff</strong><p>{p.tradeoff}</p></div>
    <div><strong>Check before buying</strong><p>{p.check}</p></div>
    <div><strong>Verified facts</strong><p>{p.facts}</p></div>
  </div>
  <div class="skip-block"><strong>Skip it when</strong><p>{p.skip}</p></div>
  <div class="retailer-actions">
    <a class="btn primary" href={p.amazonUrl} target="_blank" rel="sponsored nofollow noopener noreferrer">Check Amazon price →</a>
    <a class="btn" href={p.makerUrl} target="_blank" rel="noopener">{p.makerLabel}</a>
    <span>Paid link. As an Amazon Associate I earn from qualifying purchases.</span>
  </div>
</section>
<style>
  .product-detail { max-width:1040px; margin-top:34px; padding:30px; border:1px solid var(--border); border-radius:18px; background:var(--surface); }
  .product-photo { margin:0 0 28px; border:1px solid var(--border); border-radius:14px; overflow:hidden; background:#fff; }
  .product-photo img { display:block; width:100%; height:clamp(260px,48vw,560px); object-fit:contain; }
  .product-photo figcaption { padding:10px 14px; border-top:1px solid var(--border); color:var(--quiet); font-size:10px; background:var(--surface-2); }
  .product-photo figcaption a { color:inherit; }
  .product-heading h2 { margin:0 0 6px; font-size:34px; letter-spacing:-.035em; }
  .product-heading > p { margin:0; color:var(--muted); font-size:13px; }
  .product-tags { display:flex; flex-wrap:wrap; gap:8px; margin-top:20px; }
  .decision-grid { display:grid; grid-template-columns:1fr 1fr; gap:0; margin-top:26px; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .decision-grid > div { padding:22px 26px 22px 0; }
  .decision-grid > div:nth-child(even) { padding-left:26px; border-left:1px solid var(--border); }
  .decision-grid strong, .skip-block strong { font-size:13px; }
  .decision-grid p, .skip-block p { margin:8px 0 0; color:var(--muted); font-size:13px; line-height:1.6; }
  .skip-block { padding-top:22px; }
  .skip-block strong { color:var(--purple-light); }
  .retailer-actions { margin-top:24px; display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
  .retailer-actions span { width:100%; color:var(--quiet); font-size:10px; line-height:1.5; }
  @media(max-width:760px){
    .product-detail { padding:18px; }
    .product-heading h2 { font-size:28px; }
    .decision-grid { grid-template-columns:1fr; }
    .decision-grid > div, .decision-grid > div:nth-child(even) { padding:18px 0; border-left:0; border-top:1px solid var(--border); }
    .decision-grid > div:first-child { border-top:0; }
  }
</style>