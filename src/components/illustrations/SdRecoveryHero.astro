---
// Original StackGeist editorial illustration for the SD card photo recovery guide.
// Colors come from CSS variables so it adapts to the active theme.
---
<figure class="hero-illus">
  <svg viewBox="0 0 960 380" role="img" aria-labelledby="sdh-title sdh-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="sdh-title">Recovering deleted photos from an SD card</title>
    <desc id="sdh-desc">An SD card on the left, with photo tiles flowing out of it toward a laptop on the right. Most tiles arrive intact with check marks; one arrives greyed out, showing part of a photo was already overwritten.</desc>
    <rect class="h-bg" x="0" y="0" width="960" height="380" rx="14"/>
    <g class="h-grid">
      <path d="M0 76 H960 M0 152 H960 M0 228 H960 M0 304 H960 M120 0 V380 M240 0 V380 M360 0 V380 M480 0 V380 M600 0 V380 M720 0 V380 M840 0 V380"/>
    </g>
    <g transform="translate(90 70)">
      <path class="h-card" d="M0 30 L30 0 H170 Q180 0 180 10 V230 Q180 240 170 240 H10 Q0 240 0 230 Z"/>
      <g class="h-pins"><rect x="42" y="16" width="14" height="34" rx="3"/><rect x="66" y="16" width="14" height="34" rx="3"/><rect x="90" y="16" width="14" height="34" rx="3"/><rect x="114" y="16" width="14" height="34" rx="3"/><rect x="138" y="16" width="14" height="34" rx="3"/></g>
      <rect class="h-label" x="22" y="96" width="136" height="104" rx="8"/>
      <text class="h-cardtext" x="90" y="144" text-anchor="middle">SD</text>
      <text class="h-cardsub" x="90" y="172" text-anchor="middle">64 GB</text>
    </g>
    <path class="h-flow" d="M285 190 C380 120 470 120 560 170"/>
    <path class="h-flow" d="M285 205 C390 260 470 270 560 225"/>
    <g class="h-tile"><rect x="330" y="96" width="66" height="50" rx="6"/><path d="M338 138 l16 -18 l12 12 l10 -8 l16 14"/><circle cx="382" cy="110" r="5"/></g>
    <g class="h-tile"><rect x="420" y="168" width="66" height="50" rx="6"/><path d="M428 210 l16 -18 l12 12 l10 -8 l16 14"/><circle cx="472" cy="182" r="5"/></g>
    <g class="h-tile h-bad"><rect x="360" y="244" width="66" height="50" rx="6"/><path d="M368 286 l16 -18 l12 12"/><path class="h-cut" d="M394 248 V290 M402 248 V290 M410 248 V290 M418 248 V290"/></g>
    <g transform="translate(590 92)">
      <rect class="h-screen" x="0" y="0" width="290" height="180" rx="10"/>
      <rect class="h-inner" x="14" y="14" width="262" height="152" rx="6"/>
      <g class="h-ok-tile"><rect x="30" y="30" width="70" height="52" rx="5"/><rect x="110" y="30" width="70" height="52" rx="5"/><rect x="190" y="30" width="70" height="52" rx="5"/><rect x="30" y="96" width="70" height="52" rx="5"/><rect x="110" y="96" width="70" height="52" rx="5"/></g>
      <rect class="h-bad-tile" x="190" y="96" width="70" height="52" rx="5"/>
      <g class="h-check"><path d="M54 58 l8 8 l16 -16"/><path d="M134 58 l8 8 l16 -16"/><path d="M214 58 l8 8 l16 -16"/><path d="M54 124 l8 8 l16 -16"/><path d="M134 124 l8 8 l16 -16"/></g>
      <path class="h-base" d="M-24 192 H314 L296 214 H-6 Z"/>
    </g>
    <text class="h-tag" x="40" y="350">RECOVER TO A DIFFERENT DRIVE · NEVER BACK TO THE CARD</text>
  </svg>
  <figcaption>StackGeist illustration</figcaption>
</figure>
<style>
  .hero-illus{margin:26px 0 6px}
  .hero-illus svg{display:block;width:100%;height:auto;border-radius:14px}
  .hero-illus figcaption{margin-top:8px;color:var(--ill-muted,#5f5f5a);font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.06em;text-transform:uppercase}
  .h-bg{fill:var(--ill-bg,#ffffff)}
  .h-grid path{stroke:var(--ill-grid,#1d152a);stroke-width:1}
  .h-card{fill:var(--ill-panel,#f6f6f3);stroke:var(--ill-a,#121212);stroke-width:3}
  .h-pins rect{fill:var(--ill-a,#121212);opacity:.85}
  .h-label{fill:var(--ill-b,#5f5f5a);opacity:.18;stroke:var(--ill-b,#5f5f5a);stroke-width:1.5}
  .h-cardtext{fill:var(--ill-text,#121212);font:800 44px ui-sans-serif,system-ui,'Segoe UI',sans-serif}
  .h-cardsub{fill:var(--ill-muted,#5f5f5a);font:600 15px ui-monospace,Consolas,monospace}
  .h-flow{fill:none;stroke:var(--ill-b,#5f5f5a);stroke-width:2.5;stroke-dasharray:7 7;opacity:.8}
  .h-tile rect{fill:var(--ill-panel,#f6f6f3);stroke:var(--ill-a,#121212);stroke-width:2}
  .h-tile path{fill:none;stroke:var(--ill-a,#121212);stroke-width:2.5;stroke-linejoin:round}
  .h-tile circle{fill:var(--ill-a,#121212)}
  .h-bad rect{stroke:var(--ill-muted,#5f5f5a)}
  .h-bad path{stroke:var(--ill-muted,#5f5f5a)}
  .h-cut{stroke:var(--ill-muted,#5f5f5a)!important;stroke-width:3!important;opacity:.7}
  .h-screen{fill:var(--ill-panel,#f6f6f3);stroke:var(--ill-text,#121212);stroke-width:2.5;opacity:.95}
  .h-inner{fill:var(--ill-bg,#ffffff)}
  .h-ok-tile rect{fill:var(--ill-a,#121212);opacity:.16;stroke:var(--ill-a,#121212);stroke-width:1.5}
  .h-bad-tile{fill:var(--ill-muted,#5f5f5a);opacity:.2}
  .h-check path{fill:none;stroke:var(--ill-a,#121212);stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round}
  .h-base{fill:var(--ill-text,#121212);opacity:.85}
  .h-tag{fill:var(--ill-b,#5f5f5a);font:600 13px ui-monospace,Consolas,monospace;letter-spacing:.1em}
</style>
