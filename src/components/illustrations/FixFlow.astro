---
// Original StackGeist illustration: the fix-first approach as a four-step flow.
interface Props { caption?: string }
const { caption = 'How every StackGeist fix guide works: confirm the symptom, run the free checks, apply the fix, and only then decide whether anything needs replacing.' } = Astro.props;
---
<figure class="sg-illus">
  <div class="sg-illus-scroll" tabindex="0" role="region" aria-label="Fix-first flow illustration">
    <svg viewBox="0 0 860 210" role="img" aria-labelledby="ff-title ff-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="ff-title">Fix-first flow</title>
      <desc id="ff-desc">Four steps from left to right: Symptom, Checks, Fix, and Buy only if needed. Most problems end at the fix step.</desc>
      <defs>
        <marker id="ff-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#4a3267"/></marker>
      </defs>
      <style>
        .ff-box{fill:#0e0a16;stroke:#3b3846;stroke-width:1.5}
        .ff-hot{fill:rgba(163,230,53,.07);stroke:#a3e635;stroke-width:2}
        .ff-t{fill:#f7f3fb;font:700 17px ui-sans-serif,system-ui,'Segoe UI',sans-serif}
        .ff-m{fill:#d9d1e0;font:13.5px ui-sans-serif,system-ui,'Segoe UI',sans-serif}
        .ff-k{fill:#c084fc;font:600 11px ui-monospace,Consolas,monospace;letter-spacing:.08em}
        .ff-ln{stroke:#4a3267;stroke-width:2;fill:none}
        .ff-ic{fill:none;stroke:#a3e635;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
        .ff-ic2{fill:none;stroke:#c084fc;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
      </style>
      <rect class="ff-box" x="10" y="30" width="185" height="150" rx="10"/>
      <path class="ff-ic2" d="M44 66 l14 -24 l14 24 z M58 52 v6 M58 62 v1"/>
      <text class="ff-k" x="30" y="100">01</text>
      <text class="ff-t" x="30" y="124">Symptom</text>
      <text class="ff-m" x="30" y="147">Say exactly what</text>
      <text class="ff-m" x="30" y="165">isn’t working.</text>
      <line class="ff-ln" x1="195" y1="105" x2="225" y2="105" marker-end="url(#ff-arrow)"/>
      <rect class="ff-box" x="229" y="30" width="185" height="150" rx="10"/>
      <circle class="ff-ic" cx="270" cy="54" r="11"/><path class="ff-ic" d="M278 62 l10 10"/>
      <text class="ff-k" x="249" y="100">02</text>
      <text class="ff-t" x="249" y="124">Checks</text>
      <text class="ff-m" x="249" y="147">Free, in order,</text>
      <text class="ff-m" x="249" y="165">safest first.</text>
      <line class="ff-ln" x1="414" y1="105" x2="444" y2="105" marker-end="url(#ff-arrow)"/>
      <rect class="ff-hot" x="448" y="30" width="185" height="150" rx="10"/>
      <path class="ff-ic" d="M484 66 l18 -18 m-4 -6 a8 8 0 1 0 10 10 l-4 -4 z"/>
      <text class="ff-k" x="468" y="100">03</text>
      <text class="ff-t" x="468" y="124">Fix</text>
      <text class="ff-m" x="468" y="147">Most problems</text>
      <text class="ff-m" x="468" y="165">end here.</text>
      <line class="ff-ln" x1="633" y1="105" x2="663" y2="105" marker-end="url(#ff-arrow)"/>
      <rect class="ff-box" x="667" y="30" width="185" height="150" rx="10" stroke-dasharray="6 5"/>
      <path class="ff-ic2" d="M700 44 h6 l6 22 h18 l5 -15 h-26 M714 74 a2 2 0 1 0 .1 0 M728 74 a2 2 0 1 0 .1 0"/>
      <text class="ff-k" x="687" y="100">04</text>
      <text class="ff-t" x="687" y="124">Buy only if needed</text>
      <text class="ff-m" x="687" y="147">When a check proves</text>
      <text class="ff-m" x="687" y="165">the hardware is the limit.</text>
    </svg>
  </div>
  <figcaption>{caption} <span class="sg-illus-label">StackGeist illustration</span></figcaption>
</figure>
<style>
  .sg-illus{margin:32px 0 8px;padding:18px;border:1px solid var(--term-border);border-radius:8px;background:var(--surface)}
  .sg-illus-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .sg-illus svg{display:block;width:100%;min-width:640px;height:auto}
  .sg-illus figcaption{margin-top:10px;color:var(--quiet);font-size:.875rem;line-height:1.5}
  .sg-illus-label{margin-left:6px;color:var(--purple-light);font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.06em;text-transform:uppercase}
</style>
