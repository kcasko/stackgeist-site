---
import BrandMark from './BrandMark.astro';
import { SECTIONS, SECTION_ORDER } from '../data/sections';
import type { Section } from '../data/catalog';

// `active` keeps the old route keys so existing pages need no edits.
type LegacyKey = 'setups' | 'gear' | 'guides' | 'kits' | 'labs' | 'certs';
interface Props { active?: LegacyKey | Section }
const { active } = Astro.props;
const legacy: Record<string, Section> = { guides: 'fixes', certs: 'learning', kits: 'gear', setups: 'gear' };
const path = Astro.url.pathname;
const fromPath: Section | undefined =
  path.startsWith('/guides') ? 'fixes'
  : path.startsWith('/labs') ? 'labs'
  : path.startsWith('/certs') || path.startsWith('/learning') ? 'learning'
  : path.startsWith('/gear') || path.startsWith('/kits') || path.startsWith('/setups') ? 'gear'
  : undefined;
const current: Section | undefined = active ? (legacy[active] ?? (active as Section)) : fromPath;
---
<header class="site-masthead">
  <div class="mast-top">
    <a class="brand" href="/" aria-label="StackGeist home">
      <BrandMark size={44} />
      <span class="wordmark" aria-hidden="true">Stack<span>Geist</span></span>
    </a>
    <p class="mast-strap">Fixes, home labs, and IT study notes.<br />Written by someone who opens the case first.</p>
    <form class="mast-search" action="/search/" method="get" role="search">
      <label class="sr-only" for="site-search">Search StackGeist</label>
      <input id="site-search" name="q" type="search" placeholder="Search: dock, SSD, AD lab…" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  </div>
  <nav class="mast-nav" aria-label="Sections">
    <ul>
      {SECTION_ORDER.map((key) => (
        <li data-section={key}>
          <a href={SECTIONS[key].href} aria-current={current === key ? 'page' : undefined}>{SECTIONS[key].label}</a>
        </li>
      ))}
    </ul>
    <ul class="mast-aux">
      <li class="nav-about"><a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a></li>
      <li class="nav-search"><a href="/search/">Search</a></li>
    </ul>
  </nav>
  <div class="stripe" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
</header>

<style>
.site-masthead { padding-top: var(--space-4); }
.mast-top { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-5); padding-bottom: var(--space-4); }
.brand { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; }
.brand:hover { background: none; color: var(--ink); }
.brand :global(.brand-mark) { flex: none; transition: transform .12s; }
.brand:hover :global(.brand-mark) { transform: rotate(-6deg); }
.wordmark { font: 900 clamp(1.9rem, 3.4vw, 2.6rem)/1 var(--font-sans); font-stretch: 78%; letter-spacing: -.01em; text-transform: uppercase; }
.wordmark span { padding: 0 .08em; margin-left: .04em; background: var(--mark-bg); color: var(--mark-fg); }
.mast-strap { margin: 0; color: var(--ink-3); font-size: .86rem; line-height: 1.35; }
.mast-search { display: flex; }
.mast-search input {
  width: 15.5rem; min-height: 40px; padding: 0 10px;
  border: 2px solid var(--ink); border-right: 0; border-radius: 0; background: var(--surface); color: var(--ink); font-size: .92rem;
}
.mast-search input::placeholder { color: var(--ink-3); }
.mast-search button {
  min-height: 40px; padding: 0 14px; border: 2px solid var(--ink); border-radius: 0;
  background: var(--ink); color: var(--base); font: 800 .78rem var(--font-sans); font-stretch: var(--expanded); text-transform: uppercase; cursor: pointer;
}
.mast-search button:hover { background: var(--geist); color: #121212; }

.mast-nav { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-4); }
.mast-nav ul { display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; }
.mast-nav a {
  display: flex; align-items: center; min-height: 46px; padding: 6px 18px 0;
  border-top: 5px solid var(--dept, var(--ink)); background: var(--surface);
  color: var(--ink); font: 850 1.02rem/1 var(--font-sans); font-stretch: 82%; letter-spacing: .01em; text-transform: uppercase; text-decoration: none;
}
.mast-nav a:hover { background: var(--surface-2); color: var(--ink); }
.mast-nav a[aria-current="page"] { background: var(--dept, var(--ink)); color: var(--on-dept, var(--base)); }
.mast-aux a { border-top-color: transparent; background: transparent; color: var(--ink-3); font-size: .9rem; }
.mast-aux a[aria-current="page"] { background: var(--ink); color: var(--base); }
.nav-search { display: none !important; }

@media (max-width: 1060px) {
  .mast-strap { display: none; }
  .mast-top { grid-template-columns: auto 1fr; }
  .mast-search { justify-self: end; }
}
@media (max-width: 760px) {
  .mast-top { padding-bottom: var(--space-3); }
  .mast-search { display: none; }
  .nav-search { display: flex !important; }
  .mast-nav { display: grid; grid-template-columns: 1fr; gap: 0; }
  .mast-nav > ul:first-child { display: grid; grid-template-columns: repeat(4, 1fr); gap: 3px; }
  .mast-nav a { justify-content: center; min-height: 44px; padding: 5px 4px 0; font-size: .86rem; }
  .mast-aux { justify-content: flex-end; }
  .mast-aux a { min-height: 44px; padding: 4px 4px 0 10px; font-size: .8rem; }
  .nav-about { display: none !important; }
  .wordmark { font-size: 1.65rem; }
  .brand :global(.brand-mark) { width: 36px; height: 36px; }
  .mast-nav > ul.mast-aux { order: -1; position: absolute; top: 12px; right: var(--page-pad); }
  .site-masthead { position: relative; }
}
</style>
