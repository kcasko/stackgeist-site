---
interface Props { active?: 'setups'|'gear'|'guides'; interactive?: boolean; }
const { active, interactive=false }=Astro.props;
const links=[{key:'setups',label:'setups',href:'/setups/gaming'},{key:'gear',label:'gear',href:'/gear'},{key:'guides',label:'guides',href:'/guides/desk-layout-basics'}] as const;
---
<header class="site-header" data-header>
  <a class="brand" href="/" aria-label="StackGeist home"><span class="brand-prompt" aria-hidden="true">sg@local:</span><strong>~/</strong><span class="brand-name">STACKGEIST</span><span class="brand-cursor" aria-hidden="true">_</span></a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {links.map((link)=>interactive?(<button type="button" data-nav-branch={link.key}>/{link.label}</button>):(<a class:list={{active:active===link.key}} href={link.href}>/{link.label}</a>))}
    <a href="/gear/budget-tech/compare">/compare</a><a href="/about">/about</a>
  </nav>
  <a class="header-cta" href="/gear/budget-tech"><span aria-hidden="true">$</span> find --useful</a>
  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle><span></span><span></span></button>
  <nav class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    <span class="menu-label">$ ls /stackgeist</span>
    {links.map((link)=>interactive?(<button type="button" data-nav-branch={link.key}>├── {link.label}<span aria-hidden="true">→</span></button>):(<a class:list={{active:active===link.key}} href={link.href}>├── {link.label}<span aria-hidden="true">→</span></a>))}
    <a href="/gear/budget-tech/compare">├── compare <span aria-hidden="true">→</span></a><a href="/about">└── about <span aria-hidden="true">→</span></a><a class="mobile-cta" href="/gear/budget-tech">$ find --useful <span aria-hidden="true">→</span></a>
  </nav>
</header>
<style>
.site-header{position:sticky;top:0;z-index:30;height:66px;display:flex;align-items:center;padding:0 var(--page-pad);border-bottom:1px solid var(--term-border);background:rgba(7,5,13,.96);font-family:var(--font-mono)}
.site-header::after{content:'';position:absolute;right:var(--page-pad);bottom:-1px;left:var(--page-pad);height:1px;background:linear-gradient(90deg,var(--phosphor) 0 72px,transparent 72px);opacity:.8}.brand{display:inline-flex;align-items:baseline;gap:4px;font-size:12px}.brand-prompt{color:var(--phosphor)}.brand strong{color:var(--purple-light);font-weight:500}.brand-name{margin-left:6px;color:var(--text);font-size:13px;font-weight:700;letter-spacing:.06em}.brand-cursor{color:var(--phosphor);animation:blink 1.05s steps(2) infinite}@keyframes blink{50%{opacity:0}}.desktop-nav{margin-left:auto;display:flex;align-items:center;gap:25px}.desktop-nav button,.desktop-nav a{position:relative;padding:7px 0;border:0;background:transparent;color:var(--quiet);font:600 11.5px var(--font-mono);cursor:pointer}.desktop-nav button:hover,.desktop-nav a:hover,.desktop-nav a.active{color:var(--phosphor)}.desktop-nav a.active::before{content:'>';position:absolute;left:-12px;color:var(--phosphor)}.header-cta{display:inline-flex;min-height:32px;align-items:center;gap:8px;margin-left:28px;padding:0 11px;border:1px solid var(--term-border-strong);color:var(--purple-light);font-size:11px;font-weight:600}.header-cta span{color:var(--phosphor)}.header-cta:hover{border-color:var(--phosphor);background:rgba(163,230,53,.05);color:var(--phosphor)}.menu-toggle,.mobile-menu{display:none}@media(max-width:980px){.desktop-nav{gap:17px}.header-cta{display:none}}@media(max-width:760px){.site-header{height:60px;padding:0 18px}.site-header::after{left:18px;right:18px}.brand-prompt{display:none}.desktop-nav{display:none}.menu-toggle{position:absolute;right:16px;top:12px;display:grid;width:38px;height:35px;place-content:center;gap:6px;border:1px solid var(--term-border-strong);border-radius:0;background:var(--term-bg);cursor:pointer}.menu-toggle span{display:block;width:16px;height:1px;background:var(--phosphor);transition:transform .15s linear}.site-header[data-open="true"] .menu-toggle span:first-child{transform:translateY(3.5px) rotate(45deg)}.site-header[data-open="true"] .menu-toggle span:last-child{transform:translateY(-3.5px) rotate(-45deg)}.mobile-menu{position:absolute;top:60px;left:0;right:0;padding:16px 18px 20px;border-bottom:1px solid var(--phosphor);background:#07070a;box-shadow:0 24px 35px rgba(0,0,0,.7)}.site-header[data-open="true"] .mobile-menu{display:grid;gap:2px}.menu-label{margin-bottom:8px;color:var(--phosphor);font-size:11px}.mobile-menu button,.mobile-menu a{width:100%;min-height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;border:1px solid transparent;border-radius:0;background:transparent;color:var(--muted);font:600 12.5px var(--font-mono);text-align:left;cursor:pointer}.mobile-menu button:hover,.mobile-menu a:hover,.mobile-menu a.active{border-color:var(--term-border);background:rgba(163,230,53,.04);color:var(--phosphor)}.mobile-menu .mobile-cta{margin-top:8px;border-color:var(--phosphor);color:var(--phosphor)}}
</style>
<script>
const header=document.querySelector('[data-header]');const toggle=header?.querySelector('[data-menu-toggle]');toggle?.addEventListener('click',()=>{const open=header?.getAttribute('data-open')==='true';header?.setAttribute('data-open',String(!open));toggle.setAttribute('aria-expanded',String(!open));});document.addEventListener('keydown',(event)=>{if(event.key==='Escape'){header?.setAttribute('data-open','false');toggle?.setAttribute('aria-expanded','false');}});
</script>
