---
interface Props {
  variant?: 'card' | 'inline';
  heading?: string;
  subhead?: string;
}
const {
  variant = 'card',
  heading = 'Get StackGeist Notes by email.',
  subhead = 'Occasional computer fixes, home lab lessons, and IT study updates. Free checks first. No daily blasts or paid placements. Any affiliate links are clearly disclosed.',
} = Astro.props;
const headingId = `newsletter-${variant}-title`;
---
<section class={`newsletter ${variant}`} aria-labelledby={headingId}>
  <div class="nl-copy">
    <p class="nl-label">Newsletter</p>
    <h2 id={headingId}>{heading}</h2>
    <p class="nl-sub">{subhead}</p>
    <a class="nl-subscribe" href="https://stackgeist.kit.com/091a91df1b">Subscribe on Kit</a>
    <p class="nl-small">Free. Unsubscribe anytime. Kit handles your signup. See the <a href="/privacy/">privacy policy</a>.</p>
  </div>
  <ul class="nl-list" aria-label="What you get">
    <li><strong>New fix guides</strong><span>Step-by-step diagnosis for USB-C, storage, charging, and Wi-Fi problems.</span></li>
    <li><strong>Home lab write-ups</strong><span>What was built, what broke, and how it was verified.</span></li>
    <li><strong>Certification updates</strong><span>Exam version changes, checked against official pages.</span></li>
  </ul>
</section>
<style>
.newsletter { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); margin: var(--space-8) 0 0; border: 3px solid var(--ink); background: var(--surface); }
.newsletter.inline { margin-top: var(--space-7); }
.nl-copy { padding: var(--space-5) var(--space-5) var(--space-4); }
.nl-label { margin: 0; color: var(--ink-3); font: 800 .7rem/1.2 var(--font-sans); font-stretch: var(--expanded); letter-spacing: .06em; text-transform: uppercase; }
.nl-copy h2 { max-width: 22ch; margin: 6px 0 var(--space-2); font: 850 clamp(1.7rem, 3vw, 2.3rem)/1 var(--font-sans); font-stretch: var(--condensed); }
.nl-sub { max-width: 54ch; margin: 0; color: var(--ink-2); font-size: .98rem; line-height: 1.5; }
.nl-subscribe { display: inline-flex; align-items: center; min-height: 46px; margin-top: var(--space-4); padding: 0 20px; border: 2px solid var(--ink); background: var(--ink); color: var(--base); font: 800 .85rem/1 var(--font-sans); font-stretch: var(--expanded); text-decoration: none; text-transform: uppercase; }
.nl-subscribe:hover { background: var(--geist); color: #121212; }
.nl-small { margin: var(--space-2) 0 0; color: var(--ink-3); font-size: .82rem; }
.nl-list { display: grid; align-content: center; margin: 0; padding: var(--space-4) var(--space-5); list-style: none; border-left: 3px solid var(--ink); background: var(--base); }
.nl-list li { display: grid; gap: 2px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
.nl-list li:last-child { border-bottom: 0; }
.nl-list strong { font-weight: 750; }
.nl-list span { color: var(--ink-2); font-size: .9rem; line-height: 1.45; }
@media (max-width: 760px) {
  .newsletter { grid-template-columns: minmax(0, 1fr); }
  .newsletter > * { min-width: 0; }
  .nl-copy { padding: var(--space-4); }
  .nl-list { border-left: 0; border-top: 3px solid var(--ink); padding: var(--space-3) var(--space-4); }
}
</style>
