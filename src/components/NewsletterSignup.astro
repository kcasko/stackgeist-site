---
interface Props {
  variant?: 'card' | 'inline';
  heading?: string;
  subhead?: string;
}
const {
  variant = 'card',
  heading = 'Get new fixes and lab write-ups by email.',
  subhead = 'An occasional email when a new troubleshooting guide, home lab, or certification guide is published. No sponsored content.',
} = Astro.props;
const headingId = `newsletter-${variant}-title`;
---
<section class={`newsletter ${variant}`} aria-labelledby={headingId}>
  <div class="nl-copy">
    <p class="nl-label">Newsletter</p>
    <h2 id={headingId}>{heading}</h2>
    <p class="nl-sub">{subhead}</p>
    <form
      class="nl-form embeddable-buttondown-form"
      action="https://buttondown.com/api/emails/embed-subscribe/stackgeist"
      method="post"
      target="popupwindow"
      onsubmit="window.open('https://buttondown.com/stackgeist', 'popupwindow')"
    >
      <label class="sr-only" for={`email-${variant}`}>Email address</label>
      <input id={`email-${variant}`} type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
      <input type="hidden" value="1" name="embed" />
      <input type="hidden" value="stackgeist-site" name="tag" />
      <button type="submit">Subscribe</button>
    </form>
    <p class="nl-small">Free. Unsubscribe anytime. See the <a href="/privacy/">privacy policy</a>.</p>
  </div>
  <ul class="nl-list" aria-label="What you get">
    <li><strong>New fix guides</strong><span>Step-by-step diagnosis for USB-C, storage, charging, and Wi-Fi problems.</span></li>
    <li><strong>Home lab write-ups</strong><span>What was built, what broke, and how it was verified.</span></li>
    <li><strong>Certification updates</strong><span>Exam version changes, checked against official pages.</span></li>
  </ul>
</section>
<style>
.newsletter{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:0;margin:48px 0 24px;border:1px solid var(--term-border);border-radius:8px;background:var(--surface);font-family:var(--font-sans,system-ui,sans-serif);overflow:hidden}
.newsletter.inline{margin:40px 0 8px}
.nl-copy{padding:28px 30px}
.nl-label{margin:0;color:var(--purple-light);font-family:var(--font-mono);font-size:.75rem;letter-spacing:.06em;text-transform:uppercase}
.nl-copy h2{margin:10px 0 10px;max-width:28ch;font-family:var(--font-sans,system-ui,sans-serif);font-size:clamp(1.4rem,2.4vw,1.75rem);font-weight:700;line-height:1.25;letter-spacing:-.015em}
.nl-sub{max-width:56ch;margin:0;color:var(--read,#d9d1e0);font-size:1rem;line-height:1.6}
.nl-form{display:flex;gap:8px;margin-top:20px;max-width:520px}
.nl-form input[type="email"]{min-width:0;flex:1;padding:12px 14px;border:1px solid var(--term-border-strong);border-radius:6px;background:var(--term-bg);color:var(--text);font:inherit;font-size:1rem}
.nl-form input[type="email"]::placeholder{color:var(--quiet)}
.nl-form input[type="email"]:focus{outline:2px solid var(--phosphor);outline-offset:2px}
.nl-form button{min-height:44px;padding:0 20px;border:1px solid var(--phosphor);border-radius:6px;background:var(--phosphor);color:#0b0d05;font:inherit;font-size:1rem;font-weight:700;cursor:pointer}
.nl-form button:hover{background:#b8f04f}
.nl-form button:focus-visible{outline:2px solid var(--purple-light);outline-offset:3px}
.nl-small{margin:12px 0 0;color:var(--quiet);font-size:.8125rem}
.nl-list{display:grid;gap:0;margin:0;padding:12px 0;list-style:none;border-left:1px solid var(--term-border);background:var(--term-bg)}
.nl-list li{display:grid;gap:4px;padding:14px 26px}
.nl-list li+li{border-top:1px solid var(--term-border)}
.nl-list strong{color:var(--text);font-size:.9688rem}
.nl-list strong::before{content:'✓ ';color:var(--phosphor)}
.nl-list span{color:var(--read,#d9d1e0);font-size:.9063rem;line-height:1.5}
.newsletter > .nl-list{margin:0 !important;align-self:stretch}
.nl-small a{color:var(--phosphor);text-decoration:underline;text-underline-offset:3px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:760px){.newsletter{grid-template-columns:1fr}.nl-copy{padding:24px 20px}.nl-form{display:grid}.nl-list{border-left:0;border-top:1px solid var(--term-border)}.nl-list li{padding:12px 20px}}
</style>
