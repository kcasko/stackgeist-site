---
// StackGeist newsletter signup + lead magnet CTA.
// Set FORM_ACTION to your ConvertKit / Buttondown / Beehiiv / Mailchimp form URL.
// Fallback is mailto so nothing breaks in build.
interface Props {
  variant?: 'card' | 'inline';
  heading?: string;
  subhead?: string;
}
const {
  variant = 'card',
  heading = 'Get the Budget Tech cheat sheet',
  subhead = 'One email a week. The 12 under-$25 tech fixes that actually stop wasting your time. Free PDF when you subscribe.',
} = Astro.props;

const FORM_ACTION = 'mailto:hello@stackgeist.dev?subject=Budget%20Tech%20cheat%20sheet';
---
<section class={`newsletter ${variant}`}>
  <div class="nl-inner">
    <p class="page-kicker">Newsletter</p>
    <h2 class="nl-heading">{heading}</h2>
    <p class="nl-sub">{subhead}</p>
    <form class="nl-form" action={FORM_ACTION} method="post">
      <label class="visually-hidden" for="nl-email">Email address</label>
      <input class="nl-input" type="email" id="nl-email" name="email" placeholder="you@domain.com" required autocomplete="email" />
      <button class="nl-btn" type="submit">Send me the PDF</button>
    </form>
    <p class="nl-note">No spam. Unsubscribe any time. <a href="/downloads/budget-tech-cheat-sheet.pdf">Preview the PDF</a>.</p>
  </div>
</section>
<style>
  .newsletter { margin:64px 0 8px; }
  .newsletter.inline { margin:32px 0; }
  .nl-inner { border:1px solid var(--border); border-radius:16px; padding:32px; background:linear-gradient(180deg, rgba(155,92,255,0.06), rgba(8,7,12,0.4)); }
  .nl-heading { margin:8px 0 6px; font-size:26px; line-height:1.2; color:var(--text); }
  .nl-sub { margin:0 0 20px; color:var(--muted); max-width:640px; line-height:1.5; }
  .nl-form { display:flex; gap:10px; flex-wrap:wrap; max-width:520px; }
  .nl-input { flex:1 1 260px; min-width:0; padding:12px 14px; border:1px solid var(--border); background:rgba(8,7,12,0.6); color:var(--text); border-radius:10px; font-size:15px; }
  .nl-input:focus { outline:2px solid var(--purple-light); outline-offset:1px; }
  .nl-btn { padding:12px 18px; border:0; border-radius:10px; background:var(--purple-light,#9b5cff); color:#fff; font-weight:700; font-size:15px; cursor:pointer; }
  .nl-btn:hover { filter:brightness(1.08); }
  .nl-note { margin:12px 0 0; color:var(--quiet); font-size:12px; }
  .nl-note a { color:var(--purple-light); }
  .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:760px){ .nl-inner { padding:24px; } .nl-heading { font-size:22px; } }
</style>
