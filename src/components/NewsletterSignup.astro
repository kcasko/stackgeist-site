---
interface Props {
  variant?: 'card' | 'inline';
  heading?: string;
  subhead?: string;
}
const {
  variant = 'card',
  heading = 'Steal the 12-fix budget tech checklist.',
  subhead = 'A concise, printable cheat sheet for the low-cost upgrades that remove everyday setup friction. No email gate and no fake countdown.',
} = Astro.props;
---
<section class={`newsletter ${variant}`} aria-labelledby="lead-magnet-title">
  <div class="nl-copy">
    <p class="eyebrow">Free field guide · PDF</p>
    <h2 id="lead-magnet-title">{heading}</h2>
    <p>{subhead}</p>
    <div class="nl-actions">
      <a class="download" href="/downloads/budget-tech-cheat-sheet.pdf" download>Download the free checklist <span aria-hidden="true">↓</span></a>
      <a class="preview" href="/downloads/budget-tech-cheat-sheet.pdf">Preview it first <span aria-hidden="true">↗</span></a>
    </div>
    <small>Instant download · 12 practical fixes · no signup required</small>
  </div>
  <div class="sheet-preview" aria-hidden="true">
    <div class="sheet sheet-back"></div>
    <div class="sheet sheet-front">
      <span class="sheet-brand">STACKGEIST</span>
      <strong>BUDGET TECH<br />CHEAT SHEET</strong>
      <i></i><i></i><i></i><i></i>
      <small>12 fixes under $75</small>
    </div>
  </div>
</section>

<style>
  .newsletter { position:relative; min-height:370px; display:grid; grid-template-columns:1.1fr .7fr; align-items:center; gap:60px; margin:108px 0 24px; overflow:hidden; padding:55px clamp(30px,6vw,78px); border:1px solid #54366c; border-radius:20px; background:radial-gradient(circle at 85% 20%,rgba(168,85,247,.17),transparent 32%),linear-gradient(135deg,#140b1e,#0b0810 65%); }
  .newsletter::before { content:''; position:absolute; inset:0; opacity:.2; background-image:linear-gradient(rgba(192,132,252,.12) 1px,transparent 1px),linear-gradient(90deg,rgba(192,132,252,.12) 1px,transparent 1px); background-size:54px 54px; mask-image:linear-gradient(90deg,transparent,#000 60%,#000); pointer-events:none; }
  .newsletter.inline { min-height:310px; margin:48px 0 8px; }
  .nl-copy { position:relative; z-index:1; max-width:700px; }
  .nl-copy h2 { margin:13px 0 14px; font-size:clamp(31px,4vw,50px); line-height:1.04; letter-spacing:-.045em; }
  .nl-copy > p:not(.eyebrow) { max-width:620px; margin:0; color:#aaa0b4; font-size:15px; line-height:1.62; }
  .nl-actions { display:flex; flex-wrap:wrap; align-items:center; gap:14px 20px; margin-top:27px; }
  .nl-actions a { display:inline-flex; align-items:center; justify-content:center; gap:9px; min-height:46px; font-size:13px; font-weight:750; }
  .download { padding:0 19px; border-radius:9px; background:linear-gradient(135deg,#8b5cf6,#a855f7); color:#fff; box-shadow:0 20px 38px -22px rgba(168,85,247,.85); }
  .download:hover { filter:brightness(1.08); }
  .preview { color:#cbbbd6; }
  .preview:hover { color:#fff; }
  .nl-copy > small { display:block; margin-top:16px; color:#796d83; font-size:10px; }
  .sheet-preview { position:relative; z-index:1; min-height:260px; perspective:1000px; }
  .sheet { position:absolute; top:50%; left:50%; width:185px; height:245px; border-radius:4px; background:#f8f6fb; box-shadow:0 35px 65px -28px rgba(0,0,0,.9); }
  .sheet-back { transform:translate(-41%,-50%) rotate(9deg); opacity:.4; }
  .sheet-front { display:flex; flex-direction:column; padding:24px; transform:translate(-57%,-50%) rotate(-5deg); color:#21152b; }
  .sheet-brand { color:#7c3aed; font-size:8px; font-weight:900; letter-spacing:.12em; }
  .sheet-front strong { margin:22px 0 19px; font-size:18px; line-height:1.05; letter-spacing:-.04em; }
  .sheet-front i { display:block; height:1px; margin:7px 0; background:#d9d1df; }
  .sheet-front i:nth-of-type(2){width:78%}.sheet-front i:nth-of-type(3){width:91%}.sheet-front i:nth-of-type(4){width:63%}
  .sheet-front small { margin-top:auto; color:#7c3aed; font-size:8px; font-weight:800; text-transform:uppercase; }
  @media(max-width:760px){
    .newsletter { grid-template-columns:1fr; gap:28px; margin-top:86px; padding:36px 25px 28px; }
    .nl-actions { display:grid; }
    .nl-actions a { width:100%; }
    .sheet-preview { min-height:240px; }
  }
</style>
