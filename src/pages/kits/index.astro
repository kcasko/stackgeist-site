---
import ContentLayout from '../../layouts/ContentLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { INCOME_KITS, IT_KIT_SLUGS, FIX_KIT_SLUGS } from '../../data/incomeKits';


const groups = [
  { id: 'it-study-homelab', title: 'IT study and home labs', note: 'Practice gear and study tools for support, systems, and cloud work.', kits: INCOME_KITS.filter((kit) => IT_KIT_SLUGS.has(kit.slug)) },
  { id: 'fix-a-problem', title: 'Fix a PC or connectivity problem', note: 'What to try and buy when a diagnosis points to hardware.', kits: INCOME_KITS.filter((kit) => FIX_KIT_SLUGS.has(kit.slug)) },
  { id: 'desk-everyday', title: 'Desk and everyday tech', note: 'Video calls, audio, gaming, travel, and home office.', kits: INCOME_KITS.filter((kit) => !IT_KIT_SLUGS.has(kit.slug) && !FIX_KIT_SLUGS.has(kit.slug)) },
];
---
<ContentLayout title="IT, home lab, and tech buying kits | StackGeist" description="Buying orders for IT study, home labs, PC fixes, and everyday tech, with what to get first, what to skip, and what has and hasn’t been checked." active="kits">
  <p class="breadcrumbs"><a href="/">StackGeist</a> / Kits</p>
  <p class="page-kicker">Kits</p>
  <h1 class="page-title">What to buy, in what order, and what to skip.</h1>
  <p class="page-lead">Each kit is a buying order for one goal. Start with what you already own and add only what the next step needs.</p>

  <nav class="kit-jump" aria-label="Jump to a kit group">
    {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
  </nav>

  <section class="content-section">
    <div class="note">Many kits use Amazon search links as a starting point, and the products in those results have not been individually checked. Each kit says which items these are. Read the <a href="/affiliate-disclosure/">affiliate disclosure</a>.</div>
  </section>

  {groups.map((group) => (
    <section class="content-section" id={group.id}>
      <h2>{group.title}</h2>
      <p>{group.note}</p>
      <div class="cards">
        {group.kits.map((kit) => (
          <a class="card" href={`/kits/${kit.slug}/`}>
            <h3>{kit.title}</h3>
            <p>{kit.promise}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <NewsletterSignup />

  <style>
    .kit-jump { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }
    .kit-jump a { padding:8px 12px; border:1px solid var(--term-border-strong); font-size:12.5px; }
  </style>
</ContentLayout>
