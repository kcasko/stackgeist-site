---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import ProductDetailSimple from '../../../components/ProductDetailSimple.astro';
import EvidencePanel from '../../../components/EvidencePanel.astro';
import { productSchema } from '../../../lib/structured-data';
const __sd = [productSchema({ name: 'Amazon Basics Gas Spring Dual Monitor Arm', description: 'A researched buying note on the Amazon Basics Gas Spring Dual Monitor Arm (DS-MADDBE): what it fits, its limits, and who should consider it.', url: 'https://stackgeist.dev/gear/monitor-support/amazon-basics-dual-monitor-arm', brand: 'Amazon Basics', image: 'https://stackgeist.dev/gear/catalog-illustration.svg' })];
---
<ContentLayout structuredData={__sd} title="Amazon Basics dual monitor arm: what it fits | StackGeist" description="A researched buying note on the Amazon Basics Gas Spring Dual Monitor Arm (DS-MADDBE): monitor sizes, weight limits, VESA compatibility, and when to skip it." active="gear">
  <ProductDetailSimple
    eyebrow="Monitor support"
    heading="Amazon Basics dual monitor arm"
    intro="The Amazon Basics Gas Spring Dual Monitor Arm (model DS-MADDBE) is a budget-friendly dual-arm desk mount for two standard-size monitors. It uses gas-spring arms to hold each screen off the desk surface and free up workspace."
    productName="Amazon Basics Gas Spring Dual Monitor Arm"
    productMeta="Model DS-MADDBE · dual monitor desk mount · VESA 75x75 / 100x100"
    tags={['monitor arm', 'dual monitor', 'desk setup']}
    why="Good for a two-monitor desk setup where you want to reclaim desk space and position each screen at a comfortable height and angle. The per-arm weight range fits most 24–27 inch office monitors."
    tradeoff="The arms support up to 15.4 lbs each. A 27-inch monitor near that limit may sag if it is heavier than expected, and very light monitors may not lower smoothly because the gas spring needs enough load to counterbalance."
    check="Weigh each monitor without its factory stand, confirm the VESA mounting holes are 75x75 mm or 100x100 mm, and measure your desk thickness to make sure the clamp will fit. Also confirm the arm reach and maximum height match where you want each screen."
    facts="Retailer listings and the product manual for DS-MADDBE describe a gas-spring dual monitor arm that fits 15–27 inch LCD/LED monitors, supports 4.4–15.4 lbs per arm, uses VESA 75x75 or 100x100 patterns, and mounts to a desk with a clamp. Color is black."
    skip="you have monitors heavier than 15.4 lbs each, an ultrawide that exceeds the arm's size or weight range, a desk too thick or fragile for the clamp, or you need independent single-arm products with more adjustment range."
    imageUrl="/gear/catalog-illustration.svg"
    imageAlt="Generic illustration of a dual monitor arm holding two displays above a desk"
    imageCaption="Product image: StackGeist illustration."
    imageExample={false}
    amazonUrl="https://www.amazon.com/dp/B0CQXPGNCH/?tag=deskrespawn-20"
    makerLabel="Amazon Basics"
    makerUrl="https://www.amazon.com/dp/B0CQXPGNCH/"
    backHref="/gear/"
    backLabel="Gear"
  />
  <EvidencePanel status="researched" reviewed="2026-11-07" sources={[
    { label: 'Amazon — Amazon Basics Gas Spring Dual Monitor Arm DS-MADDBE (specifications)', href: 'https://www.amazon.com/dp/B0CQXPGNCH' },
    { label: 'Manuals.plus — DS-MADDBE product specifications', href: 'https://manuals.plus/asin/B0CQXPGNCH' },
  ]} />

  <section class="content-section related-reading"><p class="page-kicker">Related</p><div class="cards">
    <a class="card" href="/guides/monitor-arm-sagging-fix/"><h3>Monitor arm sagging</h3><p>Load, tension, VESA hardware, and desk-attachment checks.</p></a>
    <a class="card" href="/gear/monitor-support/ergotron-lx/"><h3>Ergotron LX monitor arm</h3><p>A source-backed single-monitor arm decision page.</p></a>
  </div></section>
</ContentLayout>
