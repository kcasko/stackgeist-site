---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import ProductDetailSimple from '../../../components/ProductDetailSimple.astro';
import { productSchema, faqSchema } from '../../../lib/structured-data';
const __sd = [productSchema({ name: "Elgato Wave:3 (MK.1)", description: "The original Wave:3 is a capable USB condenser microphone with direct monitoring and mixer software, but placement and room noise matter more than its maximum sample rate.", url: 'https://stackgeist.dev/gear/audio/elgato-wave-3', image: 'https://m.media-amazon.com/images/I/61KjhEX33JL._AC_SL1500_.jpg', brand: 'Elgato' })];
---
<ContentLayout structuredData={__sd} title="Elgato Wave:3 microphone fit guide | StackGeist" description="A fit-first Elgato Wave:3 guide covering room noise, mic distance, software, mounting, tradeoffs, and listing availability." active="gear">
  <ProductDetailSimple
    eyebrow="Audio / microphone"
    heading="A better microphone still needs to be close to the person speaking."
    intro="The original Wave:3 is a capable USB condenser microphone with direct monitoring and mixer software, but placement and room noise matter more than its maximum sample rate."
    productName="Elgato Wave:3 (MK.1)"
    imageUrl="https://m.media-amazon.com/images/I/61KjhEX33JL._AC_SL1500_.jpg"
    imageAlt="Black Elgato Wave:3 USB microphone on its desk stand"
    imageSourceLabel="Elgato"
    imageSourceUrl="https://help.elgato.com/hc/en-us/articles/360044557692-Elgato-Wave-3-MK-1-Technical-Specifications"
    productMeta="USB condenser microphone · Amazon ASIN B088HHWC47 · listing unavailable when verified"
    tags={['Cardioid condenser','USB-C','24-bit / 96kHz']}
    why="It provides a single USB connection, capacitive mute, onboard headphone monitoring, Clipguard, and Wave Link mixing—useful when calls, recording, or streaming need several software audio sources."
    tradeoff="A condenser microphone can capture keyboards, fans, reflections, and room noise. Good results usually require close placement; that may mean adding a boom arm and accepting another object in the camera frame."
    check="Check current availability first, then plan a position close to your mouth, confirm your OS supports Wave Link, and account for a boom arm or shock mount if the included desk stand puts the mic too far away."
    facts="Elgato specifies a 17 mm cardioid electret capsule, 24-bit resolution, 48/96 kHz sample rates, 70–20,000 Hz response, USB-C, a 3.5 mm headphone port, and 1/4-, 3/8-, and 5/8-inch mounting support through the adapter.[1]"
    skip="Skip it if the exact listing remains unavailable, your untreated room is noisy, you cannot place the microphone close, you only need intelligible meeting audio, or you want an XLR upgrade path."
    amazonUrl="https://www.amazon.com/dp/B088HHWC47?tag=deskrespawn-20"
    makerLabel="Elgato specifications [1]"
    makerUrl="https://help.elgato.com/hc/en-us/articles/360044557692-Elgato-Wave-3-MK-1-Technical-Specifications"
    backHref="/gear"
    backLabel="Gear"
  />
  <section class="content-section related-reading"><div class="note">Availability check: Amazon showed no featured offer and marked this original MK.1 listing unavailable during verification. Treat the retailer button as a listing-status check, not a stock promise.</div><p class="page-kicker">Sources</p><ol><li><a href="https://help.elgato.com/hc/en-us/articles/360044557692-Elgato-Wave-3-MK-1-Technical-Specifications">Elgato — Wave:3 MK.1 technical specifications</a></li><li><a href="https://www.amazon.com/dp/B088HHWC47">Amazon — exact ASIN B088HHWC47 and availability state</a></li></ol><div class="cards"><a class="card" href="/guides/better-video-calls"><h3>Improve calls in the right order</h3><p>Fix microphone distance and front lighting before chasing resolution.</p></a></div></section>
</ContentLayout>
