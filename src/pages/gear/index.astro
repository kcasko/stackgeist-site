---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { SECTIONS, entry, entries } from '../../data/sections';
import { INCOME_KITS, isKitIndexable } from '../../data/incomeKits';

// Evidence labels follow each product page's own EvidencePanel status.
const products = [
  { e: entry('/gear/budget-tech/wd-my-passport-4tb/'), img: '/gear/catalog-illustration.svg', kind: 'Portable hard drive', evidence: 'Owned and used', note: 'Owned since January 2026.', fix: { href: '/guides/wd-elements-not-showing-up/', label: 'Not showing up?' } },
  { e: entry('/gear/budget-tech/sennheiser-momentum-4-wireless-noise-cancelling-headphones/'), img: '/gear/catalog-illustration.svg', kind: 'Wireless headphones', evidence: 'Owned and used', note: 'Owned since April 2024. Codec support, adaptive noise cancelling, and fit notes.', fix: { href: '/guides/sennheiser-momentum-4-wont-pair/', label: 'Won’t pair?' } },
  { e: entry('/gear/connectivity/caldigit-ts4/'), img: '/gear/catalog-illustration.svg', kind: 'Thunderbolt 4 dock', evidence: 'Researched', fix: { href: '/guides/usb-c-dock-only-one-monitor/', label: 'Dock only showing one monitor?' } },
  { e: entry('/gear/connectivity/anker-553-usb-c-hub/'), img: '/gear/catalog-illustration.svg', kind: 'USB-C hub', evidence: 'Researched', fix: { href: '/guides/usb-c-hub-ethernet-works-hdmi-doesnt/', label: 'Hub HDMI not working?' } },
  { e: entry('/gear/input/logitech-mx-master-3s/'), img: '/gear/catalog-illustration.svg', kind: 'Mouse', evidence: 'Researched', fix: { href: '/guides/mx-master-3s-scroll-wheel-not-working/', label: 'Scroll wheel not working?' } },
  { e: entry('/gear/monitor-support/amazon-basics-dual-monitor-arm/'), img: '/gear/catalog-illustration.svg', kind: 'Dual monitor arm', evidence: 'Researched', fix: { href: '/guides/monitor-arm-sagging-fix/', label: 'Monitor arm sagging?' } },
];
const guides = entries(['/guides/usb-c-dock-compatibility/', '/guides/usb-c-cable-buying-guide/', '/guides/laptop-charger-wattage/', '/guides/how-to-tell-if-ssd-is-failing/']);
const kits = INCOME_KITS.filter(isKitIndexable);
---
<ContentLayout section="gear" title="Tech gear decision pages: docks, hubs, and more | StackGeist" description="StackGeist gear decision pages for docks, hubs, and accessories tied to our fix guides, with source-checked specifications, owned-and-used labels, and reasons to skip.">
  <header class="gear-head">
    <p class="head-tags"><span class="slab">Gear</span> <span class="kicker">Buy for the problem, not the category</span></p>
    <h1 class="page-title">Hardware notes that say how we know.</h1>
    <p class="page-lead">{SECTIONS.gear.blurb} “Owned and used” means Keith bought it and uses it. “Researched” means the page is built from manufacturer documentation. Neither one is a lab benchmark.</p>
  </header>

  <section class="products" aria-label="Product pages">
    {products.map((p) => (
      <article class:list={['product', { owned: p.evidence.startsWith('Owned') }]}>
        <a class="product-art" href={p.e.href} tabindex="-1" aria-hidden="true">
          {p.img ? <img src={p.img} alt="" width="480" height="300" loading="lazy" decoding="async" /> : <span class="stamp">Owned<br />and used</span>}
        </a>
        <div class="product-body">
          <p class="kicker">{p.kind}</p>
          <h2><a href={p.e.href}>{p.e.title}</a></h2>
          <p>{p.note ?? p.e.dek}</p>
          <p class="product-foot"><span class:list={['evidence', { owned: p.evidence.startsWith('Owned') }]}>{p.evidence}</span> <a href={p.fix.href}>{p.fix.label} Try the fix first</a></p>
        </div>
      </article>
    ))}
  </section>

  <div class="gear-lower">
    <section aria-labelledby="before-title">
      <h2 id="before-title" class="block-label">Before you buy</h2>
      <ul class="plain-list">{guides.map((e) => <li><a href={e.href}>{e.title}</a><p>{e.dek}</p></li>)}</ul>
    </section>
    <section aria-labelledby="kits-title">
      <h2 id="kits-title" class="block-label">Buying lists</h2>
      <p class="kits-note">Buying orders for one goal each. Many use retailer search links whose results have not been individually checked; each list says which. <a href="/kits/">All buying lists</a></p>
      <ul class="kit-list">{kits.map((k) => <li><a href={`/kits/${k.slug}/`}>{k.title}</a></li>)}</ul>
    </section>
  </div>
</ContentLayout>

<style>
.head-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0 0 var(--space-3); }
.head-tags .kicker { margin: 0; }
.products { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-5); margin-top: var(--space-7); }
.product { grid-column: span 2; display: grid; grid-template-rows: auto 1fr; border: 2px solid var(--ink); background: var(--surface); }
.product.owned { grid-column: span 3; box-shadow: 6px 6px 0 var(--geist); }
.product-art { display: grid; place-items: center; height: 200px; padding: var(--space-4); background: #fff; border-bottom: 2px solid var(--ink); }
.product-art:hover { background: #fff; }
.product-art { overflow: hidden; }
.product-art img { display: block; width: 100%; height: 168px; object-fit: contain; }
.product.owned .product-art { background: var(--geist); padding: var(--space-3); }
.product.owned .product-art img { box-sizing: border-box; height: 176px; background: #fff; border: 2px solid #121212; padding: var(--space-2); }
.stamp { display: inline-block; padding: 10px 16px; border: 4px solid #121212; color: #121212; font: 900 2rem/.95 var(--font-sans); font-stretch: var(--condensed); text-align: center; text-transform: uppercase; transform: rotate(-4deg); }
.product-body { display: flex; flex-direction: column; gap: 6px; padding: var(--space-4); }
.product-body .kicker { margin: 0; }
.product-body h2 { margin: 0; font: 850 1.45rem/1.05 var(--font-sans); font-stretch: 82%; }
.product-body h2 a { text-decoration: none; }
.product-body h2 a:hover { text-decoration: underline; }
.product-body > p { margin: 0; color: var(--ink-2); font-size: .95rem; line-height: 1.45; }
.product-body .product-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; margin-top: auto; padding-top: var(--space-2); font-size: .9rem; }
.evidence { display: inline-block; padding: 2px 7px; border: 1.5px solid var(--ink-3); color: var(--ink-2); font: 750 .7rem/1.3 var(--font-sans); font-stretch: var(--expanded); text-transform: uppercase; }
.evidence.owned { border-color: var(--ink); background: var(--geist); color: #121212; }
.gear-lower { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); margin-top: var(--space-8); }
.gear-lower section { border-top: 8px solid var(--dept); padding-top: var(--space-3); }
.block-label { margin: 0 0 var(--space-3); font: 900 1.4rem/1 var(--font-sans); font-stretch: var(--condensed); text-transform: uppercase; }
.plain-list, .kit-list { margin: 0; padding: 0; list-style: none; }
.plain-list li { padding: var(--space-3) 0; border-top: 1px solid var(--rule); }
.plain-list a { font: 800 1.1rem/1.2 var(--font-sans); font-stretch: 88%; }
.plain-list p { margin: 4px 0 0; color: var(--ink-2); font-size: .94rem; }
.kits-note { margin: 0 0 var(--space-3); color: var(--ink-2); font-size: .94rem; }
.kit-list { columns: 2 200px; column-gap: var(--space-5); }
.kit-list li { break-inside: avoid; padding: 6px 0; border-top: 1px solid var(--rule); font-size: .95rem; }
@media (max-width: 1060px) {
  .products { grid-template-columns: 1fr 1fr; }
  .product, .product.owned { grid-column: span 1; }
}
@media (max-width: 700px) {
  .products, .gear-lower { grid-template-columns: 1fr; }
  .product-art { height: 160px; }
  .product-art img { height: 128px; }
  .product.owned .product-art img { height: 136px; }
}
</style>
