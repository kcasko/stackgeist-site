---
import ContentLayout from '../../layouts/ContentLayout.astro';

const products = [
  { href: '/gear/connectivity/caldigit-ts4/', img: '/gear/caldigit-ts4.jpg', alt: 'CalDigit TS4 Thunderbolt 4 dock', kicker: 'Thunderbolt dock', title: 'CalDigit TS4', desc: 'An 18-port Thunderbolt desk dock for hosts that can actually use its displays, bandwidth, and 98W charging.', tags: ['ASIN matched', 'Thunderbolt 4'], fix: { href: '/guides/usb-c-dock-only-one-monitor/', label: 'Dock only showing one monitor?' } },
  { href: '/gear/connectivity/anker-553-usb-c-hub/', img: '/gear/anker-553-usb-c-hub.jpg', alt: 'Anker 553 eight-in-one USB-C hub', kicker: 'USB-C hub', title: 'Anker 553 8-in-1 USB-C hub', desc: 'Add HDMI, Ethernet, USB, and card readers to a compatible laptop. Host-port and operating-system limits matter.', tags: ['Source-checked', 'Dual HDMI'], fix: { href: '/guides/usb-c-hub-ethernet-works-hdmi-doesnt/', label: 'Hub HDMI not working?' } },
  { href: '/gear/input/logitech-mx-master-3s/', img: '/gear/logitech-mx-master-3s.png', alt: 'Logitech MX Master 3S mouse', kicker: 'Mouse', title: 'Logitech MX Master 3S', desc: 'Workflow controls for right-handed desk work. Check hand fit, mass, receiver needs, and software policy.', tags: ['ASIN matched', 'Right-handed'], fix: { href: '/guides/mx-master-3s-scroll-wheel-not-working/', label: 'Scroll wheel not working?' } },
  { href: '/gear/budget-tech/sennheiser-momentum-4-wireless-noise-cancelling-headphones/', img: '', alt: '', kicker: 'Headphones · owned and used', title: 'Sennheiser MOMENTUM 4 Wireless', desc: 'Codec support, adaptive ANC, multipoint behavior, and battery life, with reasons to skip it.', tags: ['Owned and used'], fix: { href: '/guides/sennheiser-momentum-4-wont-pair/', label: 'Won’t pair?' } },
];

const guides = [
  { href: '/guides/usb-c-dock-compatibility/', title: 'USB-C dock compatibility checklist', desc: 'Trace host capability, displays, charging, and bandwidth before counting ports.' },
  { href: '/guides/usb-c-charger-charges-phone-not-laptop/', title: 'Charger works with a phone but not a laptop', desc: 'Check voltage, per-port wattage, and the cable before buying a charger.' },
  { href: '/guides/how-to-tell-if-ssd-is-failing/', title: 'Is your SSD failing?', desc: 'Free health checks before you replace a drive.' },
];
---
<ContentLayout title="Tech gear decision pages: docks, hubs, and more | StackGeist" description="StackGeist gear decision pages for docks, hubs, and accessories tied to our fix guides, with source-checked specifications, fit checks, tradeoffs, and reasons to skip." active="gear">
  <p class="breadcrumbs"><a href="/">StackGeist</a> / Gear</p>
  <p class="page-kicker">Gear decision pages</p>
  <h1 class="page-title">Buy for the problem, not the category.</h1>
  <p class="page-lead">Each product page names an exact model, who it fits, a reason to skip it, and what to check before buying. If something isn’t working, try the matching fix first.</p>

  <section class="content-section">
    <p class="page-kicker">Reviewed products</p>
    <h2 class="section-heading">Products tied to our most-used fixes.</h2>
    <div class="gear-grid">
      {products.map((p) => (
        <article class="gear-card">
          <a class="gear-thumb" href={p.href} tabindex="-1" aria-hidden="true">
            {p.img ? (
              <img src={p.img} alt="" loading="lazy" decoding="async" width="640" height="400" />
            ) : (
              <svg viewBox="0 0 120 80" role="presentation" xmlns="http://www.w3.org/2000/svg"><path d="M30 46 C30 22 90 22 90 46" fill="none" stroke="#3b3846" stroke-width="5" stroke-linecap="round"/><rect x="22" y="42" width="16" height="26" rx="7" fill="#a3e635"/><rect x="82" y="42" width="16" height="26" rx="7" fill="#a3e635"/></svg>
            )}
          </a>
          <div class="gear-body">
            <p class="page-kicker">{p.kicker}</p>
            <h3><a href={p.href}>{p.title}</a></h3>
            <p>{p.desc}</p>
            <div class="card-meta">{p.tags.map((t, i) => <span class:list={['tag', { active: i === 0 }]}>{t}</span>)}</div>
            <a class="gear-fix" href={p.fix.href}>{p.fix.label} Try the fix first →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="content-section">
    <p class="page-kicker">Before you buy</p>
    <h2 class="section-heading">Guides that can save a bad purchase.</h2>
    <div class="cards">
      {guides.map((g) => <a class="card" href={g.href}><h3>{g.title}</h3><p>{g.desc}</p></a>)}
    </div>
  </section>

  <section class="content-section">
    <div class="note">More product pages are added only after the exact model, its specifications, and its compatibility limits have been checked. Paid Amazon links are disclosed next to the retailer action and in the site footer. As an Amazon Associate I earn from qualifying purchases.</div>
  </section>

  <style>
    .gear-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; }
    .gear-card { display:grid; grid-template-rows:auto 1fr; border:1px solid var(--term-border); border-radius:8px; overflow:hidden; background:var(--surface); }
    .gear-thumb { display:grid; place-items:center; height:200px; padding:16px; background:#fff; }
    .gear-thumb:has(svg) { background:var(--term-bg); }
    .gear-thumb img { width:100%; height:100%; object-fit:contain; }
    .gear-thumb svg { width:120px; height:80px; }
    .gear-body { display:flex; flex-direction:column; gap:8px; padding:20px 22px 22px; }
    .gear-body .page-kicker { margin:0; }
    .gear-body h3 { margin:0; font-size:1.2rem; }
    .gear-body h3 a { color:var(--text); }
    .gear-body h3 a:hover { color:var(--phosphor); }
    .gear-body > p:not(.page-kicker) { margin:0; color:var(--read, var(--muted)); font-size:.9688rem; line-height:1.6; }
    .gear-fix { margin-top:auto; padding-top:10px; color:var(--phosphor); font-size:.9375rem; text-decoration:underline; text-underline-offset:3px; }
    @media(max-width:760px){ .gear-grid { grid-template-columns:1fr; } .gear-thumb { height:180px; } }
  </style>
</ContentLayout>
