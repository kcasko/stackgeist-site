>
  <ProductDetailSimple
    eyebrow="Desk power"
    heading="Should the power strip clamp to your desk?"
    intro="The Anker Nano A9196 makes sense when power access and loose cords are the problem. Its clamp is also the main compatibility test: measure the desktop and edge before treating it as a general-purpose power strip."
    productName="Anker Nano Power Strip (10-in-1, 70W, Clamp)"
    imageUrl="https://cdn.shopify.com/s/files/1/0493/9834/9974/files/A9196111_RI_TD01_US_V1.png?v=1776667400&width=1200"
