---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import ProductDetailSimple from '../../../components/ProductDetailSimple.astro';
import { productSchema, faqSchema } from '../../../lib/structured-data';
const __sd = [productSchema({ name: "Adjustable Desk Phone Stand", description: "Propping your phone against random objects gets old fast.", url: 'https://stackgeist.dev/gear/budget-tech/adjustable-desk-phone-stand', image: 'https://m.media-amazon.com/images/I/61o5ncARZXL._AC_SL1500_.jpg' })];
---
<ContentLayout structuredData={__sd} title="Adjustable Desk Phone Stand | StackGeist" description="Propping your phone against random objects gets old fast." active="gear">
  <ProductDetailSimple
    eyebrow="Everyday essentials"
    heading="Adjustable Desk Phone Stand"
    intro="Propping your phone against random objects gets old fast."
    productName="Adjustable Desk Phone Stand"
    imageUrl="https://m.media-amazon.com/images/I/61o5ncARZXL._AC_SL1500_.jpg"
    imageAlt="Adjustable Desk Phone Stand"
    imageSourceLabel="Amazon"
    imageSourceUrl="https://www.amazon.com/dp/B0BM9HW82F?tag=deskrespawn-20"
    productMeta="Amazon ASIN B0BM9HW82F"
    tags={['Budget tech','Everyday essentials']}
    why="Propping your phone against random objects gets old fast."
    tradeoff="This just holds it at a usable angle without sliding around. I use it on my desk for calls, videos, and notifications."
    check="Confirm current price and availability before purchase. Product was imported from a short editorial blurb; specs and compatibility have not been individually re-verified."
    facts="Sourced from taurustech.me/affiliate. See the retailer page for the current spec sheet."
    skip="Skip if you need a verified spec sheet or explicit compatibility guarantee before buying."
    amazonUrl="https://www.amazon.com/dp/B0BM9HW82F?tag=deskrespawn-20"
    makerLabel=""
    makerUrl=""
    backHref="/gear/budget-tech"
    backLabel="Budget tech"
  />
</ContentLayout>
