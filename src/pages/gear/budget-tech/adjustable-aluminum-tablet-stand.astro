---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import ProductDetailSimple from '../../../components/ProductDetailSimple.astro';
import EvidencePanel from '../../../components/EvidencePanel.astro';
import { productSchema, faqSchema } from '../../../lib/structured-data';
const __sd = [productSchema({ name: "Adjustable Aluminum Tablet Stand", description: "Holding a tablet for long periods gets uncomfortable fast.", url: 'https://stackgeist.dev/gear/budget-tech/adjustable-aluminum-tablet-stand', })];
---
<ContentLayout structuredData={__sd} title="Adjustable Aluminum Tablet Stand | StackGeist" description="Holding a tablet for long periods gets uncomfortable fast." active="gear" noindex>
