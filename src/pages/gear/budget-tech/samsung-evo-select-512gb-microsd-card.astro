const __sd = [productSchema({ name: "Samsung EVO Select 512GB microSD Card", description: "Cheap microSD cards are fine until they corrupt or slow everything down.", url: 'https://stackgeist.dev/gear/budget-tech/samsung-evo-select-512gb-microsd-card', image: 'https://m.media-amazon.com/images/I/71VXEYmRrZL._AC_SL1500_.jpg', brand: 'Samsung' })];
