  productSchema({
    name:'Sennheiser MOMENTUM 4 Wireless',
    description:'Sennheiser documents Bluetooth 5.2, SBC/AAC/aptX/aptX Adaptive, hybrid adaptive ANC, a 42 mm dynamic transducer, and up to 60 hours of Bluetooth music playback with ANC under its stated test conditions.',
    url:'https://stackgeist.dev/gear/budget-tech/sennheiser-momentum-4-wireless-noise-cancelling-headphones',
    brand:'Sennheiser'
