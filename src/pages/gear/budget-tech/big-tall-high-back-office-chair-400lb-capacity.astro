---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import ProductDetailSimple from '../../../components/ProductDetailSimple.astro';
import { productSchema, faqSchema } from '../../../lib/structured-data';
const __sd = [productSchema({ name: "Big & Tall High-Back Office Chair (400lb Capacity)", description: "Cheap office chairs fail fast and punish your back even faster.", url: 'https://stackgeist.dev/gear/budget-tech/big-tall-high-back-office-chair-400lb-capacity', image: 'https://m.media-amazon.com/images/I/71uN3EX3ygL._AC_SL1500_.jpg' })];
---
<ContentLayout structuredData={__sd} title="Big & Tall High-Back Office Chair (400lb Capacity) | StackGeist" description="Cheap office chairs fail fast and punish your back even faster." active="gear" noindex>
  <ProductDetailSimple
    eyebrow="Worth paying more for"
    heading="Big & Tall High-Back Office Chair (400lb Capacity)"
    intro="This listing is retained as a research starting point. StackGeist has not yet completed an authoritative specification and compatibility review for this exact product."
    productName="Big & Tall High-Back Office Chair (400lb Capacity)"
    imageUrl="https://m.media-amazon.com/images/I/71uN3EX3ygL._AC_SL1500_.jpg"
    imageAlt="Big & Tall High-Back Office Chair (400lb Capacity)"
    imageSourceLabel="Amazon"
    imageSourceUrl="https://www.amazon.com/dp/B0CBRM6R3X?tag=deskrespawn-20"
    productMeta="Amazon ASIN B0CBRM6R3X"
    tags={['Budget tech','Worth paying more for']}
    why="Technical fit has not yet been source-checked for this exact product."
    tradeoff="No firsthand-use claim or performance recommendation is being made until the evidence review is complete."
    check="Confirm current price and availability before purchase. Product was imported from a short editorial blurb; specs and compatibility have not been individually re-verified."
    facts="Sourced from taurustech.me/affiliate. See the retailer page for the current spec sheet."
    skip="Skip this page as a buying recommendation until the current manufacturer specification and compatibility requirements are checked."
    amazonUrl="https://www.amazon.com/dp/B0CBRM6R3X?tag=deskrespawn-20"
    makerLabel=""
    makerUrl=""
    backHref="/gear/budget-tech"
    backLabel="Budget tech"
  />

  <section class="content-section related-reading"><p class="page-kicker">Troubleshooting</p><div class="cards"><a class="card" href="/guides/office-chair-gas-cylinder-replacement"><h3>Chair sinking?</h3><p>Cylinder replacement, no magic.</p></a></div></section>
</ContentLayout>
