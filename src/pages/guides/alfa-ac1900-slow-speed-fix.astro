  articleSchema({
    headline: "ALFA AC1900 slow speed: USB 3.0, drivers, and 5 GHz fixes.",
    description: "A slow ALFA AWUS1900 Wi-Fi adapter is almost always plugged into a USB 2.0 port, using the wrong driver, or competing with the onboard adapter. Diagnose the USB port, driver, and radio settings before assuming the adapter is broken.",
    url: 'https://stackgeist.dev/guides/alfa-ac1900-slow-speed-fix',
    dateModified: '2026-09-11'
  }),
  howToSchema({
    name: "Fix a slow ALFA AC1900 Wi-Fi adapter",
    description: "Diagnose USB bandwidth limits, driver issues, and radio settings: verify the adapter is in a USB 3.0 port, install the correct Realtek RTL8814AU driver, disable the onboard adapter, select 5 GHz band, orient antennas vertically, and rule out interference.",
    steps: [
      { name: "Confirm the adapter is in a USB 3.0 port", text: "USB 2.0 has a 480 Mbps ceiling that limits Wi-Fi speed. USB 3.0 ports are usually blue inside and labeled 'SS' or with a USB trident logo. Move the adapter to a USB 3.0 port or powered USB 3.0 hub." },
      { name: "Install the correct Realtek RTL8814AU driver for your OS", text: "The ALFA AWUS1900 uses the Realtek RTL8814AU chipset. Windows requires the vendor driver. Linux requires the Realtek or Aircrack-ng RTL8814AU driver built for your kernel. A wrong driver caps speed or disables 5 GHz entirely." },
      { name: "Disable the onboard Wi-Fi adapter", text: "Windows and Linux prefer the onboard adapter over an external USB one. Disable the onboard adapter in Device Manager or NetworkManager to force the OS to use the ALFA exclusively." },
      { name: "Connect to the 5 GHz band, not 2.4 GHz", text: "The 2.4 GHz band is slower and more congested. The ALFA AC1900 supports dual-band 802.11ac. Use the 5 GHz SSID or configure your router to steer the adapter to 5 GHz." },
      { name: "Orient the antennas vertically and aim them at the router", text: "Wi-Fi antennas are polarized. A horizontal antenna receiving a vertical signal loses 10-20 dB. Point the ALFA's antennas vertically and toward the router for maximum gain." },
      { name: "Rule out distance, interference, and power limits on Linux", text: "Check signal strength, nearby 5 GHz networks, and the regulatory domain. On Linux, 'iw reg set US' or your country code may increase transmit power. A powered USB hub can fix undervoltage." }
