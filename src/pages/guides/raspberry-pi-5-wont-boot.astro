import { articleSchema, howToSchema, faqSchema } from '../../lib/structured-data';
const __sd = [
  articleSchema({
    headline: "Raspberry Pi 5 won't boot: the real fix.",
    description: "A Raspberry Pi 5 that powers on but won't boot is almost always an undervolted USB-C power supply, a corrupt SD card, or the HDMI cable in the wrong port — not a dead board. Diagnose the LED pattern first.",
    url: 'https://stackgeist.dev/guides/raspberry-pi-5-wont-boot',
    dateModified: '2026-09-11'
  }),
  howToSchema({
    name: "Fix a Raspberry Pi 5 that won't boot",
    description: "Diagnose in LED order: red-only means the SD card cannot boot, red and green blinking signals specific errors, then verify the official 27W USB-C PSU for 5V/5A negotiation, use Raspberry Pi Imager to reflash the SD card, confirm HDMI is in HDMI0, and check boot order for NVMe HATs.",
    steps: [
      { name: "Use the official Raspberry Pi 27W USB-C PSU", text: "Raspberry Pi 5 requires 5V at 5A, which most third-party USB-C chargers cannot deliver. A generic 65W laptop charger delivers 5V/3A, triggers undervolt throttling, and often fails to boot at all." },
      { name: "Decode the LED pattern", text: "Red-only LED means powered but not booting — the SD card is the problem. Red and green blinking in a specific pattern indicates a boot error code. Continuous green means the Pi booted successfully." },
      { name: "Reflash the SD card with Raspberry Pi Imager", text: "Download Raspberry Pi Imager from the official site, select Raspberry Pi OS, choose the SD card, and write. Use an A2-rated card for Pi 5 speed. A worn-out or counterfeit SD card will not boot reliably." },
      { name: "Plug the HDMI cable into HDMI0", text: "Raspberry Pi 5 has two micro HDMI ports. HDMI0 is the one nearest the USB-C power port. The Pi outputs to HDMI0 by default and ignores HDMI1 unless configured in config.txt." },
      { name: "Check NVMe HAT boot order in raspi-config", text: "If an NVMe HAT is installed, the Pi may try to boot from it and fail silently if no bootloader is installed on the SSD. Boot from SD first, run sudo raspi-config, and set boot order." },
      { name: "Inspect stacked HATs for unpopulated headers", text: "Stacked HATs sometimes ship with unpopulated GPIO headers or jumpers that must be set before power is delivered correctly. Check the HAT's assembly guide before assuming the Pi is dead." }
    ]
  }),
  faqSchema({
    questions: [
      { question: "Why won't my Raspberry Pi 5 boot with a 65W USB-C laptop charger?", answer: "Most third-party USB-C chargers deliver 5V at 3A maximum, not the 5V at 5A the Pi 5 requires. The Pi will power on, light the red LED, then fail to boot or throttle the CPU and refuse to start the GPU. Use the official Raspberry Pi 27W USB-C power supply or a charger verified to deliver 5V/5A on the USB-PD profile." },
      { question: "What does a solid red LED with no green LED mean?", answer: "Red-only means the board is receiving power but cannot read a bootable image from the SD card. The card is missing, corrupt, improperly flashed, or worn out. Reflash the card with Raspberry Pi Imager or try a different known-good SD card." },
      { question: "Can I boot a Raspberry Pi 5 without an SD card?", answer: "Yes, if you have flashed the onboard EEPROM to boot from USB or NVMe. Out of the box, the Pi 5 requires an SD card or an NVMe HAT with a bootloader installed on the SSD. Use an SD card first to configure alternative boot modes via raspi-config." },
      { question: "Why does my HDMI monitor show no signal from the Pi?", answer: "Confirm the HDMI cable is plugged into HDMI0, the port closest to the USB-C power connector. The Pi outputs to HDMI0 by default. Also try a different HDMI cable — some cheap cables are HDMI 1.4 and will not carry 4K at 60 Hz, causing handshake failures with newer monitors." }
    ]
  })
];
