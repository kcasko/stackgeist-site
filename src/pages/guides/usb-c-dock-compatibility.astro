const __sd = [articleSchema({ headline: "A USB-C connector is a shape, not a promise.", description: "Choose a dock from the laptop outward: host port, display support, power, bandwidth, then sockets. Reversing that order is how an impressive port list becomes an expensive compatibility problem.", url: 'https://stackgeist.dev/guides/usb-c-dock-compatibility', dateModified: '2026-09-04' })];
