---
import ContentLayout from '../../layouts/ContentLayout.astro';

const topFixes = [
  { slug: 'sennheiser-momentum-4-wont-pair', title: 'Sennheiser Momentum 4 not pairing', desc: 'Correct pairing slide, multipoint limits, and a clean reset sequence.' },
  { slug: 'usb-c-dock-only-one-monitor', title: 'USB-C dock only detecting one monitor', desc: 'Start here when one external display works and the second does not.' },
  { slug: 'microsd-card-not-detected', title: 'microSD card not detected', desc: 'Reader, Disk Management, write protection, and failure checks.' },
  { slug: 'gan-charger-not-charging-laptop-full-speed', title: 'GaN charger not charging laptop full speed', desc: 'Find USB PD and shared-port wattage limits.' },
];

const groups = [
  {
    id: 'usb-c-displays',
    title: 'USB-C, docks, and displays',
    hub: 'usb-c-charging-display-problems',
    guides: [
      { slug: 'usb-c-dock-only-one-monitor', title: 'USB-C dock only detecting one monitor', desc: 'Host port limits, MST vs DisplayLink vs Thunderbolt, and cables.' },
      { slug: 'usb-c-dock-second-monitor-stops-working', title: 'USB-C dock fails with a second monitor', desc: 'Use a one-monitor baseline to find stream, bandwidth, or host limits.' },
      { slug: 'portable-usb-c-monitor-no-signal', title: 'Portable USB-C monitor showing no signal', desc: 'DisplayPort Alt Mode, cables, and hub passthrough checks.' },
      { slug: 'usb-c-hub-ethernet-works-hdmi-doesnt', title: 'USB-C hub Ethernet works but HDMI does not', desc: 'USB data can work while the display path fails.' },
      { slug: 'how-to-tell-if-usb-c-port-supports-video', title: 'Does this USB-C port support video?', desc: 'Confirm it from the exact host spec instead of the connector shape.' },
      { slug: 'usb-c-dock-compatibility', title: 'USB-C dock compatibility checklist', desc: 'Trace host capability, displays, charging, and bandwidth before buying.' },
      { slug: 'usb-c-cable-buying-guide', title: 'USB-C cable buying guide', desc: 'What wattage and USB or Thunderbolt labels actually mean.' },
    ],
  },
  {
    id: 'charging-power',
    title: 'Charging and power',
    hub: 'desk-power-safety-problems',
    guides: [
      { slug: 'usb-c-cable-charging-slow', title: 'USB-C cable charging slow', desc: 'Separate cable rating, charger output, and device limits.' },
      { slug: 'gan-charger-not-charging-laptop-full-speed', title: 'GaN charger not charging laptop full speed', desc: 'Power negotiation and multi-port wattage sharing.' },
      { slug: 'usb-c-charger-charges-phone-not-laptop', title: 'USB-C charger charges phone but not laptop', desc: 'Missing 20V output, per-port wattage, and cable rating.' },
      { slug: 'laptop-not-charging-through-usb-c-dock', title: 'Laptop not charging through a USB-C dock', desc: 'Host charging wattage, brand limits, and firmware.' },
      { slug: 'laptop-says-slow-charger-with-100w-usb-c-charger', title: '100W USB-C charger but Windows says slow charger', desc: 'Per-port output, cable rating, port choice, and dock losses.' },
      { slug: 'laptop-charger-wattage', title: 'How many watts does my laptop charger need?', desc: 'Match rated input and plan headroom for docks.' },
      { slug: 'surge-protector-clicking', title: 'Surge protector clicking', desc: 'When to keep using it and when to replace it.' },
      { slug: 'extension-cord-getting-hot', title: 'Extension cord getting hot', desc: 'When to stop using it, and how to find the cause.' },
      { slug: 'extension-cord-safety-guide', title: 'Extension cord safety', desc: 'Desk load, amp rating, gauge, and where surge protectors fit.' },
    ],
  },
  {
    id: 'storage-boot',
    title: 'Storage, recovery, and backup',
    hub: 'storage-raspberry-pi-boot-fixes',
    guides: [
      { slug: 'microsd-card-not-detected', title: 'microSD card not detected', desc: 'Reader swap, drive letters, read-only state, and end-of-life signs.' },
      { slug: 'external-drive-shows-in-disk-management-not-file-explorer', title: 'Drive in Disk Management but not File Explorer', desc: 'Safe checks before you initialize or format anything.' },
      { slug: 'wd-elements-not-showing-up', title: 'WD Elements not showing up', desc: 'Cable, power, Disk Management, and drive health triage.' },
      { slug: 'external-ssd-not-showing-up-windows-11', title: 'External SSD not showing up in Windows 11', desc: 'New drives, missing letters, Mac formats, and data cables.' },
      { slug: 'external-drive-says-you-need-to-format-it', title: 'Drive says “You need to format the disk”', desc: 'Save your files before you click Format.' },
      { slug: 'recover-deleted-photos-from-sd-card', title: 'Recover deleted photos from an SD card', desc: 'Free and paid recovery tools, step by step.' },
      { slug: 'how-to-tell-if-ssd-is-failing', title: 'How to tell if your SSD is failing', desc: 'Symptoms and free health checks in Windows.' },
      { slug: 'back-up-windows-pc-before-replacing-drive', title: 'Back up before replacing a drive', desc: 'BitLocker key, files, settings, and cloning.' },
      { slug: 'raspberry-pi-5-wont-boot', title: 'Raspberry Pi 5 won’t boot', desc: 'Power, boot media, LED patterns, and HDMI checks.' },
    ],
  },
  {
    id: 'wireless-peripherals',
    title: 'Bluetooth, Wi-Fi, and peripherals',
    hub: 'wireless-bluetooth-smart-home-fixes',
    guides: [
      { slug: 'sennheiser-momentum-4-wont-pair', title: 'Sennheiser Momentum 4 not pairing', desc: 'Pairing slide, multipoint limits, and reset sequence.' },
      { slug: 'keychron-v6-max-bluetooth-not-connecting', title: 'Keychron V6 Max Bluetooth not connecting', desc: 'Mode switch, profile keys, pairing, and reset.' },
      { slug: 'alfa-ac1900-slow-speed-fix', title: 'ALFA AC1900 slow speed fix', desc: 'Driver, USB port, band selection, and antenna checks.' },
      { slug: 'mx-master-3s-scroll-wheel-not-working', title: 'MX Master 3S scroll wheel not working', desc: 'SmartShift, firmware, debris, and hardware triage.' },
      { slug: 'logitech-brio-not-detected-windows-11', title: 'Logitech Brio not detected on Windows 11', desc: 'Camera privacy, USB port, driver, and cable checks.' },
      { slug: 'govee-strip-lights-not-connecting-wifi', title: 'Govee lights not connecting to Wi-Fi', desc: '2.4 GHz, permissions, mesh steering, and pairing fixes.' },
    ],
  },
  {
    id: 'home-office-hardware',
    title: 'Home office hardware',
    hub: 'home-office-peripheral-fixes',
    guides: [
      { slug: 'monitor-arm-sagging-fix', title: 'Monitor arm sagging', desc: 'Capacity, tension, VESA, and clamp checks.' },
      { slug: 'benq-screenbar-flickering', title: 'BenQ ScreenBar flickering', desc: 'Model and power checks before you replace it.' },
      { slug: 'office-chair-gas-cylinder-replacement', title: 'Office chair sinking', desc: 'Gas cylinder or control mechanism?' },
    ],
  },
];

const deskGuides = [
  { slug: 'cable-management', title: 'Cable management' },
  { slug: 'desk-layout-basics', title: 'Desk layout basics' },
  { slug: 'cheap-desk-upgrades', title: 'Cheap desk upgrades' },
  { slug: 'keyboard-mouse-fit', title: 'Keyboard and mouse fit' },
  { slug: 'better-video-calls', title: 'Better video calls' },
];
---
<ContentLayout title="PC, USB-C, and storage troubleshooting guides | StackGeist" description="Step-by-step fixes for USB-C docks and displays, charging, storage, Raspberry Pi boot problems, Bluetooth, and peripherals, tied to manufacturer sources." active="guides">
  <p class="breadcrumbs"><a href="/">StackGeist</a> / Fixes</p>
  <p class="page-kicker">Fixes</p>
  <h1 class="page-title">Find the fix before you replace the hardware.</h1>
  <p class="page-lead">Pick the problem closest to yours. Each guide starts with a short answer, then works through the checks in order.</p>

  <nav class="fix-jump" aria-label="Jump to a problem area">
    {groups.map((group) => <a href={`#${group.id}`}>{group.title}</a>)}
  </nav>

  <section class="content-section">
    <p class="page-kicker">Start here</p>
    <h2>Common fixes</h2>
    <div class="cards">
      {topFixes.map((guide) => (
        <a class="card" href={`/guides/${guide.slug}/`}><h3>{guide.title}</h3><p>{guide.desc}</p></a>
      ))}
    </div>
  </section>

  {groups.map((group) => (
    <section class="content-section" id={group.id}>
      <h2>{group.title}</h2>
      {group.hub && <p><a href={`/guides/${group.hub}/`}>Not sure which one? Start with the overview →</a></p>}
      <div class="cards">
        {group.guides.map((guide) => (
          <a class="card" href={`/guides/${guide.slug}/`}><h3>{guide.title}</h3><p>{guide.desc}</p></a>
        ))}
      </div>
    </section>
  ))}

  <section class="content-section">
    <p class="page-kicker">Building skills too?</p>
    <div class="cards">
      <a class="card" href="/labs/"><h3>IT home labs</h3><p>Practice support and systems work on documented labs.</p></a>
      <a class="card" href="/certs/"><h3>IT certifications</h3><p>Compare A+, Network+, Security+, and AWS Cloud Practitioner.</p></a>
    </div>
  </section>

  <section class="content-section">
    <h2>Desk setup guides</h2>
    <ul class="desk-guides">
      {deskGuides.map((guide) => <li><a href={`/guides/${guide.slug}/`}>{guide.title}</a></li>)}
    </ul>
  </section>

  <style>
    .fix-jump { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }
    .fix-jump a { padding:8px 12px; border:1px solid var(--term-border-strong); font-size:12.5px; }
    .desk-guides { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:8px 24px; padding:0; list-style:none; }
    .desk-guides a { display:inline-block; padding:4px 0; }
  </style>
</ContentLayout>
