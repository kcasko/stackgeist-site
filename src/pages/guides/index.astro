---
import ContentLayout from '../../layouts/ContentLayout.astro';
import FixFlow from '../../components/illustrations/FixFlow.astro';
import { CATALOG } from '../../data/catalog';
import { SECTIONS, TOPIC_LABEL, entries, formatDate } from '../../data/sections';

const start = entries([
  '/guides/usb-c-dock-only-one-monitor/',
  '/guides/external-drive-shows-in-disk-management-not-file-explorer/',
  '/guides/gan-charger-not-charging-laptop-full-speed/',
  '/guides/sennheiser-momentum-4-wont-pair/',
]);
const topics = Object.entries(TOPIC_LABEL).map(([topic, label]) => ({
  topic,
  label,
  hub: CATALOG.find((e) => e.type === 'topic' && e.topic === topic),
  fixes: CATALOG.filter((e) => e.section === 'fixes' && e.type === 'troubleshooting' && e.topic === topic),
}));
const total = topics.reduce((n, t) => n + t.fixes.length, 0);
const buying = CATALOG.filter((e) => e.type === 'buying-guide');
---
<ContentLayout section="fixes" title="PC, USB-C, and storage troubleshooting guides | StackGeist" description="Step-by-step fixes for USB-C docks and displays, charging, storage, Raspberry Pi boot problems, Bluetooth, and peripherals, tied to manufacturer sources.">
  <header class="front-head">
    <p><span class="slab">Fixes</span> <span class="kicker">{total} troubleshooting guides</span></p>
    <h1 class="page-title">Find the fix before you replace the hardware.</h1>
    <p class="page-lead">{SECTIONS.fixes.blurb} Pick the problem closest to yours: each guide opens with a short answer, then works through the checks in order.</p>
  </header>

  <nav class="topic-jump" aria-label="Jump to a problem area">
    {topics.map((t) => <a href={`#${t.topic}`}><span>{t.label}</span><b>{t.fixes.length}</b></a>)}
  </nav>

  <section class="start" aria-labelledby="start-title">
    <h2 id="start-title" class="block-label">Start here</h2>
    <ol>
      {start.map((e, i) => (
        <li>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <div><span class="kicker">{TOPIC_LABEL[e.topic]}</span><a href={e.href}>{e.title}</a><p>{e.dek}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <FixFlow />

  {topics.map((t) => (
    <section class="topic-block" id={t.topic} aria-labelledby={`${t.topic}-title`}>
      <header>
        <h2 id={`${t.topic}-title`}>{t.label}</h2>
        {t.hub && <a class="hub-link" href={t.hub.href}>Not sure which? Start with the overview</a>}
      </header>
      <ul class="fix-rows">
        {t.fixes.map((e) => (
          <li>
            <a href={e.href}>{e.title}</a>
            <p>{e.dek}</p>
            {e.updated && <time datetime={e.updated}>{formatDate(e.updated)}</time>}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <section class="also" aria-labelledby="also-title">
    <h2 id="also-title" class="block-label">Buying after all?</h2>
    <p>When the diagnosis says the hardware really is the limit, these check compatibility before you spend: {buying.map((e, i) => <>{i > 0 && ' · '}<a href={e.href}>{e.title}</a></>)}. Product notes are in <a href="/gear/">Gear</a>.</p>
  </section>
</ContentLayout>

<style>
.front-head > p:first-child { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0 0 var(--space-3); }
.front-head .kicker { margin: 0; }
.topic-jump { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; margin-top: var(--space-6); }
.topic-jump a { display: flex; justify-content: space-between; align-items: end; gap: var(--space-2); min-height: 64px; padding: var(--space-2) var(--space-3); background: var(--surface); border-top: 5px solid var(--dept); color: var(--ink); font: 800 1rem/1.15 var(--font-sans); font-stretch: 85%; text-decoration: none; }
.topic-jump a:hover { background: var(--geist); color: #121212; }
.topic-jump b { color: var(--dept-ink); font: 900 1.7rem/1 var(--font-sans); font-stretch: var(--condensed); }
.topic-jump a:hover b { color: #121212; }

.block-label { margin: 0 0 var(--space-3); font: 900 1.4rem/1 var(--font-sans); font-stretch: var(--condensed); text-transform: uppercase; }
.start { margin-top: var(--space-7); padding: var(--space-5); background: var(--plate); color: var(--plate-ink); --link: var(--plate-ink); }
.start .block-label { color: #fff; }
.start ol { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-5); margin: 0; padding: 0; list-style: none; }
.start li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); padding-top: var(--space-3); border-top: 3px solid var(--dept); }
.start .num { color: var(--dept); font: 900 2.6rem/.85 var(--font-sans); font-stretch: var(--condensed); }
.start .kicker { display: block; margin-bottom: 4px; color: #a9a8a1; }
.start a { color: #fff; font: 800 1.1rem/1.15 var(--font-sans); font-stretch: 88%; text-decoration: none; }
.start a:hover { background: var(--geist); color: #121212; }
.start p { margin: 6px 0 0; color: #c9c8c2; font-size: .9rem; line-height: 1.45; }
.start :focus-visible { box-shadow: 0 0 0 5px #fff; }

.topic-block { margin-top: var(--space-8); scroll-margin-top: var(--space-4); }
.topic-block > header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-2) var(--space-5); padding-top: var(--space-3); border-top: 8px solid var(--dept); }
.topic-block h2 { margin: 0; font: 900 clamp(1.8rem, 3.6vw, 2.6rem)/1 var(--font-sans); font-stretch: var(--condensed); text-transform: uppercase; }
.hub-link { font-weight: 700; }
.fix-rows { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-6); margin: var(--space-4) 0 0; padding: 0; list-style: none; }
.fix-rows li { display: grid; grid-template-columns: 1fr auto; gap: 2px var(--space-3); padding: var(--space-3) 0; border-top: 1px solid var(--rule); }
.fix-rows a { font: 800 1.12rem/1.2 var(--font-sans); font-stretch: 88%; text-decoration: none; }
.fix-rows a:hover { text-decoration: underline; }
.fix-rows p { grid-column: 1 / -1; margin: 0; color: var(--ink-2); font-size: .94rem; line-height: 1.45; }
.fix-rows time { grid-column: 2; grid-row: 1; color: var(--ink-3); font-size: .78rem; white-space: nowrap; }

.also { margin-top: var(--space-8); padding: var(--space-4) var(--space-5); border: 2px solid var(--ink); background: var(--surface); }
.also p { max-width: var(--measure); margin: 0; color: var(--ink-2); }

@media (max-width: 1060px) {
  .topic-jump { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .start ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 700px) {
  .topic-jump { grid-template-columns: 1fr 1fr; }
  .topic-jump a:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .start { margin-left: calc(var(--page-pad) * -1); margin-right: calc(var(--page-pad) * -1); padding: var(--space-5) var(--page-pad); }
  .start ol, .fix-rows { grid-template-columns: 1fr; }
}
</style>
