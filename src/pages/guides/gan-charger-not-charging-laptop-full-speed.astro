  howToSchema({
    name: "Fix a GaN charger not charging at full speed",
    description: "Diagnose the USB-C power path: verify the charger's per-port output table, confirm the cable rating, test with one load, compare the laptop's documented USB-C input, bypass docks, inspect the port, and rule out thermal protection.",
    steps: [
      { name: "Check the per-port wattage table, not the total rating", text: "Multi-port chargers can redistribute output when more than one port is active. A charger advertised at 100W may provide less to the laptop port in a multi-device configuration." },
      { name: "Confirm the cable supports the wattage you expect", text: "A USB-C cable rated for 60W will refuse to carry more than 3A regardless of the charger's capability. Use the cable that came with the charger or a rated 100W or 240W USB-C to USB-C cable." },
      { name: "Test with one port active and nothing else plugged in", text: "Unplug every other device from the charger and use only the highest-wattage port listed on the label. If speed jumps, the charger was sharing power across ports." },
      { name: "Verify the laptop does not require proprietary charging", text: "Some laptops support USB-C charging only up to a model-specific limit while their original proprietary adapter can provide more power. Check the exact model's USB-C Power Delivery specification before blaming the charger." },
