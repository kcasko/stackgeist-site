  howToSchema({
    name: "Fix a GaN charger not charging at full speed",
    description: "Diagnose USB-PD negotiation failures: verify the charger's per-port wattage table, confirm the cable rating and e-marker, test a single-port load, check for proprietary charging protocols the laptop requires, clean the USB-C port, and rule out thermal throttle.",
