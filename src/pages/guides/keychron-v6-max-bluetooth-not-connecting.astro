  articleSchema({
    headline: "Keychron V6 Max Bluetooth not connecting: the real fix.",
    description: "A Keychron V6 Max that will not connect via Bluetooth is usually the physical mode switch on the wrong setting, the wrong Bluetooth profile selected, a stale device cache on the host, or a low battery cutoff — not a broken radio.",
    url: 'https://stackgeist.dev/guides/keychron-v6-max-bluetooth-not-connecting',
    dateModified: '2026-09-11'
  }),
  howToSchema({
    name: "Fix a Keychron V6 Max that will not connect via Bluetooth",
    description: "Check the physical mode switch on the back of the keyboard, select the correct Bluetooth profile with Fn+1/2/3/4, long-press to enter pairing mode, remove stale pairings on the host, factory reset the keyboard, and rule out low battery cutoff.",
    steps: [
      { name: "Check the physical mode switch on the back", text: "The Keychron V6 Max has a three-position switch on the back edge: Cable, BT (Bluetooth), and 2.4G (for the wireless dongle). Slide it to BT for Bluetooth mode." },
      { name: "Select a Bluetooth profile with Fn+1/2/3/4", text: "The keyboard stores up to four Bluetooth pairings. Press Fn+1, Fn+2, Fn+3, or Fn+4 to select a profile. Long-press the same combination for about four seconds to enter pairing mode on that profile." },
      { name: "Remove old pairings on the host and re-pair", text: "Windows 11: Settings > Bluetooth & devices > Devices. Remove 'Keychron V6 Max' if listed. macOS: System Settings > Bluetooth, click the i next to the keyboard, and choose 'Forget This Device'. Then re-pair." },
      { name: "Re-pair the 2.4GHz dongle if using wireless mode", text: "Plug the dongle into a USB port, slide the keyboard's mode switch to 2.4G, then press and hold Fn+R for four seconds. The keyboard will re-pair with the dongle. This does not affect Bluetooth profiles." },
      { name: "Factory reset the keyboard", text: "Press and hold Fn+J+Z for four seconds. All LEDs will flash. This clears all Bluetooth pairings and settings. Slide the mode switch to BT and re-pair from scratch." },
      { name: "Charge the battery fully", text: "Low battery triggers a cutoff that disables wireless modes before the keyboard shuts down entirely. Charge via USB-C for at least an hour, or check the battery indicator LED. A battery below 10 percent can cause pairing to fail silently." }
    ]
  }),
  faqSchema({
    questions: [
      { question: "How do I know which Bluetooth profile is selected?", answer: "The Keychron V6 Max shows the active profile via LED indicators when you press Fn+1, Fn+2, Fn+3, or Fn+4. The number key's LED will light up or flash to indicate the profile. Check the manual for the exact LED pattern." },
      { question: "Why does my keyboard work wired but not Bluetooth?", answer: "Check the physical mode switch on the back. It must be set to BT, not Cable or 2.4G. If the switch is correct, the Bluetooth radio may need a factory reset (Fn+J+Z held for four seconds) to clear corrupted pairing state." },
      { question: "Will a factory reset delete my custom key mappings?", answer: "Yes. A factory reset clears all settings, including custom key mappings saved via VIA or the Keychron Launcher software. Export your layout before resetting if you have custom mappings." },
      { question: "Why does macOS take so long to connect after sleep?", answer: "macOS wake-from-sleep Bluetooth delays are common with many keyboards, including the Keychron V6 Max. Some builds of macOS cache Bluetooth device state aggressively. This is not a keyboard fault. Forgetting and re-pairing the device sometimes helps, but the delay can return after OS updates.[1]" }
