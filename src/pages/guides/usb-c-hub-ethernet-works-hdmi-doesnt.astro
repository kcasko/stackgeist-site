    dateModified: '2026-10-01'
  }),
  howToSchema({
    name: "Fix a USB-C hub where Ethernet works but HDMI does not",
    description: "Confirm the host port supports display output, test the display directly, check the hub upstream cable, test the HDMI path separately, and identify whether the hub uses native Alt Mode or another display technology.",
    steps: [
      { name: "Confirm the USB-C port supports video", text: "Working Ethernet only proves USB data works. Read the host specification for DisplayPort Alt Mode, USB4, or Thunderbolt." },
