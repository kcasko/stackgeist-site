const __sd = [
  articleSchema({
    headline: "WD Elements not showing up: the real fix.",
    description: "A WD Elements drive that spins up but won't appear is almost always an undervolted USB port, a failing cable, or a missing drive letter — not a dead drive. Diagnose the power path first.",
    url: 'https://stackgeist.dev/guides/wd-elements-not-showing-up',
    dateModified: '2026-09-11'
  }),
  howToSchema({
    name: "Fix a WD Elements drive that won't show up",
    description: "Diagnose in power order: use a rear motherboard USB port, skip unpowered hubs, swap the USB cable for a rated one, check Disk Management for an unassigned drive letter, uninstall and rescan in Device Manager, run a WD Drive Utilities SMART self-test, and recognize when a clicking drive needs immediate backup.",
    steps: [
      { name: "Use a rear motherboard USB port", text: "Front panel USB ports share power with other devices and deliver inconsistent voltage. A 2.5-inch portable hard drive draws up to 500mA and will fail to spin up or enumerate on an undervolted port." },
      { name: "Skip unpowered USB hubs entirely", text: "Unpowered hubs split one USB port's 500mA budget across every connected device. A WD Elements drive requires the full 500mA and will not work through a hub unless the hub has its own power adapter." },
      { name: "Swap the USB cable", text: "WD Elements drives ship with a USB-A to Micro-B cable. Many third-party cables carry data but undervolt or drop the connection under load. Use the cable that came with the drive or buy a rated USB 3.0 cable." },
      { name: "Check Disk Management for an unassigned drive letter", text: "The drive may spin up and enumerate but have no assigned drive letter. Open Disk Management, find the WD drive by capacity, and assign a letter. If it shows as a foreign disk, import it." },
      { name: "Uninstall the drive in Device Manager and rescan", text: "Windows can cache a stale driver or enumeration state. Uninstall the WD drive under Disk Drives in Device Manager, then scan for hardware changes to force re-detection." },
      { name: "Run a WD Drive Utilities SMART self-test", text: "Download WD Drive Utilities, connect the drive, and run a SMART test. If it reports 'Failing' or relocated sectors above 10, the drive is dying and should be replaced immediately." }
    ]
  }),
  faqSchema({
    questions: [
      { question: "Why does my WD Elements drive work on one computer but not another?", answer: "The working computer likely has a better-powered USB port or uses the original cable. The failing computer may have front-panel USB ports with shared power, an unpowered hub in the path, or a BIOS USB power setting that limits current to 100mA. Try a rear motherboard port and the original cable." },
      { question: "Can I use a WD Elements drive through a USB hub?", answer: "Only if the hub has its own power adapter. Unpowered hubs split the upstream port's 500mA across every connected device. A 2.5-inch portable drive requires the full 500mA and will spin down or disconnect when other devices are active." },
      { question: "What does a clicking WD Elements drive mean?", answer: "A repetitive clicking sound is the drive's read/write head parking or failing to seek correctly. This is a mechanical failure. The drive is dying. Stop using it immediately, connect it to a working port, copy all files, and replace the drive. Clicking drives fail completely without warning." },
      { question: "How do I import a foreign disk in Windows Disk Management?", answer: "A foreign disk is a drive that was formatted on another Windows installation or moved from another computer. Open Disk Management, right-click the foreign disk, and select 'Import Foreign Disks'. Windows will read the existing partitions and assign drive letters." }
    ]
  })
