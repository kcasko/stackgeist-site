import { articleSchema, howToSchema, faqSchema } from '../../lib/structured-data';
const __sd = [
  articleSchema({
    headline: "Why your USB-C cable is charging slow (and how to tell).",
    description: "Slow USB-C charging is almost always the cable, the charger, or the device negotiating a lower power profile — not a broken laptop. Diagnose which side is limiting the wattage before you replace anything.",
    url: 'https://stackgeist.dev/guides/usb-c-cable-charging-slow',
    dateModified: '2026-09-11'
  }),
  howToSchema({
    name: "Diagnose a slow-charging USB-C cable",
    description: "Isolate whether the cable, charger, or device is limiting wattage. Check the cable's rated wattage and e-marker, swap in a known 100W+ cable, verify the charger's per-port output, confirm the device's own charging limit, and rule out heat throttling.",
    steps: [
      { name: "Check the cable's rated wattage", text: "USB-C cables come in 60W (no e-marker), 100W, and 240W ratings. A 60W cable will refuse to carry more than 3A regardless of what the charger can deliver." },
      { name: "Confirm the cable has an e-marker chip", text: "Any USB-C cable rated above 60W or supporting USB 3.x data must contain an e-marker chip that reports its capability. Unbranded cheap cables often lie or omit it entirely." },
      { name: "Test with a known full-featured cable", text: "Swap in a cable you trust — a rated 100W or 240W USB-C to USB-C. If speed jumps, the original cable was the limit." },
      { name: "Verify the charger's per-port output", text: "Multi-port GaN chargers split total wattage across active ports. A '100W' charger may deliver only 45W when a second device is plugged in." },
      { name: "Check the device's own maximum draw", text: "A MacBook Air M2 accepts 30W max. A gaming laptop may want 180W. A phone typically caps at 20-30W. Charging above the device's ceiling is impossible even with the right cable." },
      { name: "Rule out heat and dirty ports", text: "Chargers throttle when hot. USB-C ports collect lint that blocks full contact. Let the charger cool, and clean the port with a wooden toothpick before assuming failure." }
    ]
  }),
  faqSchema({
    questions: [
      { question: "How do I know if my USB-C cable is rated for 100W?", answer: "Look for '100W', '5A', or 'USB-PD 3.0' printed on the cable or its packaging. A rated cable also feels noticeably thicker than a 60W cable because it contains larger conductors and an e-marker chip." },
      { question: "Will a 240W cable charge my laptop faster than a 100W cable?", answer: "Only if the laptop and charger both support more than 100W. A 240W-rated cable is required for the new USB-PD 3.1 EPR profile above 100W. Below that ceiling, a 100W cable delivers identical speed." },
      { question: "Why does my laptop charge slowly when other devices are plugged into the same charger?", answer: "Multi-port GaN chargers share a total wattage budget across ports. Plugging a phone into a second port of a 100W charger can drop the laptop port to 45W or 65W depending on the model." },
      { question: "Can a bad USB-C cable damage my laptop?", answer: "A properly manufactured USB-C cable cannot deliver more power than the charger and device negotiate. The risk is uncertified counterfeit cables missing the e-marker or with wrong resistor values, which can confuse the negotiation and in rare cases push wrong voltage. Buy from a brand you can look up." }
    ]
  })
];
