const __sd = [
  articleSchema({
    headline: "Why your USB-C cable is charging slow (and how to tell).",
    description: "Slow USB-C charging is commonly caused by the charger, cable, port, dock, or device negotiating less power than expected. Diagnose which side is limiting the wattage before you replace anything.",
    url: 'https://stackgeist.dev/guides/usb-c-cable-charging-slow',
    dateModified: '2026-10-01'
  }),
  howToSchema({
    name: "Diagnose a slow-charging USB-C cable",
    description: "Isolate whether the cable, charger, or device is limiting wattage. Check the cable's rated wattage and e-marker, swap in a known 100W+ cable, verify the charger's per-port output, confirm the device's own charging limit, and rule out heat throttling.",
    steps: [
      { name: "Check the cable's rated wattage", text: "For USB-C to USB-C power, 3A cables are limited to 60W at 20V, while 5A operation requires an electronically marked cable. Current USB-IF branding uses 60W or 240W power markings on certified USB-C to USB-C cables." },
      { name: "Confirm the cable has an e-marker chip", text: "Power above 60W requires a 5A electronically marked USB-C cable. High-speed data capability is a separate property, so do not infer wattage from data speed or data speed from wattage." },
      { name: "Test with a known full-featured cable", text: "Swap in a cable you trust — a rated 100W or 240W USB-C to USB-C. If speed jumps, the original cable was the limit." },
      { name: "Verify the charger's per-port output", text: "Multi-port GaN chargers split total wattage across active ports. A '100W' charger may deliver only 45W when a second device is plugged in." },
      { name: "Check the device's own maximum draw", text: "Every device has its own charging ceiling and supported voltage/current profiles. Check the exact model specification or original adapter rather than assuming a wattage from product category." },
      { name: "Rule out heat and dirty ports", text: "Heat and debris can affect charging. Let an overheated charger cool, power the computer down, inspect the USB-C port, and use compressed air as recommended by the device manufacturer rather than inserting metal or improvised tools." }
    ]
  }),
  faqSchema({
    questions: [
      { question: "How do I know if my USB-C cable is rated for 100W?", answer: "Use the cable manufacturer's documented power rating or USB-IF power marking. For more than 60W, the cable must support 5A operation and electronic marking; physical thickness alone is not a reliable test." },
      { question: "Will a 240W cable charge my laptop faster than a 100W cable?", answer: "Only if the source and device negotiate a power level the existing cable cannot carry. A 240W-rated USB-C cable supports the newer high-power range, but using one does not force the charger or laptop to draw more power." },
      { question: "Why does my laptop charge slowly when other devices are plugged into the same charger?", answer: "Multi-port GaN chargers share a total wattage budget across ports. Plugging a phone into a second port of a 100W charger can drop the laptop port to 45W or 65W depending on the model." },
      { question: "Can a bad USB-C cable damage my laptop?", answer: "Compliant USB-C Power Delivery relies on negotiation among the source, sink, and cable. Damaged or non-compliant cables are a reliability and safety risk, so use a reputable cable with a clearly documented rating or certification." }
    ]
  })
];
