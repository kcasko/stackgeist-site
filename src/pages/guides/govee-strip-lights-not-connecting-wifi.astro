const __sd = [
  articleSchema({
    headline: "Govee strip lights not connecting to Wi-Fi: the real fix.",
    description: "Govee smart lights failing to connect to Wi-Fi is almost always the 2.4 GHz requirement, router band-steering forcing 5 GHz, or Location permissions blocking discovery — not a broken light. Diagnose in that order.",
    url: 'https://stackgeist.dev/guides/govee-strip-lights-not-connecting-wifi',
    dateModified: '2026-09-11'
  }),
  howToSchema({
    name: "Fix Govee strip lights that won't connect to Wi-Fi",
    description: "Diagnose in order: confirm the router broadcasts a 2.4 GHz network, disable band-steering or create a split SSID, grant Location and Local Network permissions to the Govee Home app, use Bluetooth for initial pairing, perform a hard reset, then try Matter/Thread if supported.",
    steps: [
      { name: "Confirm the router broadcasts 2.4 GHz", text: "Govee Strip Light 2 Pro and most smart lights require a 2.4 GHz Wi-Fi network. Newer mesh routers often hide the 2.4 GHz band under a single SSID, or disable it entirely by default." },
      { name: "Disable band-steering or create a split SSID", text: "Most mesh routers band-steer devices to the 5 GHz network for speed. Smart lights cannot use 5 GHz and fail setup silently. Temporarily disable band-steering in the router settings or create a separate 2.4 GHz-only SSID for setup." },
      { name: "Grant Location and Local Network permissions", text: "iOS requires Location permissions for Wi-Fi setup and Local Network permission for device discovery. Android requires Location enabled for local network scanning. The Govee Home app will fail silently without both." },
      { name: "Enable Bluetooth for initial pairing", text: "Govee lights use Bluetooth for the initial handshake, then hand off to Wi-Fi. Turn on Bluetooth on the phone and keep it within 10 feet of the light during setup." },
      { name: "Hard reset the light strip", text: "Press and hold the control button on the light for 5 seconds, or power the strip off and on five times in rapid succession. The light should blink or cycle colors to confirm reset." },
      { name: "Try Matter or Thread if supported", text: "Newer Govee models support Matter over Thread, which bypasses traditional Wi-Fi setup. Check the box or spec sheet for a Matter logo and use the Matter pairing path in the Govee app instead." }
    ]
  }),
  faqSchema({
    questions: [
      { question: "Why won't my Govee lights connect to my mesh Wi-Fi?", answer: "Mesh routers like Eero, Google Nest Wifi, and Orbi default to band-steering, which pushes devices to 5 GHz. Govee lights require 2.4 GHz and will fail setup silently. Create a 2.4 GHz-only guest network or temporarily disable band-steering in the router's settings." },
      { question: "Does the Govee app need Location permissions to set up Wi-Fi?", answer: "Yes on both iOS and Android. iOS requires Location permission because the system treats Wi-Fi network scanning as a location signal. Android requires Location enabled for local network scanning. Grant both or setup will timeout without an error message." },
      { question: "What does the hard reset sequence look like on a Govee strip?", answer: "Hold the physical control button on the strip for 5 seconds, or power the strip off and on five times rapidly. The LED should blink white or cycle through colors to confirm the reset. If nothing happens, the strip may be unpowered or the button is faulty." },
      { question: "Will a 5 GHz-only Wi-Fi network ever work with Govee lights?", answer: "No. The Wi-Fi chips in Govee Strip Light 2 Pro and similar smart lights are 2.4 GHz only. The 2.4 GHz band has longer range and better wall penetration, which is why IoT devices prefer it. A 5 GHz network will never show up in the Govee app's network list." }
    ]
  })
