---
import ContentLayout from '../../layouts/ContentLayout.astro';
import SetupHero from '../../components/SetupHero.astro';
import SetupScene from '../../components/SetupScene.astro';
import VerifiedLightingRoutes from '../../components/VerifiedLightingRoutes.astro';
import SetupCategoryGrid from '../../components/SetupCategoryGrid.astro';
import { SETUPS } from '../../data/gamingSetupOptions';
const setup = SETUPS['midnight-shift'];
---
<ContentLayout title="Midnight Shift gaming setup | StackGeist" description="A dark gaming and work setup focused on usable desk space, low clutter, and controlled lighting." active="setups">
  <p class="breadcrumbs"><a href="/setups">Setups</a> / Midnight Shift</p>
  <p class="page-kicker">Gaming + work</p>
  <h1 class="page-title">Midnight Shift</h1>
  <p class="page-lead">A dark setup for people who want atmosphere without turning the room into an RGB carnival.</p>
  <SetupHero src="/setups/midnight-shift.png" alt="Illustration of the Midnight Shift dark mixed-use gaming and work desk at night" />
  <div class="page-actions"><a class="btn" href="#verified-lighting">See verified lighting picks ↓</a></div>

  <section class="content-section split">
    <SetupScene />
    <div class="copy-panel">
      <p class="page-kicker">The idea</p>
      <h2>Protect the desk first.</h2>
      <p>The setup keeps the center work area open, pushes lighting off the desk surface, and treats cable routing as part of the build instead of an afterthought.</p>
      <div class="facts">
        <div class="fact"><span>Use</span><strong>Gaming · work · console</strong></div>
        <div class="fact"><span>Space</span><strong>Small-room friendly</strong></div>
        <div class="fact"><span>Look</span><strong>Dark with selective violet light</strong></div>
      </div>
    </div>
  </section>

  <section class="content-section">
    <p class="page-kicker">Gear used</p>
    <h2 class="section-heading">Every recommendation should solve a setup problem.</h2>
    <div class="gear-list">
      <a class="gear-row" href="/gear/desk-lighting"><div><strong>Desk / bias lighting</strong><span>Two verified routes: functional task light or lower-cost monitor backlight.</span></div><em>See options →</em></a>
      <a class="gear-row" href="https://www.amazon.com/dp/B0CQXPGNCH?tag=deskrespawn-20" target="_blank" rel="sponsored nofollow noopener noreferrer"><div><strong>Monitor support: Amazon Basics dual gas-spring arm</strong><span>For two 15–27 inch VESA monitors weighing 4.4–15.4 lb each. Check monitor weight, VESA pattern, and desk thickness before buying. Paid link.</span></div><em>Check Amazon price →</em></a>
      <a class="gear-row" href="/guides/cable-management"><div><strong>Cable management</strong><span>Plan the route before buying trays or clips. No cable organizer has cleared StackGeist verification yet.</span></div><em>Read the guide →</em></a>
      <a class="gear-row" href="/gear/desk-surface/steelseries-qck-heavy-xxl"><div><strong>Desk surface: SteelSeries QcK Heavy XXL</strong><span>A verified extended cloth surface for keyboard-and-mouse setups. Measure your usable desk area first.</span></div><em>See fit and tradeoffs →</em></a>
    </div>
  </section>

  <section class="content-section">
    <VerifiedLightingRoutes heading="Two lighting routes are verified for this setup." intro="The ScreenBar Pro is the functional-light route. The Luminoodle is the lower-cost ambient route. They are not substitutes for each other." premiumFit="Best fit when Midnight Shift also needs useful work light without consuming desk surface." budgetFit="Best fit when the goal is inexpensive violet or white backlight behind the display." />
  </section>

  <SetupCategoryGrid setup={setup} heading="Every category, three price tiers." intro="These are the parts a Midnight Shift build has to answer. Pick one option per row — you almost never need every category new." />

  <section class="content-section"><div class="note">Affiliate products are only added after the exact model, relevant specifications, and purchase fit are checked. We do not imply that placeholder gear has been tested or personally used.</div></section>
</ContentLayout>
