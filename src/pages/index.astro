---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MindMap from '../components/MindMap.astro';
import FeaturedSetup from '../components/FeaturedSetup.astro';
---

<Layout>
  <div class="site-shell">
    <Header />
    <main>
      <MindMap />
      <FeaturedSetup />

      <section class="keep-exploring" aria-labelledby="keep-exploring-title">
        <div class="divider"></div>
        <p class="eyebrow" id="keep-exploring-title">Keep exploring</p>
        <div class="explore-links">
          <button type="button" data-nav-branch="gear">
            <strong>Gear that fixes a problem</strong>
            <span>Lighting · cable management · monitor arms</span>
          </button>
          <button type="button" data-nav-branch="guides">
            <strong>Guides worth reading</strong>
            <span>Desk size · cable routing · cheap upgrades</span>
          </button>
          <button type="button" data-nav-branch="setups">
            <strong>Browse by constraint</strong>
            <span>Small spaces · budget · work + gaming</span>
          </button>
        </div>
      </section>
      <footer class="site-footer">
        <strong>STACKGEIST</strong>
        <nav aria-label="Footer navigation">
          <button type="button" data-nav-branch="setups">Setups</button>
          <button type="button" data-nav-branch="gear">Gear</button>
          <button type="button" data-nav-branch="guides">Guides</button>
          <a href="/about">About</a>
        </nav>
        <p>As an Amazon Associate I earn from qualifying purchases.</p>
      </footer>
    </main>
  </div>
</Layout>

<style>
  .keep-exploring {
    margin-top: 36px;
  }

  .keep-exploring > .eyebrow {
    margin-top: 32px;
  }

  .explore-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 24px;
  }

  .explore-links button {
    min-height: 74px;
    padding: 6px 42px;
    border: 0;
    border-left: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    text-align: left;
    cursor: pointer;
  }
  .explore-links button:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .explore-links strong,
  .explore-links span {
    display: block;
  }

  .explore-links strong {
    font-size: 15px;
  }

  .explore-links span {
    margin-top: 9px;
    color: var(--muted);
    font-size: 12px;
  }

  .explore-links button:hover strong {
    color: var(--purple-light);
  }

  .site-footer {
    min-height: 100px;
    display: grid;
    grid-template-columns: 180px 1fr auto;
    align-items: center;
    gap: 28px;
    margin-top: 38px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
  }

  .site-footer > strong {
    color: var(--text);
    font-size: 12px;
  }
  .site-footer nav {
    display: flex;
    gap: 8px;
  }

  .site-footer button,
  .site-footer a {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 11px;
    cursor: pointer;
  }

  .site-footer button:not(:last-child)::after,
  .site-footer a:not(:last-child)::after {
    content: '·';
    margin-left: 8px;
    color: var(--quiet);
  }

  .site-footer button:hover,
  .site-footer a:hover {
    color: var(--purple-light);
  }

  .site-footer p {
    margin: 0;
    text-align: right;
  }

  @media (max-width: 760px) {
    .keep-exploring {
      display: none;
    }
    .site-footer {
      min-height: 150px;
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 26px 0 10px;
    }

    .site-footer nav {
      display: none;
    }

    .site-footer p {
      max-width: 330px;
      text-align: left;
      line-height: 1.5;
    }
  }
</style>
