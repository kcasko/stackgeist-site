---
import Layout from '../layouts/Layout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import BrandMark from '../components/BrandMark.astro';
import { CATALOG } from '../data/catalog';
import { SECTIONS, TOPIC_LABEL, TYPE_LABEL, entry, entries, inSection, latest, formatDate } from '../data/sections';

const lead = entry('/guides/usb-c-dock-only-one-monitor/');
const second = [
  {
    e: entry('/certs/wgu-software-engineering-degree/'),
    img: { src: '/images/generated/study-desk-v2.webp', small: '/images/generated/study-desk-v2-800.webp', w: 1536, h: 1024 },
    alt: 'A desk with stacked books, a spiral notebook and pen, headphones, a laptop, and a desk lamp',
  },
  {
    e: entry('/labs/homelab-equipment-for-beginners/'),
    img: { src: '/images/generated/homelab-rack-v2.webp', small: '/images/generated/homelab-rack-v2-800.webp', w: 1536, h: 1024 },
    alt: 'A small open rack beside a desk, with a network switch, patch cables, and two rackmount servers',
  },
];
const newest = latest(6, (e) => e.type !== 'kit' && e.type !== 'setup');

const fixList = entries([
  '/guides/external-drive-shows-in-disk-management-not-file-explorer/',
  '/guides/wifi-keeps-disconnecting-router-or-pc/',
  '/guides/gan-charger-not-charging-laptop-full-speed/',
  '/guides/microsd-card-not-detected/',
  '/guides/how-to-tell-if-ssd-is-failing/',
  '/guides/portable-usb-c-monitor-no-signal/',
  '/guides/sennheiser-momentum-4-wont-pair/',
  '/guides/laptop-not-charging-through-usb-c-dock/',
]);

const fixTopics = Object.entries(TOPIC_LABEL).map(([topic, label]) => {
  const all = CATALOG.filter((e) => e.section === 'fixes' && e.topic === topic && e.type === 'troubleshooting');
  const hub = CATALOG.find((e) => e.section === 'fixes' && e.topic === topic && e.type === 'topic');
  return { topic, label, count: all.length, hub, top: all.slice(0, 3) };
});
const labs = inSection('labs');
const learning = inSection('learning');
const gearRows = [
  { e: entry('/gear/budget-tech/wd-my-passport-4tb/'), kind: 'Portable hard drive', evidence: 'Owned and used' },
  { e: entry('/gear/budget-tech/sennheiser-momentum-4-wireless-noise-cancelling-headphones/'), kind: 'Wireless headphones', evidence: 'Owned and used' },
  { e: entry('/gear/connectivity/caldigit-ts4/'), kind: 'Thunderbolt 4 dock', evidence: 'Researched' },
  { e: entry('/gear/connectivity/anker-553-usb-c-hub/'), kind: 'USB-C hub', evidence: 'Researched' },
  { e: entry('/gear/input/logitech-mx-master-3s/'), kind: 'Mouse', evidence: 'Researched' },
];
const buying = entries(['/guides/usb-c-dock-compatibility/', '/guides/usb-c-cable-buying-guide/']);
---
<Layout
  title="StackGeist: computer fixes, home labs, and IT study notes"
  description="Step-by-step fixes for USB-C docks, storage, charging, and Wi-Fi problems, documented IT home labs, WGU course reviews, and hardware notes that say what was owned and what was researched."
>

  <!-- Lead story: photo with an overlapping headline panel -->
  <section class="lead" data-section="fixes" aria-labelledby="lead-title">
    <figure class="photo lead-photo">
      <picture>
        <source media="(max-width: 700px)" srcset="/images/generated/usb-c-dock-desk-v2-800.webp" />
        <img src="/images/generated/usb-c-dock-desk-v2.webp" width="1536" height="1024" alt="A laptop and monitor on a wooden desk, connected through a USB-C dock, with a small external drive beside it" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
    </figure>
    <div class="lead-panel">
      <p><a class="slab" href="/guides/usb-c-charging-display-problems/">Fixes · {TOPIC_LABEL[lead.topic]}</a></p>
      <h1 id="lead-title" class="lead-title display"><a href={lead.href}>USB-C dock only detecting one monitor<span>Diagnose the display path.</span></a></h1>
      <p class="lead-dek">One display working through a dock doesn’t prove the dock is bad. The laptop’s port, the cable, the dock’s video mode, drivers, and a display setting can all cause it. Six checks, in the order that finds it fastest.</p>
      <p class="meta"><b>6 steps</b> · Updated <time datetime={lead.updated}>{formatDate(lead.updated)}</time></p>
    </div>
  </section>

  <!-- Second row: two image stories with different crops, plus a typographic "latest" column -->
  <section class="second" aria-label="More stories">
    {second.map(({ e, img, alt }, i) => (
      <article class:list={['story', `story-${i + 1}`]} data-section={e.section}>
        <a class="story-img" href={e.href} tabindex="-1" aria-hidden="true">
          <img src={img.src} srcset={`${img.small} 800w, ${img.src} ${img.w}w`} sizes="(max-width: 700px) 100vw, 420px" width={img.w} height={img.h} alt={alt} loading="lazy" decoding="async" />
        </a>
        <p class="kicker">{SECTIONS[e.section].label} · {TYPE_LABEL[e.type]}</p>
        <h2 class="story-title display"><a href={e.href}>{e.title}</a></h2>
        <p class="story-dek">{e.dek}</p>
      </article>
    ))}
    <aside class="latest" aria-labelledby="latest-title">
      <h2 id="latest-title" class="block-title">Just updated</h2>
      <ol>
        {newest.map((e) => (
          <li data-section={e.section}>
            <span class="latest-sec">{SECTIONS[e.section].label}</span>
            <a href={e.href}>{e.title}</a>
            <time datetime={e.updated}>{formatDate(e.updated)}</time>
          </li>
        ))}
      </ol>
    </aside>
  </section>

  <!-- The fix list: numbered, dense, typography-led -->
  <section class="fixlist" data-section="fixes" aria-labelledby="fixlist-title">
    <header class="block-head">
      <h2 id="fixlist-title" class="display">Fix it before you buy it</h2>
      <p>Eight good places to start. Each guide opens with a short answer, then works through the checks in order, free ones first.</p>
      <a class="btn" href="/guides/">All {CATALOG.filter((e) => e.section === 'fixes' && e.type === 'troubleshooting').length} fixes</a>
    </header>
    <ol class="fixlist-items">
      {fixList.map((e, i) => (
        <li>
          <span class="fl-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <span class="fl-topic">{TOPIC_LABEL[e.topic]}</span>
            <a class="fl-title" href={e.href}>{e.title}</a>
            <p>{e.dek}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Four departments, each with its own layout -->
  <section class="depts" aria-label="Sections">

    <div class="dept dept-fixes" data-section="fixes">
      <header class="dept-head"><a class="dept-name display" href="/guides/">Fixes</a><p>{SECTIONS.fixes.blurb}</p></header>
      <div class="topic-index">
        {fixTopics.map((t) => (
          <div class="topic">
            <h3><a href={t.hub?.href ?? '/guides/'}>{t.label}</a></h3>
            <p class="topic-count"><b>{t.count}</b> fixes</p>
            <ul>{t.top.map((e) => <li><a href={e.href}>{e.title}</a></li>)}</ul>
          </div>
        ))}
      </div>
    </div>

    <div class="dept dept-labs" data-section="labs">
      <header class="dept-head"><a class="dept-name display" href="/labs/">Labs</a><p>{SECTIONS.labs.blurb}</p></header>
      <ul class="lab-list">
        {labs.map((e) => (
          <li><p class="kicker lab-kind">{TYPE_LABEL[e.type]}</p><a href={e.href}>{e.title}</a><p class="lab-dek">{e.dek}</p></li>
        ))}
      </ul>
    </div>

    <div class="dept dept-learning" data-section="learning">
      <header class="dept-head"><a class="dept-name display" href="/learning/">Learning</a><p>{SECTIONS.learning.blurb}</p></header>
      <ul class="learn-list">
        {learning.map((e) => (
          <li><span class="learn-type">{TYPE_LABEL[e.type]}</span><a href={e.href}>{e.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="dept dept-gear" data-section="gear">
      <header class="dept-head"><a class="dept-name display" href="/gear/">Gear</a><p>{SECTIONS.gear.blurb}</p></header>
      <div class="table-scroll">
        <table class="gear-table">
          <caption class="sr-only">Gear pages and the evidence behind each one</caption>
          <thead><tr><th scope="col">Product</th><th scope="col">Type</th><th scope="col">Evidence</th></tr></thead>
          <tbody>
            {gearRows.map((r) => (
              <tr>
                <th scope="row"><a href={r.e.href}>{r.e.title}</a></th>
                <td>{r.kind}</td>
                <td><span class:list={['evidence', { owned: r.evidence.startsWith('Owned') }]}>{r.evidence}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="gear-also">Before you buy: {buying.map((e, i) => <>{i > 0 && ' · '}<a href={e.href}>{e.title}</a></>)}</p>
    </div>
  </section>

  <!-- Who's behind it -->
  <section class="about-strip" aria-labelledby="about-title">
    <figure class="photo about-photo">
      <img src="/images/generated/retro-desk-v2.webp" srcset="/images/generated/retro-desk-v2-800.webp 800w, /images/generated/retro-desk-v2.webp 1600w" sizes="(max-width: 860px) 100vw, 560px" width="1600" height="762" alt="A wooden desk with a laptop, a beige mechanical keyboard, a desk lamp, and an old CRT monitor on the shelf behind" loading="lazy" decoding="async" />
    </figure>
    <div class="about-copy">
      <BrandMark size={52} />
      <h2 id="about-title" class="display">Who’s behind the ghost</h2>
      <p>StackGeist is written by Keith Casko, who is working toward IT support and systems roles and studying for a B.S. in Software Engineering at WGU. The labs here are systems he built. The fixes are checked against manufacturer sources. Every gear page says whether he owns the product or researched it.</p>
      <p><a href="/about/">More about StackGeist and how pages are checked</a></p>
    </div>
  </section>

  <NewsletterSignup />
</Layout>

<style>
/* ---- Lead ---- */
.lead { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); margin-top: var(--space-6); }
.lead-photo { grid-column: 1 / span 1; grid-row: 1; }
.lead-photo img { aspect-ratio: 3 / 2; object-fit: cover; }
.lead-panel {
  grid-column: 2; grid-row: 1; align-self: end; position: relative; z-index: 1;
  margin: 0 0 var(--space-7) calc(var(--space-8) * -1); padding: var(--space-5) var(--space-5) var(--space-4);
  background: var(--surface); border: 3px solid var(--ink); box-shadow: 10px 10px 0 var(--dept);
}
.lead-panel > p:first-child { margin: 0 0 var(--space-3); }
.lead-title { margin: 0; font-size: clamp(2.3rem, 4.4vw, 3.6rem); }
.lead-title a { color: var(--ink); text-decoration: none; }
.lead-title span { display: block; margin-top: .12em; color: var(--dept-ink); }
.lead-title a:hover { background: none; color: var(--ink); }
.lead-title a:hover span { background: var(--geist); color: #121212; }
.lead-dek { margin: var(--space-3) 0 var(--space-3); color: var(--ink-2); font-size: 1.05rem; line-height: 1.5; }
.lead figcaption { grid-column: 1; }

/* ---- Second row ---- */
.second { display: grid; grid-template-columns: 1.15fr 1fr .85fr; gap: var(--space-6); margin-top: var(--space-7); padding-top: var(--space-5); border-top: 4px solid var(--ink); }
.story-img { display: block; margin-bottom: var(--space-3); }
.story-img:hover { background: none; }
.story-img img { display: block; width: 100%; object-fit: cover; }
.story-1 .story-img img { aspect-ratio: 4 / 3; }
.story-2 .story-img img { aspect-ratio: 16 / 10; }
.story-title { margin: 0; font-size: clamp(1.6rem, 2.4vw, 2.15rem); }
.story-title a { color: var(--ink); text-decoration: none; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
.story-title a:hover { background: var(--geist); color: #121212; }
.story-dek { margin: var(--space-2) 0 0; color: var(--ink-2); font-size: .98rem; line-height: 1.5; }
.story { border-top: 6px solid var(--dept); padding-top: var(--space-3); }
.story .story-img { margin-top: 0; }
.credit-line { margin: var(--space-2) 0 0; }
.credit-line .credit { margin-left: 0; }

.block-title { margin: 0 0 var(--space-3); font: 900 1.4rem/1 var(--font-sans); font-stretch: var(--condensed); text-transform: uppercase; }
.latest { padding: var(--space-4); background: var(--surface); border: 2px solid var(--ink); align-self: start; }
.latest ol { margin: 0; padding: 0; list-style: none; }
.latest li { display: grid; gap: 2px; padding: 10px 0; border-top: 1px solid var(--rule); }
.latest li:first-child { border-top: 0; padding-top: 0; }
.latest-sec { color: var(--dept-ink); font: 800 .66rem/1.2 var(--font-sans); font-stretch: var(--expanded); letter-spacing: .05em; text-transform: uppercase; }
.latest a { font-weight: 650; line-height: 1.3; text-decoration: none; }
.latest a:hover { text-decoration: underline; }
.latest time { color: var(--ink-3); font-size: .8rem; }

/* ---- Fix list ---- */
.fixlist { margin-top: var(--space-8); padding: var(--space-6); background: var(--plate); color: var(--plate-ink); --link: var(--plate-ink); --rule: #3a3a3a; }
.block-head { display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: var(--space-5); padding-bottom: var(--space-4); border-bottom: 3px solid var(--dept); }
.block-head h2 { margin: 0; color: #fff; font-size: clamp(2rem, 4vw, 3.2rem); }
.block-head p { max-width: 52ch; margin: 0; color: #c9c8c2; font-size: .98rem; line-height: 1.45; }
.fixlist .btn { background: var(--geist); color: #121212; border-color: var(--geist); box-shadow: 3px 3px 0 var(--dept); }
.fixlist-items { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-6); margin: 0; padding: 0; list-style: none; }
.fixlist-items li { display: grid; grid-template-columns: 3.4rem 1fr; gap: var(--space-3); padding: var(--space-4) 0; border-bottom: 1px solid #3a3a3a; }
.fl-no { color: var(--dept); font: 900 2.6rem/.9 var(--font-sans); font-stretch: var(--condensed); }
.fl-topic { display: block; margin-bottom: 3px; color: #a9a8a1; font: 750 .66rem/1.2 var(--font-sans); font-stretch: var(--expanded); letter-spacing: .05em; text-transform: uppercase; }
.fl-title { color: #fff; font: 800 1.2rem/1.15 var(--font-sans); font-stretch: 88%; text-decoration: none; }
.fl-title:hover { background: var(--geist); color: #121212; }
.fixlist-items p { margin: 4px 0 0; color: #c9c8c2; font-size: .92rem; line-height: 1.45; }
.fixlist :focus-visible { box-shadow: 0 0 0 5px #fff; }

/* ---- Departments ---- */
.depts { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-7) var(--space-6); margin-top: var(--space-8); }
.dept { border-top: 8px solid var(--dept); padding-top: var(--space-3); }
.dept-fixes { grid-column: 1 / -1; }
.dept-labs { grid-column: 1 / span 7; }
.dept-learning { grid-column: 8 / -1; }
.dept-gear { grid-column: 1 / -1; }
.dept-head { display: grid; grid-template-columns: auto 1fr; gap: var(--space-5); align-items: baseline; margin-bottom: var(--space-4); }
.dept-labs .dept-head, .dept-learning .dept-head { grid-template-columns: 1fr; gap: var(--space-2); }
.dept-name { color: var(--dept-ink); font-size: clamp(2.4rem, 5vw, 3.6rem); text-decoration: none; text-transform: uppercase; }
.dept-name:hover { background: var(--geist); color: #121212; }
.dept-head p { max-width: 60ch; margin: 0; color: var(--ink-2); font-size: .98rem; line-height: 1.5; }

.topic-index { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; border: 2px solid var(--ink); background: var(--surface); }
.topic { padding: var(--space-4); border-right: 1px solid var(--rule); }
.topic:last-child { border-right: 0; }
.topic h3 { margin: 0; font: 850 1.15rem/1.1 var(--font-sans); font-stretch: 85%; }
.topic h3 a { text-decoration: none; }
.topic h3 a:hover { text-decoration: underline; }
.topic-count { margin: 4px 0 var(--space-3); color: var(--ink-3); font-size: .85rem; }
.topic-count b { color: var(--dept-ink); font: 900 1.6rem/1 var(--font-sans); font-stretch: var(--condensed); }
.topic ul { margin: 0; padding: 0; list-style: none; }
.topic li { padding: 6px 0; border-top: 1px solid var(--rule); font-size: .9rem; line-height: 1.3; }
.topic li a { text-decoration-thickness: 1px; }

.lab-list { margin: 0; padding: 0; list-style: none; columns: 2 260px; column-gap: var(--space-6); }
.lab-list li { break-inside: avoid; padding: var(--space-3) 0; border-top: 1px solid var(--rule); }
.lab-kind { margin: 0 0 2px; }
.lab-list a { font: 800 1.08rem/1.2 var(--font-sans); font-stretch: 90%; text-decoration: none; }
.lab-list a:hover { text-decoration: underline; }
.lab-dek { margin: 4px 0 0; color: var(--ink-2); font-size: .9rem; line-height: 1.45; }

.learn-list { margin: 0; padding: 0; list-style: none; border-top: 2px solid var(--ink); }
.learn-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: var(--space-3); padding: 10px 0; border-bottom: 1px solid var(--rule); line-height: 1.3; }
.learn-type { color: var(--dept-ink); font: 800 .66rem/1.5 var(--font-sans); font-stretch: var(--expanded); letter-spacing: .04em; text-transform: uppercase; }
.learn-list a { font-weight: 650; text-decoration: none; }
.learn-list a:hover { text-decoration: underline; }

.gear-table th a { font-weight: 750; }
.evidence { display: inline-block; padding: 2px 7px; border: 1.5px solid var(--ink-3); color: var(--ink-2); font: 750 .72rem/1.3 var(--font-sans); font-stretch: var(--expanded); text-transform: uppercase; }
.evidence.owned { border-color: var(--ink); background: var(--geist); color: #121212; }
.gear-also { margin: var(--space-3) 0 0; color: var(--ink-3); font-size: .95rem; }
.depts table { width: 100%; background: var(--surface); border: 2px solid var(--ink); }
.depts th, .depts td { padding: 10px 12px; border-bottom: 1px solid var(--rule); text-align: left; }
.depts thead th { background: var(--ink); color: var(--base); font: 800 .72rem/1.3 var(--font-sans); font-stretch: var(--expanded); text-transform: uppercase; }

/* ---- About strip ---- */
.about-strip { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--space-6); align-items: center; margin-top: var(--space-8); padding: var(--space-5); background: var(--geist); color: #121212; --link: #121212; --link-line: #121212; }
.about-photo img { aspect-ratio: 1600 / 762; object-fit: cover; border: 3px solid #121212; }
.about-photo figcaption { margin-top: 6px; }
.about-photo .credit { margin-left: 0; background: #121212; color: var(--geist); }
.about-copy h2 { margin: var(--space-3) 0 var(--space-2); color: #121212; font-size: clamp(2rem, 3.6vw, 2.8rem); text-transform: uppercase; }
.about-copy p { max-width: 54ch; margin: 0 0 var(--space-3); color: #121212; line-height: 1.5; }
.about-copy a:hover { background: #121212; color: var(--geist); }
.about-copy :global(.brand-mark rect) { stroke: #121212; stroke-width: .6; }

/* ---- Responsive ---- */
@media (max-width: 1060px) {
  .second { grid-template-columns: 1fr 1fr; }
  .latest { grid-column: 1 / -1; }
  .latest ol { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 var(--space-5); }
  .latest li:nth-child(-n+3) { border-top: 0; padding-top: 0; }
  .topic-index { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .topic { border-bottom: 1px solid var(--rule); }
  .block-head { grid-template-columns: 1fr auto; }
  .block-head p { grid-column: 1 / -1; grid-row: 2; }
}
@media (max-width: 860px) {
  .depts { grid-template-columns: minmax(0, 1fr); }
  .lead { grid-template-columns: 1fr; }
  .lead-panel { grid-column: 1; grid-row: 2; margin: var(--space-3) var(--space-4) 0; }
  .dept-labs, .dept-learning { grid-column: 1 / -1; }
  .about-strip { grid-template-columns: 1fr; }
  .fixlist-items { grid-template-columns: 1fr; }
}
@media (max-width: 700px) {
  .lead { margin-top: var(--space-4); margin-left: calc(var(--page-pad) * -1); margin-right: calc(var(--page-pad) * -1); }
  .lead-panel { margin: var(--space-3) var(--space-3) 0; padding: var(--space-4); box-shadow: 6px 6px 0 var(--dept); }
  .lead-photo figcaption { margin: 6px var(--page-pad) 0; }
  .second { grid-template-columns: 1fr; gap: var(--space-6); }
  .latest ol { grid-template-columns: 1fr; }
  .latest li:nth-child(-n+3) { border-top: 1px solid var(--rule); padding-top: 10px; }
  .latest li:first-child { border-top: 0; padding-top: 0; }
  .fixlist { margin-left: calc(var(--page-pad) * -1); margin-right: calc(var(--page-pad) * -1); padding: var(--space-5) var(--page-pad); }
  .block-head { grid-template-columns: 1fr; }
  .fixlist-items li { grid-template-columns: 2.6rem 1fr; }
  .fl-no { font-size: 2rem; }
  .dept-head { grid-template-columns: 1fr; gap: var(--space-2); }
  .topic-index { grid-template-columns: 1fr 1fr; }
  .topic:nth-child(odd):last-child { grid-column: 1 / -1; }
  .learn-list li { grid-template-columns: 1fr; gap: 2px; }
  .about-strip { margin-left: calc(var(--page-pad) * -1); margin-right: calc(var(--page-pad) * -1); padding: var(--space-5) var(--page-pad); }
}
@media (max-width: 560px) { .gear-table th:nth-child(2), .gear-table td:nth-child(2) { display: none; } }
@media (max-width: 420px) { .topic-index { grid-template-columns: 1fr; } .topic { border-right: 0; } }
</style>
