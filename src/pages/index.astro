---
import Layout from '../layouts/Layout.astro';import Header from '../components/Header.astro';import MindMap from '../components/MindMap.astro';import NewsletterSignup from '../components/NewsletterSignup.astro';

const jobs=[
  {href:'/guides/',eyebrow:'Start here',title:'Fix a problem',note:'USB-C, charging, displays, storage, Wi-Fi, Bluetooth, mice, keyboards, webcams, and more.',cta:'Browse fixes →',tone:'primary'},
  {href:'/gear/',eyebrow:'Buying decision',title:'Choose gear',note:'Use fit-first product pages when troubleshooting shows that hardware is actually the problem.',cta:'Browse gear →',tone:'secondary'},
  {href:'/setups/',eyebrow:'Whole build',title:'Build a setup',note:'Complete desk and gaming setups organized around room size, budget, and what you actually do there.',cta:'Browse setups →',tone:'secondary'},
];

const popularFixes=[
  {href:'/guides/usb-c-dock-only-one-monitor/',title:'USB-C dock only detecting one monitor',note:'MST, DisplayLink, Thunderbolt, host limits, and cable checks.'},
  {href:'/guides/portable-usb-c-monitor-no-signal/',title:'Portable USB-C monitor has no signal',note:'Check video support, cable capability, and hub passthrough.'},
  {href:'/guides/usb-c-cable-charging-slow/',title:'USB-C cable charging too slowly',note:'Separate cable wattage, charger output, and device limits.'},
  {href:'/guides/raspberry-pi-5-wont-boot/',title:'Raspberry Pi 5 won’t boot',note:'Power, boot media, LED patterns, HDMI, and attached-device checks.'},
  {href:'/guides/mx-master-3s-scroll-wheel-not-working/',title:'MX Master 3S scroll wheel not working',note:'SmartShift, app profiles, firmware, debris, and hardware triage.'},
  {href:'/guides/keychron-v6-max-bluetooth-not-connecting/',title:'Keychron V6 Max Bluetooth not connecting',note:'Mode, profile keys, pairing sequence, and reset steps.'},
];

const buildNext=[
  {href:'/kits/usb-c-desk-survival-kit/',title:'USB-C desk survival kit',note:'Cable, hub, charger, and adapters — only after you know what the host supports.'},
  {href:'/kits/help-desk-homelab-starter-kit/',title:'Help desk homelab starter kit',note:'A practical lab buying order for learning support and systems work.'},
  {href:'/kits/cheap-desk-upgrades-under-100/',title:'Cheap desk upgrades under $100',note:'Low-cost fixes for lighting, power, cable routing, and reach problems.'},
];

const updated='Updated October 2026';
---
<Layout title="PC & Desk Tech Troubleshooting, Gear Guides & Setups | StackGeist" description="Fix USB-C, peripherals, storage, charging, and desk-tech problems with practical troubleshooting guides, fit-first gear research, and setup advice.">
<div class="site-shell home-shell"><Header interactive={false}/><main id="main-content" tabindex="-1">

<section class="hero-simple" aria-labelledby="home-title">
  <p class="hero-eyebrow">{updated} · practical fixes · evidence-labeled gear</p>
  <h1 id="home-title">What are you trying to do?</h1>
  <p class="hero-lead">Start with the problem. Buy something only when the diagnosis says you need it.</p>
  <div class="job-grid">
    {jobs.map((job)=><a class:list={['job-card',job.tone]} href={job.href}><span class="job-eyebrow">{job.eyebrow}</span><strong>{job.title}</strong><span>{job.note}</span><b>{job.cta}</b></a>)}
  </div>
</section>

<section class="panel fixes-panel" aria-labelledby="fixes-title">
  <header class="panel-head"><span class="dollar">$</span><span id="fixes-title" class="cmd">popular fixes</span><a class="panel-link" href="/guides/">all fixes →</a></header>
  <div class="fix-grid">{popularFixes.map((fix)=><a class="fix-link" href={fix.href}><strong>{fix.title}</strong><span>{fix.note}</span><span class="fix-go">open fix →</span></a>)}</div>
</section>

<section class="plain-section" aria-labelledby="buy-title">
  <p class="section-kicker">After the diagnosis</p>
  <h2 id="buy-title">Need to buy or build something?</h2>
  <p class="section-lead">These are the next steps when a fix points to hardware or you are starting from scratch.</p>
  <div class="next-grid">{buildNext.map((item)=><a class="next-card" href={item.href}><strong>{item.title}</strong><span>{item.note}</span><b>open →</b></a>)}</div>
</section>

<section class="explore-section" aria-labelledby="explore-title">
  <div class="explore-copy"><p class="section-kicker">Optional explorer</p><h2 id="explore-title">Want to browse everything?</h2><p>The terminal map is here for exploring the catalog. You do not need it to find a fix or make a buying decision.</p></div>
  <MindMap/>
</section>

<section class="trust-strip" aria-label="How StackGeist works">
  <div><strong>Fix first</strong><span>Troubleshoot before replacing hardware.</span></div>
  <div><strong>Show the evidence</strong><span>Owned, used, or researched is stated explicitly.</span></div>
  <div><strong>Name the tradeoff</strong><span>Pages include skip reasons, not just buy buttons.</span></div>
</section>

<NewsletterSignup/>
</main></div></Layout>

<style>
.home-shell{overflow:visible}.home-shell main{padding-bottom:8px}
.hero-simple{padding:56px 0 8px;font-family:var(--font-mono)}
.hero-eyebrow{margin:0 0 12px;color:var(--phosphor);font-size:11.5px;letter-spacing:.04em;text-transform:uppercase}
.hero-simple h1{max-width:760px;margin:0;color:var(--text);font-size:clamp(34px,5vw,58px);line-height:1.02;letter-spacing:-.045em}
.hero-lead{max-width:700px;margin:18px 0 0;color:var(--muted);font-size:15px;line-height:1.65}
.job-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;margin-top:28px;border:1px solid var(--term-border);background:var(--term-bg)}
.job-card{display:grid;gap:9px;min-height:190px;padding:24px;border-left:1px solid var(--term-border);color:inherit}
.job-card:first-child{border-left:0}.job-card:hover{background:rgba(163,230,53,.04)}
.job-card.primary{background:linear-gradient(180deg,rgba(163,230,53,.06),transparent)}
.job-eyebrow{color:var(--purple-light);font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
.job-card strong{font-size:22px;line-height:1.2}.job-card span:not(.job-eyebrow){color:var(--muted);font-size:13px;line-height:1.55}
.job-card b{align-self:end;color:var(--phosphor);font-size:12.5px}
.panel{margin-top:42px;border:1px solid var(--term-border);background:var(--term-bg);font-family:var(--font-mono)}
.panel-head{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px dashed var(--term-border);font-size:12.5px}.dollar{color:var(--phosphor)}.cmd{color:var(--text)}.panel-link{margin-left:auto;color:var(--phosphor)}
.fix-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
.fix-link{display:grid;gap:7px;padding:16px 18px;border-top:1px solid var(--term-border);color:var(--text)}
.fix-link:nth-child(-n+2){border-top:0}.fix-link:nth-child(even){border-left:1px solid var(--term-border)}.fix-link:hover{background:rgba(163,230,53,.05)}
.fix-link strong{font-size:13.5px}.fix-link span{color:var(--muted);font-size:12.5px;line-height:1.45}.fix-link .fix-go{color:var(--phosphor);font-size:11.5px}
.plain-section,.explore-section{margin-top:64px}.section-kicker{margin:0 0 8px;color:var(--purple-light);font:700 11px var(--font-mono);text-transform:uppercase;letter-spacing:.05em}
.plain-section h2,.explore-copy h2{margin:0;color:var(--text);font-size:clamp(24px,3vw,34px);letter-spacing:-.025em}
.section-lead,.explore-copy p:last-child{max-width:700px;margin:10px 0 0;color:var(--muted);line-height:1.6}
.next-grid{display:grid;grid-template-columns:repeat(3,1fr);margin-top:22px;border:1px solid var(--term-border);background:var(--term-bg)}
.next-card{display:grid;gap:9px;min-height:150px;padding:20px;border-left:1px solid var(--term-border);color:inherit}.next-card:first-child{border-left:0}.next-card:hover{background:rgba(192,132,252,.05)}
.next-card strong{font-size:15px}.next-card span{color:var(--muted);font-size:12.5px;line-height:1.55}.next-card b{align-self:end;color:var(--phosphor);font:600 12px var(--font-mono)}
.explore-copy{margin-bottom:16px}.explore-section :global(.tree){margin-top:0}
.trust-strip{display:grid;grid-template-columns:repeat(3,1fr);margin:56px 0 10px;border-block:1px solid var(--term-border);font-family:var(--font-mono)}
.trust-strip div{display:grid;gap:6px;padding:18px;border-left:1px solid var(--term-border)}.trust-strip div:first-child{border-left:0}
.trust-strip strong{color:var(--phosphor);font-size:12px}.trust-strip span{color:var(--muted);font-size:11.5px;line-height:1.5}
@media(max-width:900px){.job-grid{grid-template-columns:1fr}.job-card{min-height:0;border-left:0;border-top:1px solid var(--term-border)}.job-card:first-child{border-top:0}.next-grid{grid-template-columns:1fr}.next-card{min-height:0;border-left:0;border-top:1px solid var(--term-border)}.next-card:first-child{border-top:0}}
@media(max-width:720px){.hero-simple{padding-top:34px}.hero-simple h1{font-size:36px}.hero-lead{font-size:14px}.job-card{padding:20px}.fix-grid{grid-template-columns:1fr}.fix-link:nth-child(n){border-left:0;border-top:1px solid var(--term-border)}.fix-link:first-child{border-top:0}.plain-section{margin-top:46px}.explore-section{display:none}.trust-strip{grid-template-columns:1fr}.trust-strip div{border-left:0;border-top:1px solid var(--term-border)}.trust-strip div:first-child{border-top:0}}
</style>
