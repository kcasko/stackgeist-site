---
import Layout from '../layouts/Layout.astro';import Header from '../components/Header.astro';import MindMap from '../components/MindMap.astro';import NewsletterSignup from '../components/NewsletterSignup.astro';
const stats=[{k:'gear.verified',v:'30',hint:'human-checked picks'},{k:'comparisons.live',v:'10',hint:'side-by-side, no filler'},{k:'affiliate.disclosed',v:'100%',hint:'links marked in-line'},{k:'skip.if.blocks',v:'always',hint:'when a pick is wrong'}];
const problems=[{id:'01',href:'/gear/budget-tech',cmd:'run budget --under=75',title:'useful upgrade under $75',note:'browse budget tech by price'},{id:'02',href:'/gear/budget-tech/compare',cmd:'diff productA productB',title:'compare two options',note:'see who each product suits'},{id:'03',href:'/setups/small-bedroom-gaming',cmd:'plan --room=small',title:'almost no desk space',note:'plan a small-room setup'},{id:'04',href:'/guides/cable-management',cmd:'route --cables',title:'cables are the real problem',note:'fix the route before shopping'}];
const research=[{href:'/gear/desk-power/anker-nano-a9196',tag:'fit-guide',title:'anker nano A9196 clamp strip',note:'measure desk thickness + USB power sharing before checkout.'},{href:'/gear/budget-tech/compare/iniu-cable-vs-generic-usb-c',tag:'compare',title:'INIU 240W cable  vs  generic USB-C',note:'the wattage on the listing is not the whole compatibility story.'},{href:'/guides/cheap-desk-upgrades',tag:'guide',title:'cheap upgrades that improve a desk first',note:'fix friction, lighting, cable paths, reach zones before replacing gear.'}];
---
<Layout title="StackGeist | Practical desk setup ideas and verified tech gear" description="Build a better desk or gaming setup with fit-first gear research, honest tradeoffs, budget tech comparisons, and practical guides.">
<div class="site-shell home-shell"><Header interactive={false}/><main>
<section class="motd" aria-label="StackGeist introduction"><pre class="ascii" aria-hidden="true"><code>  ____  _             _     ____      _     _
 / ___|| |_ __ _  ___| | __/ ___| ___(_)___| |_
 \___ \| __/ _` |/ __| |/ / |  _ / _ \ / __| __|
  ___) | || (_| | (__|   &lt;| |_| |  __/ \__ \ |_
 |____/ \__\__,_|\___|_|\_\\____|\___|_|___/\__|
</code></pre><div class="motd-body"><p class="motd-line"><span class="prompt">motd</span><span class="sep">:</span> practical setup research · no brand hype · human-reviewed picks</p><p class="motd-line"><span class="prompt">whoami</span><span class="sep">:</span> desk operator · <a class="inline" href="/gear/budget-tech">go to budget-tech</a> · <a class="inline" href="/guides/desk-layout-basics">plan the desk first</a></p><p class="motd-line quiet">tip: click a bracketed node in the map below, or ? for keyboard help.</p></div></section>
<MindMap/>
<section class="statbar" aria-label="StackGeist catalog status">{stats.map((s)=><div class="stat"><span class="stat-k">{s.k}</span><span class="stat-v">{s.v}</span><span class="stat-h">// {s.hint}</span></div>)}</section>
<section class="panel" aria-labelledby="problem-title"><header class="panel-head"><span class="dollar">$</span><span id="problem-title" class="cmd">ps aux --sort=intent</span><span class="rc">→ 4 rows</span></header><div class="ps"><div class="ps-row ps-head"><span>#</span><span>cmd</span><span>problem</span><span>next</span><span></span></div>{problems.map((p)=><a class="ps-row" href={p.href}><span class="ps-id">{p.id}</span><span class="ps-cmd">{p.cmd}</span><span class="ps-title">{p.title}</span><span class="ps-note">{p.note}</span><span class="ps-go" aria-hidden="true">↗</span></a>)}</div></section>
<section class="panel" aria-labelledby="research-title"><header class="panel-head"><span class="dollar">$</span><span id="research-title" class="cmd">cat ./research/*.md | head</span><span class="rc">→ 3 files</span></header><div class="files">{research.map((r)=><a class="file" href={r.href}><div class="file-head"><span class="file-tag">[{r.tag}]</span><span class="file-path">./research/{r.href.split('/').slice(-1)[0]}.md</span></div><p class="file-title">{r.title}</p><p class="file-note">{r.note}</p><p class="file-more">→ read the research</p></a>)}</div></section>
<section class="panel featured" aria-labelledby="setup-title"><header class="panel-head"><span class="dollar">$</span><span id="setup-title" class="cmd">./setups/midnight-shift --featured</span><span class="rc live">● live</span></header><div class="feat"><pre class="feat-art" aria-hidden="true"><code>┌────────────────────────────────────────────┐
│  ┌──────┐   ┌──────┐                       │
│  │ mon1 │   │ mon2 │       ambient · dim   │
│  └──────┘   └──────┘                       │
│  ══════════════════════════════════        │  desk
│              [ keyboard ]                  │
└────────────────────────────────────────────┘
     ~ midnight-shift . dark room . small footprint ~</code></pre><div class="feat-copy"><p class="feat-name"># midnight-shift</p><p class="feat-desc">A dark gaming-and-work setup that protects usable desk space instead of filling every surface with RGB accessories.</p><dl class="feat-meta"><div><dt>best-for</dt><dd>gaming · work · console</dd></div><div><dt>room</dt><dd>small · &lt; 5ft desk</dd></div><div><dt>vibe</dt><dd>dim ambient · no RGB</dd></div></dl><a class="cta" href="/setups/midnight-shift">open setup →</a></div></div></section>
<NewsletterSignup/></main></div></Layout>
<style>
.home-shell{overflow:visible}.home-shell main{padding-bottom:8px}.motd{padding:34px 0 4px}.ascii{margin:0;color:var(--phosphor);font-family:var(--font-mono);font-size:clamp(10px,1.3vw,14px);line-height:1.15;text-shadow:0 0 12px rgba(163,230,53,.18);overflow-x:auto}.motd-body{margin-top:18px;font-family:var(--font-mono);font-size:13.5px}.motd-line{margin:4px 0;color:var(--muted)}.motd-line.quiet{color:var(--quiet);font-size:12.5px}.prompt{color:var(--phosphor)}.sep{color:var(--muted);margin:0 6px 0 0}.inline{color:var(--purple-light);text-decoration:underline dotted;text-underline-offset:3px}.statbar{display:grid;grid-template-columns:repeat(4,1fr);margin:30px 0 6px;border:1px solid var(--term-border);background:var(--term-bg);font-family:var(--font-mono)}.stat{display:grid;gap:4px;padding:14px 16px;border-left:1px solid var(--term-border)}.stat:first-child{border-left:0}.stat-k{color:var(--quiet);font-size:11px}.stat-v{color:var(--phosphor);font-size:20px;font-weight:700}.stat-h{color:var(--muted);font-size:11.5px}.panel{margin-top:46px;border:1px solid var(--term-border);background:var(--term-bg);font-family:var(--font-mono)}.panel-head{display:flex;align-items:center;gap:10px;padding:10px 14px;border-bottom:1px dashed var(--term-border);color:var(--muted);font-size:12.5px}.dollar{color:var(--phosphor)}.cmd{color:var(--text)}.rc{margin-left:auto;color:var(--quiet);font-size:11.5px}.rc.live{color:var(--phosphor)}.ps{display:block;padding:6px 0 8px}.ps-row{display:grid;grid-template-columns:44px 190px 1.15fr 1.35fr 24px;align-items:center;gap:14px;padding:10px 16px;font-size:13px;color:var(--text);border-top:1px solid transparent}.ps-head{color:var(--quiet);font-size:11px;text-transform:uppercase;padding-block:4px;border-bottom:1px solid var(--term-border)}.ps-row+.ps-row{border-top:1px solid var(--term-border)}.ps-row:not(.ps-head):hover{background:rgba(163,230,53,.05);color:var(--phosphor)}.ps-id{color:var(--quiet)}.ps-cmd{color:var(--purple-light)}.ps-title{font-weight:600}.ps-note{color:var(--muted);font-size:12.5px}.ps-go{color:var(--quiet);text-align:right}.files{display:grid;grid-template-columns:repeat(3,1fr)}.file{display:block;padding:18px 18px 20px;border-left:1px solid var(--term-border)}.file:first-child{border-left:0}.file:hover{background:rgba(192,132,252,.06)}.file-head{display:flex;gap:8px;font-size:11.5px}.file-tag{color:var(--phosphor)}.file-path{color:var(--quiet)}.file-title{margin:12px 0 8px;font-size:15px;font-weight:600}.file-note{margin:0;color:var(--muted);font-size:13px;line-height:1.55}.file-more{margin:16px 0 0;color:var(--quiet);font-size:12px}.feat{display:grid;grid-template-columns:1.1fr 1fr}.feat-art{margin:0;padding:22px 24px;color:var(--phosphor);background:#050508;border-right:1px solid var(--term-border);font-family:var(--font-mono);font-size:12.5px;line-height:1.35;overflow-x:auto}.feat-copy{padding:22px 24px}.feat-name{margin:0 0 10px;color:var(--purple-light);font-size:14px}.feat-desc{margin:0;color:var(--muted);font-size:13.5px;line-height:1.55}.feat-meta{display:grid;gap:8px;margin:20px 0;padding:16px 0;border-block:1px dashed var(--term-border)}.feat-meta div{display:grid;grid-template-columns:96px 1fr;gap:12px}.feat-meta dt{color:var(--quiet);font-size:11px;text-transform:uppercase}.feat-meta dd{margin:0;color:var(--text);font-size:13px}.cta{display:inline-block;padding:8px 14px;border:1px solid var(--phosphor);color:var(--phosphor);background:rgba(163,230,53,.06);font-size:13px}@media(max-width:1080px){.statbar{grid-template-columns:repeat(2,1fr)}.stat:nth-child(3){border-left:0;border-top:1px solid var(--term-border)}.stat:nth-child(4){border-top:1px solid var(--term-border)}.files{grid-template-columns:1fr 1fr}.file:nth-child(3){border-left:0;border-top:1px solid var(--term-border);grid-column:1/-1}.feat{grid-template-columns:1fr}.feat-art{border-right:0;border-bottom:1px solid var(--term-border)}.ps-row{grid-template-columns:36px 150px 1fr 1fr 20px}}@media(max-width:720px){.ps-row{grid-template-columns:30px 1fr 20px;gap:10px}.ps-cmd,.ps-note{display:none}.files{grid-template-columns:1fr}.file{border-left:0;border-top:1px solid var(--term-border)}.file:first-child{border-top:0}}
</style>
