---
import ContentLayout from '../../layouts/ContentLayout.astro';
import LabTopology from '../../components/illustrations/LabTopology.astro';

import { LABS as labs } from '../../data/labs';
---
<ContentLayout design="v2" title="IT home labs for help desk and sysadmin practice | StackGeist" description="Real IT home labs documented with verified output: Active Directory, osTicket, AWS security fixes, and help desk practice for people moving into IT." active="labs">
  <p class="breadcrumbs"><a href="/">StackGeist</a> / Labs</p>
  <p class="page-kicker">Home labs</p>
  <h1 class="page-title">IT home labs built, broken, and documented.</h1>
  <p class="page-lead">These are systems Keith Casko built while working toward IT support and systems roles. Each page says what was verified and what is still unfinished.</p>
  <LabTopology />
  <section class="content-section">
    <div class="cards">
      {labs.map((lab) => <a class="card card-thumb" href={lab.href}>{lab.img && <img src={`/illustrations/${lab.img}.svg`} width="640" height="360" alt="" loading="lazy" decoding="async" />}<h2>{lab.title}</h2><p>{lab.note}</p></a>)}
    </div>
  </section>
  <section class="content-section">
    <div class="note">Choosing what to study alongside a lab? <a href="/certs/">Compare the entry-level IT certifications</a>.</div>
  </section>
</ContentLayout>
