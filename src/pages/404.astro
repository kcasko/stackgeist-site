---
import ContentLayout from '../layouts/ContentLayout.astro';
---
<ContentLayout title="Page not found | StackGeist" description="The requested StackGeist page could not be found." noindex={true}>
  <div class="legal-page">
    <p class="page-kicker">404</p>
    <h1 class="page-title">That page is not here.</h1>
    <p class="page-lead">The link may be old, unfinished, or mistyped.</p>
    <div class="page-actions"><a class="btn primary" href="/">Return to StackGeist</a><a class="btn" href="/setups/gaming">Browse gaming setups</a></div>
  </div>
</ContentLayout>
