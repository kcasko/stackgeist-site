---
import '../styles/global.css';
import '../styles/v2.css';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PinterestConsent from '../components/PinterestConsent.astro';
interface Props { title?: string; description?: string; }
const {
  title = 'StackGeist: tech fixes, IT home labs, and certification guides',
  description = 'Step-by-step troubleshooting for USB-C, storage, charging, and Wi-Fi problems, plus documented IT home labs and certification guides.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <SeoHead title={title} description={description} />
  </head>
  <body data-design="v2">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <div class="site-shell home-shared-footer"><div class="footer-pad"><SiteFooter /></div></div>
    <PinterestConsent />
    <script>import '../scripts/affiliate-attribution';</script>
  </body>
</html>
<style is:global>
  body > .site-shell:first-of-type main > footer.site-footer:not([data-shared-footer]) { display:none; }
  .home-shared-footer .footer-pad { padding:0 var(--page-pad); }
</style>
