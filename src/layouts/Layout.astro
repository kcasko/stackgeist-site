---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title?: string; description?: string; }
const {
  title = 'StackGeist - Better setups, useful gear',
  description = 'Gaming setups, desk inspiration, useful gear and practical ways to improve the space you use every day.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <SeoHead title={title} description={description} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <div class="site-shell home-shared-footer"><div class="footer-pad"><SiteFooter /></div></div>
  </body>
</html>
<style is:global>
  body > .site-shell:first-of-type main > footer.site-footer:not([data-shared-footer]) { display:none; }
  .home-shared-footer .footer-pad { padding:0 var(--page-pad); }
</style>
