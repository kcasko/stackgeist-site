---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'StackGeist — Better setups, useful gear',
  description = 'Gaming setups, desk inspiration, useful gear and practical ways to improve the space you use every day.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#07050d" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
