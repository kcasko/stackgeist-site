---
// Content pages: articles, hubs, products, legal.
// Articles (catalog pages under /guides/, /labs/, /certs/ that use .article-page) get the
// feature treatment automatically: breadcrumbs, section slab and meta line from the catalog,
// numbered step blocks, and a contents/related rail, all built at build time.
import Layout from './Layout.astro';
import { CATALOG, type Section } from '../data/catalog';
import { related, SECTIONS, TYPE_LABEL, TOPIC_LABEL, formatDate } from '../data/sections';

interface Props {
  title: string; description: string;
  active?: 'setups' | 'gear' | 'guides' | 'kits' | 'labs' | 'certs';
  section?: Section;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Force the article treatment on or off; by default it follows the catalog. */
  feature?: boolean;
  /** Extra rail links, e.g. hardware the article discusses. */
  railLinks?: { href: string; title: string; note?: string }[];
  /** @deprecated Kept so existing pages compile. */
  design?: 'v1' | 'v2';
}
const { title, description, active, section, noindex = false, structuredData, railLinks = [] } = Astro.props;
const path = Astro.url.pathname;
const norm = path.endsWith('/') ? path : `${path}/`;
const isDetail = (prefix: string) => path.startsWith(prefix) && path !== prefix;
const isEditorialPage = ['/labs/', '/certs/', '/guides/', '/kits/'].some(isDetail);
const isArticle = isEditorialPage || isDetail('/gear/');
const entry = CATALOG.find((e) => e.href === norm);
const articleTypes = ['troubleshooting', 'buying-guide', 'lab', 'lab-hardware', 'certification', 'course-review', 'study-log'];
const feature = Astro.props.feature ?? Boolean(entry && articleTypes.includes(entry.type));

const tocLabel: Record<string, string> = { troubleshooting: 'In this fix', lab: 'In this lab', 'lab-hardware': 'In this guide', 'course-review': 'In this review', 'study-log': 'On this page', certification: 'On this page', 'buying-guide': 'In this guide' };
const railTitle = (entry && tocLabel[entry.type]) ?? 'On this page';

let body = '';
const toc: { id: string; text: string; step?: string }[] = [];
if (feature) {
  body = await Astro.slots.render('default');
  const slug = (t: string) => t.toLowerCase().replace(/&[a-z#0-9]+;/g, '').replace(/<[^>]+>/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
  const used = new Set<string>();
  const uniq = (id: string) => { const base = id || 'section'; let out = base; let n = 2; while (used.has(out)) out = `${base}-${n++}`; used.add(out); return out; };
  // Section headings: ids, contents list, and numbered blocks for "Step NN" kickers.
  body = body.replace(/<section(?:\s[^>]*)?>\s*<p class="page-kicker"[^>]*>([^<]*)<\/p>\s*<h2(?:\s[^>]*)?>([\s\S]*?)<\/h2>/g, (_m, kicker: string, h: string) => {
    const text = h.replace(/<[^>]+>/g, '').trim();
    const id = uniq(slug(text));
    const step = /^Step\s+0?(\d+)/i.exec(kicker.trim());
    if (/^(Sources|Related( fixes| reading| guides)?|Keep going|Paid options)$/i.test(kicker.trim())) {
      return `<section><p class="page-kicker">${kicker}</p><h2 id="${id}">${h}</h2>`;
    }
    toc.push({ id, text, step: step?.[1] });
    if (step) {
      return `<section data-step="${step[1]}"><p class="page-kicker">${kicker}</p><p class="step-no" aria-hidden="true"><small>Step</small>${step[1]}</p><h2 id="${id}"><span class="sr-only">Step ${step[1]}: </span>${h}</h2>`;
    }
    return `<section><p class="page-kicker">${kicker}</p><h2 id="${id}">${h}</h2>`;
  });

  if (entry && !body.includes('class="article-tags"')) {
    // Breadcrumbs from the catalog, so section names are consistent everywhere.
    const crumbs: { href: string; label: string }[] = [{ href: SECTIONS[entry.section].href, label: SECTIONS[entry.section].label }];
    const hub = entry.section === 'fixes' ? CATALOG.find((e) => e.type === 'topic' && e.topic === entry.topic) : undefined;
    if (hub && hub.href !== entry.href) crumbs.push({ href: hub.href, label: TOPIC_LABEL[entry.topic] ?? hub.title });
    if (entry.topic === 'wgu' && entry.href !== '/certs/wgu-software-engineering-degree/') crumbs.push({ href: '/certs/wgu-software-engineering-degree/', label: 'WGU degree' });
    const crumbHtml = `<nav class="breadcrumbs" aria-label="Breadcrumb">${crumbs.map((c) => `<a href="${c.href}">${c.label}</a>`).join(' / ')}</nav>`;
    body = body.replace(/<p class="breadcrumbs"[^>]*>[\s\S]*?<\/p>/, crumbHtml);

    // Section slab plus the page's own kicker text.
    body = body.replace(/<p class="page-kicker"[^>]*>([^<]*)<\/p>(\s*<h1)/, (_m, k: string, h1: string) =>
      `<p class="article-tags"><a class="slab" href="${SECTIONS[entry.section].href}">${SECTIONS[entry.section].label}</a> <span class="kicker">${k}</span></p>${h1}`);

    // Meta line after the lead: byline, date, step count, and format.
    const steps = toc.filter((t) => t.step).length;
    const meta = ['By <a href="/about/">Keith Casko</a>'];
    if (entry.updated) meta.push(`Updated <time datetime="${entry.updated}">${formatDate(entry.updated)}</time>`);
    if (steps >= 2) meta.push(`<b>${steps} steps</b>`);
    meta.push(TYPE_LABEL[entry.type]);
    body = body.replace(/(<p class="page-lead"[^>]*>[\s\S]*?<\/p>)/, `$1<p class="article-meta">${meta.join(' · ')}</p>`);
  }
}
if (feature && toc.length >= 3) {
  // Phones get the contents list right after the short answer; the rail copy is for wide screens.
  const list = toc.map((t) => `<li><a href="#${t.id}">${t.step ? `<b>${t.step}</b> ` : ''}${t.text}</a></li>`).join('');
  body = body.replace(/(<div class="article-summary[^"]*"[^>]*>[\s\S]*?<\/div>)/, `$1<nav class="v2-toc inline-toc" aria-label="${railTitle}"><p>${railTitle}</p><ol>${list}</ol></nav>`);
}
if (feature && isEditorialPage) {
  // Byline closes the article itself, ahead of the newsletter.
  const byline = `<aside class="editorial-byline" aria-label="Editorial information"><strong>Written and researched by <a href="/about/">Keith Casko</a>.</strong> Technical claims are checked against the sources listed. Firsthand experience and research are labeled separately.</aside>`;
  const at = body.lastIndexOf('</article>');
  if (at !== -1) body = body.slice(0, at) + byline + body.slice(at);
}
const more = feature ? related(path, 5) : [];
---
<Layout title={title} description={description} noindex={noindex} structuredData={structuredData} active={active} section={section} mainClass={feature ? 'content-main has-rail' : 'content-main'} pageType={entry?.type} type={isArticle ? 'article' : 'website'}>
  {feature ? <Fragment set:html={body} /> : <slot />}
  {isEditorialPage && !feature && (
    <aside class="editorial-byline" aria-label="Editorial information">
      <strong>Written and researched by <a href="/about/">Keith Casko</a>.</strong>{' '}
      {path.startsWith('/kits/')
        ? 'Retailer search items in this list have not been individually checked.'
        : 'Technical claims are checked against the sources listed. Firsthand experience and research are labeled separately.'}
    </aside>
  )}
  {feature && (
    <aside class="article-rail" aria-label="In this article">
      <div class="rail-inner">
        {toc.length >= 3 && (
          <nav class="rail-block rail-toc" aria-labelledby="rail-toc-title">
            <h2 id="rail-toc-title" class="rail-title">{railTitle}</h2>
            <ol>{toc.map((t) => <li class:list={{ 'is-step': t.step }}><span aria-hidden="true">{t.step ?? '•'}</span><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </nav>
        )}
        {railLinks.length > 0 && (
          <div class="rail-block rail-hw">
            <h2 class="rail-title">Hardware in this guide</h2>
            <ul>{railLinks.map((l) => <li><a href={l.href}>{l.title}</a>{l.note && <span>{l.note}</span>}</li>)}</ul>
          </div>
        )}
        {more.length > 0 && (
          <div class="rail-block rail-more">
            <h2 class="rail-title">Related</h2>
            <ul>{more.map((e) => <li data-section={e.section}><span class="rail-type">{SECTIONS[e.section].label} · {TYPE_LABEL[e.type]}</span><a href={e.href}>{e.title}</a></li>)}</ul>
          </div>
        )}
      </div>
    </aside>
  )}
</Layout>

<script>
  // Fallback contents list for pages without the feature treatment.
  if (!document.querySelector('.article-rail')) {
    const headings = [...document.querySelectorAll<HTMLHeadingElement>('.article-body > section > h2')];
    const summary = document.querySelector('.article-summary');
    if (summary && headings.length >= 3) {
      const nav = document.createElement('nav');
      nav.className = 'v2-toc';
      nav.setAttribute('aria-label', 'On this page');
      const label = document.createElement('p');
      label.textContent = 'On this page';
      const list = document.createElement('ol');
      headings.forEach((h, i) => {
        if (!h.id) h.id = `section-${i + 1}`;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        li.append(a);
        list.append(li);
      });
      nav.append(label, list);
      summary.after(nav);
    }
  }
  // Let keyboard users scroll code blocks that are wider than the screen.
  document.querySelectorAll<HTMLElement>('.content-main pre').forEach((pre) => {
    if (pre.scrollWidth > pre.clientWidth) {
      pre.tabIndex = 0;
      pre.setAttribute('role', 'region');
      pre.setAttribute('aria-label', 'Code, scrolls sideways');
    }
  });
</script>

<style is:global>
  .has-rail { display: grid; grid-template-columns: minmax(0, 1fr) 300px; column-gap: clamp(32px, 4vw, 64px); align-items: start; }
  .has-rail > * { grid-column: 1; }
  .has-rail > .article-rail { grid-column: 2; grid-row: 1 / span 8; height: 100%; }
  .rail-inner { position: sticky; top: var(--space-4); display: grid; gap: var(--space-5); padding-top: var(--space-2); }
  .rail-block { border-top: 5px solid var(--ink); padding-top: var(--space-2); }
  .rail-title { margin: 0 0 var(--space-2); font: 900 1.05rem/1 var(--font-sans); font-stretch: var(--condensed); text-transform: uppercase; }
  .rail-block ol, .rail-block ul { margin: 0; padding: 0; list-style: none; }
  .rail-toc li { display: grid; grid-template-columns: 1.8rem 1fr; gap: 4px; padding: 6px 0; border-bottom: 1px solid var(--rule); font-size: .9rem; line-height: 1.3; }
  .rail-toc li > span { color: var(--ink-3); font-weight: 800; }
  .rail-toc li.is-step > span { display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; background: var(--dept); color: var(--on-dept); font: 900 .85rem/1 var(--font-sans); font-stretch: var(--condensed); }
  .rail-toc a, .rail-more a, .rail-hw a { text-decoration: none; }
  .rail-toc a:hover, .rail-more a:hover, .rail-hw a:hover { text-decoration: underline; }
  .rail-hw { border-top-color: var(--gear); }
  .rail-hw li { display: grid; gap: 2px; padding: 8px 0; border-bottom: 1px solid var(--rule); font-weight: 700; line-height: 1.25; }
  .rail-hw li span { color: var(--ink-3); font-size: .82rem; font-weight: 400; }
  .rail-more li { display: grid; gap: 2px; padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: .92rem; font-weight: 650; line-height: 1.25; }
  .rail-type { color: var(--dept-ink); font: 800 .62rem/1.3 var(--font-sans); font-stretch: var(--expanded); letter-spacing: .05em; text-transform: uppercase; }
  .inline-toc { display: none; }
  .inline-toc ol { counter-reset: none; }
  .inline-toc li { display: block; }
  .inline-toc li::before { content: none; }
  .inline-toc b { display: inline-grid; place-items: center; width: 1.3rem; height: 1.3rem; margin-right: 6px; background: var(--dept); color: var(--on-dept); font-size: .8rem; }
  @media (max-width: 1060px) {
    .inline-toc { display: block; }
    .has-rail { display: block; }
    .article-rail { margin-top: var(--space-7); }
    .rail-inner { position: static; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
    .rail-toc { display: none; }
  }
</style>
