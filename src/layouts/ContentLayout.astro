---
import '../styles/global.css';
import '../styles/content.css';
import '../styles/v2.css';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import PinterestConsent from '../components/PinterestConsent.astro';
interface Props {
  title: string; description: string;
  active?: 'setups' | 'gear' | 'guides' | 'kits' | 'labs' | 'certs';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  design?: 'v2';
}
const { title, description, active, noindex = false, structuredData, design } = Astro.props;
const isEditorialPage = (['/labs/', '/certs/'].some((prefix) => Astro.url.pathname.startsWith(prefix) && Astro.url.pathname !== prefix)) || (active === 'guides' && Astro.url.pathname.startsWith('/guides/') && Astro.url.pathname !== '/guides/') || (active === 'kits' && Astro.url.pathname.startsWith('/kits/') && Astro.url.pathname !== '/kits/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead title={title} description={description} noindex={noindex} extraStructuredData={structuredData} />
  </head>
  <body data-design={design}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header active={active} interactive={false} />
      <main id="main-content" class="content-main" tabindex="-1"><slot />{isEditorialPage && <aside class="editorial-byline" aria-label="Editorial information"><strong>Written and researched by <a href="/about">Keith Casko</a>.</strong> <span> {Astro.url.pathname.startsWith('/kits/') ? 'Retailer search items in this kit have not been individually checked.' : 'Technical claims are source-checked; personal use and researched recommendations are kept distinct.'}</span></aside>}</main>
      <SiteFooter />
    </div>
    <PinterestConsent />
    <script>import '../scripts/affiliate-attribution';</script>
    <script>
      // v2 pilot: build an "On this page" list from the guide's section headings.
      if (document.body.dataset.design === 'v2') {
        const headings = [...document.querySelectorAll('.article-body > section > h2')];
        const summary = document.querySelector('.article-summary');
        if (summary && headings.length >= 3) {
          const nav = document.createElement('nav');
          nav.className = 'v2-toc';
          nav.setAttribute('aria-label', 'On this page');
          const label = document.createElement('p');
          label.textContent = 'On this page';
          const list = document.createElement('ol');
          headings.forEach((h, i) => {
            if (!h.id) h.id = `section-${i + 1}`;
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = h.textContent;
            li.append(a);
            list.append(li);
          });
          nav.append(label, list);
          summary.after(nav);
        }
      }
      // Let keyboard users scroll code blocks that are wider than the screen.
      document.querySelectorAll('.content-main pre').forEach((pre) => {
        if (pre.scrollWidth > pre.clientWidth) {
          pre.tabIndex = 0;
          pre.setAttribute('role', 'region');
          pre.setAttribute('aria-label', 'Code, scrolls sideways');
        }
      });
    </script>
  </body>
</html>

<style is:global>
.editorial-byline{margin:36px 0 12px;padding:14px 16px;border:1px solid var(--term-border);background:var(--term-bg);color:var(--muted);font-size:13px;line-height:1.55}.editorial-byline strong{color:var(--text)}.editorial-byline a{color:var(--phosphor)}
</style>
