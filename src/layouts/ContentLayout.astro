---
import '../styles/global.css';
import '../styles/content.css';
import Header from '../components/Header.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoHead from '../components/SeoHead.astro';
import PinterestConsent from '../components/PinterestConsent.astro';
interface Props {
  title: string; description: string;
  active?: 'setups' | 'gear' | 'guides' | 'kits';
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, active, noindex = false, structuredData } = Astro.props;
const isEditorialPage = (active === 'guides' && Astro.url.pathname.startsWith('/guides/') && Astro.url.pathname !== '/guides/') || (active === 'kits' && Astro.url.pathname.startsWith('/kits/') && Astro.url.pathname !== '/kits/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <SeoHead title={title} description={description} noindex={noindex} extraStructuredData={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <Header active={active} interactive={false} />
      <main id="main-content" class="content-main" tabindex="-1"><slot />{isEditorialPage && <aside class="editorial-byline" aria-label="Editorial information"><strong>Written and researched by <a href="/about">Keith Casko</a>.</strong> <span> Technical claims are source-checked; personal use and researched recommendations are kept distinct. <a href="/editorial-methodology">Editorial methodology →</a></span></aside>}<SiteFooter /></main>
    </div>
    <PinterestConsent />
    <script>import '../scripts/affiliate-attribution';</script>
  </body>
</html>

<style is:global>
.editorial-byline{margin:36px 0 12px;padding:14px 16px;border:1px solid var(--term-border);background:var(--term-bg);color:var(--muted);font-size:13px;line-height:1.55}.editorial-byline strong{color:var(--text)}.editorial-byline a{color:var(--phosphor)}
</style>
